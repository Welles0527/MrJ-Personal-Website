          border-radius: 0 1rem 1rem 0;
          transform: translateX(-105%);
          transition: transform 180ms ease;
        }
        .todo-sidebar.is-open { transform: translateX(0); }
        .todo-backdrop {
          position: fixed;
          z-index: 29;
          inset: 0;
          background: rgba(38, 18, 3, 0.42);
        }
        .todo-backdrop.is-open { display: block; }
        .todo-sidebar-close {
