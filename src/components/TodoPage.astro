      }

      /*
       * Refined dark productivity system.
       * Layout and behavior remain owned by the existing rules above; this layer
       * only unifies material, depth, color, spacing rhythm, and interaction feel.
       */
      html[data-todo-theme="dark"] .todo-shell {
        --surface-canvas: #0d1112;
        --surface-main: #111718;
        --surface-sidebar: #171f20;
        --surface-panel: #1c2425;
        --surface-card: #222b2d;
        --surface-item: #293436;
        --surface-raised: #323f41;
        --surface-recessed: #151c1d;
        --border-subtle: rgba(255, 255, 255, 0.1);
        --border-bright: rgba(255, 255, 255, 0.16);
        --text-primary: #fbf7f0;
        --text-secondary: #d7d6d0;
        --text-muted: #9ea5a1;
        --accent-copper: #d39458;
        --accent-copper-bright: #efb171;
        --accent-copper-deep: #925b35;
        --radius-panel: 14px;
        --radius-card: 10px;
        --radius-item: 7px;
        --radius-pill: 999px;
        --shadow-panel:
          0 1px 0 rgba(255, 255, 255, 0.04) inset,
          0 -1px 0 rgba(0, 0, 0, 0.35) inset,
          0 12px 28px rgba(0, 0, 0, 0.28);
        --shadow-raised:
          0 1px 0 rgba(255, 255, 255, 0.05) inset,
          0 8px 18px rgba(0, 0, 0, 0.3),
          0 2px 5px rgba(0, 0, 0, 0.22);
        --shadow-selected:
          0 0 0 1px rgba(201, 135, 77, 0.55),
          0 1px 0 rgba(255, 220, 180, 0.12) inset,
          0 10px 24px rgba(0, 0, 0, 0.32),
          0 0 18px rgba(201, 135, 77, 0.07);
        --category-all: #d39458;
        --category-work: #b7a5c9;
        --category-study: #d27b6b;
        --category-life: #88aabd;
        --category-health: #91aa75;
        --category-other: #cfaa68;
        --task-text-work: #d7c5ef;
        --task-text-study: #ff9b88;
        --task-text-life: #a8d5ee;
        --task-text-health: #b6d995;
        --task-text-other: #f4c972;
        --important-star: #df806c;
        --important-text: var(--text-primary);
        --line: var(--border-subtle);
        --muted: var(--text-secondary);
        --shadow: var(--shadow-panel);
        background:
          radial-gradient(circle at 56% 18%, rgba(61, 72, 71, 0.22), transparent 34rem),
          radial-gradient(circle at 92% 78%, rgba(90, 62, 39, 0.07), transparent 28rem),
          linear-gradient(112deg, #0d1112 0%, #111718 48%, #0c1011 100%);
        color: var(--text-primary);
        font-family: "Aptos", "Segoe UI Variable Text", "Microsoft YaHei UI", "Microsoft YaHei", sans-serif;
      }

      html[data-todo-theme="dark"] .todo-shell::before {
        background-image:
          repeating-linear-gradient(32deg, transparent 0 19px, rgba(255, 255, 255, 0.012) 19px 20px),
          radial-gradient(rgba(255, 255, 255, 0.045) 0.5px, transparent 0.6px);
        background-size: auto, 15px 15px;
        opacity: 0.5;
      }

      html[data-todo-theme="dark"] :is(
        button,
        a,
        .todo-overview-item,
        .todo-item,
        .todo-day-column,
        .todo-day-overview,
        .todo-month-day
      ) {
        transition:
          transform 180ms ease-out,
          border-color 180ms ease-out,
          background-color 180ms ease-out,
          color 180ms ease-out,
          box-shadow 180ms ease-out;
      }

      html[data-todo-theme="dark"] .todo-sidebar {
        border-color: var(--border-bright);
        border-radius: var(--radius-panel);
        background:
          radial-gradient(circle at 12% 3%, rgba(201, 135, 77, 0.055), transparent 12rem),
          repeating-linear-gradient(30deg, rgba(255, 255, 255, 0.014) 0 1px, transparent 1px 11px),
          linear-gradient(160deg, #1b2425 0%, var(--surface-sidebar) 55%, #131a1b 100%);
        color: var(--text-primary);
        box-shadow:
          0 1px 0 rgba(255, 255, 255, 0.045) inset,
          -1px 0 0 rgba(0, 0, 0, 0.42) inset,
          12px 0 32px rgba(0, 0, 0, 0.27);
      }

      html[data-todo-theme="dark"] .todo-brand {
        border-bottom-color: var(--border-subtle);
        padding-bottom: 1.05rem;
      }

      html[data-todo-theme="dark"] .todo-brand-mark {
        border: 1px solid var(--border-bright);
        background:
          radial-gradient(circle at 38% 32%, #d7a374 0 12%, #b66e4c 13% 34%, #5a4659 35% 54%, #242c2e 55% 100%);
        color: transparent;
        box-shadow:
          0 1px 0 rgba(255, 255, 255, 0.16) inset,
          0 7px 16px rgba(0, 0, 0, 0.34);
      }

      html[data-todo-theme="dark"] .todo-brand strong {
        color: var(--text-primary);
        font-size: 1.18rem;
        letter-spacing: 0.05em;
      }

      html[data-todo-theme="dark"] .todo-brand div span {
        color: var(--text-muted);
        font-weight: 700;
        letter-spacing: 0.11em;
      }

      html[data-todo-theme="dark"] .todo-nav {
        gap: 0.34rem;
      }

      html[data-todo-theme="dark"] .todo-nav a,
      html[data-todo-theme="dark"] .todo-nav button,
      html[data-todo-theme="dark"] .todo-nav > span {
        position: relative;
        min-height: 2.8rem;
        border-radius: var(--radius-item);
        color: var(--text-secondary);
        font-weight: 750;
      }

      html[data-todo-theme="dark"] .todo-nav :is(a, button):hover {
        border-color: var(--border-subtle);
        background: rgba(255, 255, 255, 0.035);
        color: var(--text-primary);
        transform: translateY(-1px);
      }

      html[data-todo-theme="dark"] .todo-nav :is(a, button):active {
        transform: translateY(1px);
      }

      html[data-todo-theme="dark"] .todo-nav .is-active {
        border-color: rgba(201, 135, 77, 0.3);
        background:
          linear-gradient(90deg, rgba(123, 75, 44, 0.27), rgba(201, 135, 77, 0.055)),
          var(--surface-card);
        color: var(--text-primary);
        box-shadow:
          3px 0 0 var(--accent-copper) inset,
          0 1px 0 rgba(255, 230, 205, 0.06) inset,
          0 8px 18px rgba(0, 0, 0, 0.18);
      }

      html[data-todo-theme="dark"] .todo-nav-icon {
        color: var(--accent-copper);
      }

      html[data-todo-theme="dark"] .todo-sidebar-lanes {
