      .todo-day-column .todo-item-title.todo-category-title-work { color: var(--category-work); }
      .todo-day-column .todo-item-title.todo-category-title-study { color: var(--category-study); }
      .todo-day-column .todo-item-title.todo-category-title-life { color: var(--category-life); }
      .todo-day-column .todo-item-title.todo-category-title-health { color: var(--category-health); }
      .todo-day-column .todo-item-title.todo-category-title-other { color: var(--category-other); }
      .todo-day-column .todo-item-title {
        font-size: 0.68rem;
        font-weight: 760;
      }

      .todo-item-note {
        margin: 0.28rem 0 0;
        color: #826346;
        font-size: 0.7rem;
        line-height: 1.55;
        overflow-wrap: anywhere;
      }

      .todo-tags {
        display: flex;
        flex-wrap: wrap;
        flex: 0 0 auto;
        gap: 0.18rem;
        margin: 0;
      }

      .todo-tag {
        display: inline-flex;
        align-items: center;
        border-radius: 999px;
        padding: 0.1rem 0.32rem;
        font-size: 0.56rem;
        font-weight: 900;
      }

      .todo-tag.work { background: color-mix(in srgb, var(--category-work) 16%, #fff3e1); color: var(--category-work); }
      .todo-tag.study { background: color-mix(in srgb, var(--category-study) 15%, #fff3e1); color: var(--category-study); }
      .todo-tag.life { background: color-mix(in srgb, var(--category-life) 15%, #fff3e1); color: var(--category-life); }
      .todo-tag.health { background: color-mix(in srgb, var(--category-health) 15%, #fff3e1); color: var(--category-health); }
      .todo-tag.other { background: color-mix(in srgb, var(--category-other) 18%, #fff3e1); color: var(--category-other); }
      .todo-tag.done { background: #d7e5c4; color: #4c6b30; }
      .todo-tag.important {
        gap: 0.16rem;
        border: 1px solid color-mix(in srgb, var(--important-star) 22%, transparent);
        background: rgba(122, 63, 22, 0.06);
        color: var(--important-text);
      }

      .todo-important-star {
        color: var(--important-star);
        font-size: 0.7rem;
        line-height: 1;
      }

      .todo-item-actions {
        position: absolute;
        top: 0.24rem;
        right: 0.24rem;
        display: flex;
        justify-content: flex-end;
      }

      .todo-item-actions button {
        width: 0.94rem;
        min-width: 0.94rem;
        height: 0.94rem;
        padding: 0;
        border: 0;
        border-radius: 0.24rem;
        background: transparent;
        color: #8d6d4f;
        font-size: 0.7rem;
        font-weight: 900;
        line-height: 0.94rem;
      }

      .todo-item-actions button:hover { background: rgba(135, 79, 25, 0.08); color: #5b2d0a; }
      .todo-item-actions .todo-delete-button:hover { color: #a7442a; }

      .todo-add-slots {
        display: grid;
        gap: 0.52rem;
        margin-top: 0.7rem;
      }

      .todo-add-bottom {
        display: flex;
        width: 100%;
        min-height: 2.34rem;
        align-items: center;
        justify-content: center;
        border: 1px solid rgba(124, 76, 32, 0.1);
        border-radius: 0.48rem;
        background: rgba(255, 246, 232, 0.46);
        color: #8a6a4d;
        font-size: 1.18rem;
        font-weight: 900;
      }

      .todo-add-bottom:hover {
        border-color: rgba(124, 76, 32, 0.2);
        background: rgba(255, 250, 243, 0.72);
        color: #623713;
      }

      .todo-stats { display: none !important; }

      .todo-modal {
        width: min(92vw, 550px);
        max-width: calc(100vw - 1.5rem);
        box-sizing: border-box;
        overflow-x: hidden;
        border: 1px solid rgba(103, 58, 18, 0.22);
        border-radius: 0.72rem;
        padding: 0;
        color: #2f1a0c;
        background: #f8e6c8;
        box-shadow: 0 24px 80px rgba(47, 21, 3, 0.35);
      }

      .todo-modal::backdrop {
        background: rgba(38, 18, 3, 0.42);
        backdrop-filter: blur(2px);
      }

      .todo-form,
      .todo-delete-content {
        min-width: 0;
        box-sizing: border-box;
        padding: 1.45rem;
        background:
          repeating-linear-gradient(0deg, transparent 0 38px, rgba(122, 76, 34, 0.06) 39px 40px),
          #f8e6c8;
      }

      .todo-modal-header {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 1rem;
        margin-bottom: 1.25rem;
      }

      .todo-modal h2 {
        margin: 0.2rem 0 0;
        font-family: inherit;
        font-size: 1.65rem;
      }

      .todo-dialog-close {
        display: grid;
        width: 2rem;
        height: 2rem;
        place-items: center;
        border: 1px solid rgba(122, 76, 34, 0.16);
        border-radius: 50%;
        background: #fff0d7;
        color: #6f4a2d;
        font-size: 1.2rem;
      }

      .todo-field {
        display: grid;
        gap: 0.42rem;
        color: #5c3a1c;
        font-size: 0.82rem;
        font-weight: 900;
      }

      .todo-field[hidden] { display: none; }
      .todo-field b { color: #a24a2a; }

      .todo-field input,
      .todo-field select,
      .todo-field textarea {
        width: 100%;
        border: 1px solid rgba(122, 76, 34, 0.18);
        border-radius: 0.58rem;
        padding: 0.68rem 0.75rem;
        background: rgba(255, 246, 229, 0.72);
        color: #2f1a0c;
        font-weight: 700;
        outline-color: #a9672c;
      }

      .todo-field textarea { resize: vertical; line-height: 1.55; }
      .todo-field em {
        min-height: 0.95rem;
        color: #a24a2a;
        font-size: 0.68rem;
        font-style: normal;
        font-weight: 700;
      }

      .todo-form-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 0.8rem;
        margin-top: 0.65rem;
      }

      .todo-important-toggle {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        margin: 1rem 0;
        color: #6a4728;
        font-size: 0.82rem;
        font-weight: 900;
      }

      .todo-important-toggle input {
        width: 1rem;
        height: 1rem;
        accent-color: #90602e;
      }

      .todo-modal-actions {
        display: flex;
        justify-content: flex-end;
        gap: 0.62rem;
        margin-top: 1.25rem;
      }

      .todo-modal-actions button:disabled {
        cursor: not-allowed;
        opacity: 0.5;
        box-shadow: none;
      }

      .todo-delete-content > p:not(.todo-kicker),
      .todo-login-copy,
      .todo-login-message {
        margin: 0.6rem 0 0;
        color: var(--muted);
        font-size: 0.86rem;
        line-height: 1.6;
        overflow-wrap: anywhere;
      }

      .todo-login-copy { margin: 0 0 1rem; }
      .todo-login-message { min-height: 1.4rem; color: #a24a2a; }

      .todo-trash-list {
        display: grid;
        max-height: min(48vh, 26rem);
        gap: 0.62rem;
        margin-top: 1rem;
        overflow-y: auto;
      }

      .todo-trash-empty {
        margin: 0;
        border: 1px dashed rgba(116, 69, 27, 0.22);
        border-radius: 0.62rem;
        padding: 1.15rem;
        color: #8b6746;
        text-align: center;
      }

      .todo-trash-item {
        display: grid;
        gap: 0.46rem;
        border: 1px solid rgba(124, 76, 32, 0.12);
        border-radius: 0.58rem;
        padding: 0.82rem;
        background: rgba(255, 250, 243, 0.62);
      }

      .todo-trash-title {
        margin: 0;
        color: #2f2115;
        font-size: 0.92rem;
        font-weight: 900;
      }

      .todo-trash-meta {
        margin: 0;
        color: #846449;
        font-size: 0.74rem;
      }

      .todo-trash-actions {
        display: flex;
        justify-content: flex-end;
        gap: 0.48rem;
      }

      .todo-trash-actions button {
        min-height: 2rem;
        border-radius: 0.46rem;
        padding: 0.34rem 0.68rem;
        font-size: 0.76rem;
        font-weight: 900;
      }

      .todo-search-modal {
        width: min(94vw, 680px);
      }

      .todo-search-modal .todo-modal-header {
        margin-bottom: 0.9rem;
      }

      .todo-search-field {
        display: block;
      }

      .todo-search-input-wrap {
        display: grid;
        grid-template-columns: 1.35rem minmax(0, 1fr);
        align-items: center;
        gap: 0.45rem;
        border: 1px solid rgba(122, 76, 34, 0.22);
        border-radius: 0.62rem;
        padding: 0 0.8rem;
        background: rgba(255, 246, 229, 0.78);
        color: #8a5b31;
      }

      .todo-search-input-wrap:focus-within {
        border-color: #9b602d;
        box-shadow: 0 0 0 3px rgba(155, 96, 45, 0.12);
      }

      .todo-search-input-wrap input {
        min-width: 0;
        border: 0;
        padding: 0.78rem 0;
        background: transparent;
        color: #2f1a0c;
        font: inherit;
        font-weight: 800;
        outline: none;
      }

      .todo-search-input-wrap input::placeholder {
        color: #9b7a5d;
      }

      .todo-search-summary {
        min-height: 1.2rem;
        margin: 0.7rem 0 0.45rem;
        color: #846449;
        font-size: 0.76rem;
        font-weight: 800;
      }

      .todo-search-results {
        display: grid;
        max-height: min(52vh, 30rem);
        gap: 0.5rem;
        overflow-y: auto;
        padding-right: 0.18rem;
      }

      .todo-search-item {
        display: grid;
        width: 100%;
        grid-template-columns: minmax(0, 1fr) auto;
        align-items: center;
        gap: 0.45rem 1rem;
        border: 1px solid rgba(124, 76, 32, 0.12);
        border-radius: 0.58rem;
        padding: 0.68rem 0.78rem;
        background: rgba(255, 250, 243, 0.62);
        color: inherit;
        font: inherit;
        text-align: left;
        transition: border-color 150ms ease, background 150ms ease, transform 150ms ease;
      }

      .todo-search-item:hover {
        border-color: rgba(124, 76, 32, 0.28);
        background: rgba(255, 250, 243, 0.9);
        transform: translateY(-1px);
      }

      .todo-search-item:focus-visible {
        border-color: #9b602d;
        outline: 3px solid rgba(155, 96, 45, 0.16);
        outline-offset: 1px;
      }

      .todo-search-title-row {
        display: flex;
        min-width: 0;
        align-items: center;
        flex-wrap: wrap;
        gap: 0.42rem;
      }

      .todo-search-title {
        min-width: 0;
        margin: 0;
        color: #2f2115;
        font-size: 0.9rem;
        font-weight: 900;
        overflow-wrap: anywhere;
      }

      .todo-search-category,
      .todo-search-status {
        flex: 0 0 auto;
        border-radius: 999px;
        padding: 0.16rem 0.42rem;
        font-size: 0.66rem;
        font-weight: 900;
      }

      .todo-search-category {
        background: rgba(137, 94, 49, 0.1);
        color: #79512f;
      }

      .todo-search-status {
        background: rgba(99, 133, 89, 0.12);
        color: #547246;
      }

      .todo-search-status.is-deleted {
        background: rgba(157, 74, 52, 0.1);
        color: #9d4a34;
      }

      .todo-search-meta {
        grid-column: 1 / -1;
        display: flex;
        flex-wrap: wrap;
        gap: 0.25rem 0.72rem;
        margin: 0;
        color: #846449;
        font-size: 0.72rem;
      }

      .todo-search-created {
        color: #765538;
        font-size: 0.72rem;
        font-weight: 800;
        white-space: nowrap;
      }

      .todo-search-note {
        grid-column: 1 / -1;
        margin: 0;
        color: #6f533b;
        font-size: 0.74rem;
        line-height: 1.45;
        overflow-wrap: anywhere;
      }

      .todo-day-column.is-located {
        animation: todo-locate-pulse 1.45s ease-out;
      }

      @keyframes todo-locate-pulse {
        0%, 100% { box-shadow: none; }
        35% {
          border-color: rgba(180, 91, 27, 0.62);
          box-shadow: 0 0 0 4px rgba(180, 91, 27, 0.14);
        }
      }

      .todo-toast {
        position: fixed;
        z-index: 25;
        bottom: 1.4rem;
        left: 50%;
        margin: 0;
        transform: translateX(-50%);
        border-radius: 999px;
        padding: 0.74rem 1.08rem;
        background: #3b1d08;
        color: #fff0ce;
        font-size: 0.82rem;
        box-shadow: 0 10px 28px rgba(47, 21, 3, 0.35);
      }

      .todo-backdrop { display: none; }
      .todo-migration-frame { position: fixed; width: 1px; height: 1px; border: 0; opacity: 0; pointer-events: none; }

