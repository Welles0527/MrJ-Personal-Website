          background: rgba(255, 225, 169, 0.09);
          color: #f5d59b;
          font-size: 1.15rem;
        }
        .todo-main { padding: 0.95rem 0.82rem 1.4rem; }
        .todo-heading h1 { font-size: 2rem; }
        .todo-title-cup { width: 2rem; height: 2rem; font-size: 1.12rem; }
        .todo-menu-button {
          display: grid;
          width: 2.35rem;
          height: 2.35rem;
          margin-top: 0.25rem;
          place-items: center;
          border: 1px solid rgba(122, 76, 34, 0.16);
          border-radius: 0.6rem;
          background: rgba(255, 239, 212, 0.62);
          color: #5d3415;
          font-size: 1rem;
        }
        .todo-header-actions { gap: 0.42rem; }
        .todo-sync-summary { flex-basis: 100%; max-width: 100%; }
        .todo-account { max-width: 100%; }
        .todo-utility { width: 2.35rem; height: 2.35rem; }
        .todo-filter-section { align-items: stretch; flex-direction: column; gap: 0.44rem; }
        .todo-filter-list { width: 100%; }
        .todo-data-button { width: max-content; }
        .todo-planner-card { min-height: 0; border-radius: 0.72rem; }
        .todo-calendar-panel,
        .todo-week-overview-panel { padding: 0.9rem; }
        .todo-select-row { grid-template-columns: 1fr 0.8fr 1.22fr; gap: 0.34rem; }
        .todo-select-row select { font-size: 0.78rem; }
        .todo-week-overview { min-width: 560px; }
        .todo-overview-lanes { grid-template-columns: 1fr; }
        .todo-mobile-days {
          display: flex;
          gap: 0.42rem;
          overflow-x: auto;
          margin-top: 0.8rem;
          padding-bottom: 0.32rem;
        }
        .todo-mobile-day {
          flex: 0 0 auto;
          min-width: 4.65rem;
          border: 1px solid rgba(122, 76, 34, 0.16);
          border-radius: 0.58rem;
          padding: 0.55rem 0.62rem;
          background: rgba(255, 239, 212, 0.62);
          color: #6b4a2d;
          font-size: 0.72rem;
          font-weight: 900;
        }
        .todo-mobile-day.is-selected {
          border-color: rgba(123, 63, 18, 0.42);
          background: #f5d9ad;
          color: #542906;
        }
        .todo-board-section { margin-top: 0.75rem; }
        .todo-overview-weekly-columns { grid-template-columns: 1fr; }
        .todo-weekly-board,
        .todo-weekly-board.is-compact {
          grid-template-columns: 1fr;
          gap: 0.72rem;
        }
        .todo-day-column { min-height: 24rem; }
        .todo-form-grid { grid-template-columns: 1fr; }
        .todo-search-item { grid-template-columns: minmax(0, 1fr); }
        .todo-search-created { white-space: normal; }
        .todo-modal-actions { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); }
        .todo-modal-actions button { width: 100%; min-width: 0; }
      }

      @media (max-width: 420px) {
        .todo-modal { width: calc(100vw - 1.5rem); }
        .todo-login-modal .todo-modal-actions { grid-template-columns: 1fr; }
      }

      @media (max-width: 760px) {
        html[data-todo-theme="dark"] .todo-backdrop {
          background: rgba(4, 7, 8, 0.72);
          backdrop-filter: blur(3px);
        }

        html[data-todo-theme="dark"] .todo-menu-button,
        html[data-todo-theme="dark"] .todo-mobile-day {
          border-color: var(--border-bright);
          background:
            linear-gradient(180deg, rgba(255, 255, 255, 0.038), rgba(0, 0, 0, 0.07)),
            var(--surface-card);
          color: var(--text-secondary);
          box-shadow:
            0 1px 0 rgba(255, 255, 255, 0.045) inset,
            0 6px 14px rgba(0, 0, 0, 0.24);
        }

        html[data-todo-theme="dark"] .todo-mobile-day.is-selected {
          border-color: rgba(217, 154, 90, 0.56);
          background:
            linear-gradient(180deg, rgba(255, 225, 193, 0.12), rgba(66, 31, 12, 0.12)),
            var(--accent-copper-deep);
          color: #fff1e3;
          box-shadow:
            0 1px 0 rgba(255, 226, 194, 0.15) inset,
            0 7px 16px rgba(0, 0, 0, 0.28);
        }

        html[data-todo-theme="dark"] .todo-calendar-panel {
          border-bottom-color: var(--border-subtle);
        }
      }

