        display: grid;
        grid-template-columns: auto minmax(0, 1fr);
        gap: 0.28rem;
        align-items: start;
        border: 1px solid rgba(124, 76, 32, 0.12);
        border-radius: 0.48rem;
        padding: 0.34rem 1.48rem 0.34rem 0.38rem;
        background: rgba(255, 250, 243, 0.78);
