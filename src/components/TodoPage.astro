        opacity: 0.48;
      }

      .todo-checkbox {
        width: 0.9rem;
        height: 0.9rem;
        margin: 0;
        accent-color: #90602e;
      }

      .todo-item-main { min-width: 0; }

      .todo-item-title-row {
        display: flex;
        align-items: center;
        gap: 0.18rem;
        min-width: 0;
        margin: 0;
      }

      .todo-item-star {
        flex: 0 0 auto;
        color: #d73a1d;
        font-size: 0.64rem;
