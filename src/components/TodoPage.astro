        .todo-week-overview { min-width: 610px; }
        .todo-overview-weekly-columns { grid-template-columns: repeat(2, minmax(0, 1fr)); }
        .todo-weekly-board { grid-template-columns: repeat(2, minmax(0, 1fr)); min-height: auto; }
        .todo-day-column { min-height: 22rem; }
