        --category-life: #8eafc0;
        --category-health: #96aa76;
        --category-other: #d0a85e;
        --task-text-work: #dac6e6;
        --task-text-study: #ee9984;
        --task-text-life: #a9ccdc;
        --task-text-health: #b8cd95;
