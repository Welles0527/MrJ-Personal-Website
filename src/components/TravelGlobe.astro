---
import { sitePath } from '../data/site';
interface Location { id: string; name: string; markerName: string; originalName: string; sourceNames: string[]; country: string; region: string; count: number; latitude: number; longitude: number; photosPath: string; cover: string; albumSlugs: string[] }
interface AlbumLink { slug: string; name: string; count: number; unlocatedCount: number; cover: string; href: string }
interface Props { locations: Location[]; albums: AlbumLink[]; totalPhotos: number; locatedPhotos: number; unlocatedPhotos: number }
const { locations, albums, totalPhotos, locatedPhotos, unlocatedPhotos } = Astro.props;
const countries = new Set(locations.map((album) => album.country));
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#060c15" />
    <meta name="robots" content="noindex" />
    <title>星球上的回忆 · J先生旅行相册</title>
  </head>
  <body>
    <main class="atlas" data-atlas>
      <header class="topbar"><h1>Travel Around the World</h1><p>从一个地方到另一个地方，把沿途的时光留在这里。</p><a href={sitePath('/topics/space/travel/photo-wall/')} class="brand"><span class="brand-icon">✧</span> J先生 <span class="divider">/</span> 旅行影像志</a><a class="back" href={sitePath('/topics/space/travel/photo-wall/')}>返回相册墙 ↗</a></header>
      <aside class="journal">
        <p class="eyebrow">A PERSONAL ATLAS</p>
        <h2 class="atlas-title">城市里的回忆</h2>
        <p class="intro">沿着照片的坐标，重访走过的城市。<br />远景汇聚，放大后展开每一处回忆。</p>
        <div class="totals"><span><b>{countries.size.toString().padStart(2,'0')}</b> 个国家 / 地区</span><span><b>{locations.length}</b> 个城市 / 地点</span><span><b>{locatedPhotos.toLocaleString()}</b> 张已定位照片</span></div>
        <p class="location-note">共 {totalPhotos.toLocaleString()} 张照片，{unlocatedPhotos.toLocaleString()} 张暂无城市定位，仍保留在原相册。</p>
        <details class="original-albums"><summary>查看原相册 · {albums.length} 本</summary><nav aria-label="原始旅行相册">{albums.map(album => <a href={album.href}><span>{album.name}</span><small>{album.count.toLocaleString()} 张{album.unlocatedCount > 0 ? ` · ${album.unlocatedCount.toLocaleString()} 张未定位` : ''}</small></a>)}</nav></details>
        <div class="collection-heading"><h2>我的城市足迹</h2><span data-filter-count aria-live="polite">全部 · {locations.length} 处</span></div>
        <input class="city-search" type="search" data-city-search aria-label="搜索城市或国家" placeholder="搜索城市或国家" />
        <div class="album-filters" role="group" aria-label="按旅行区域筛选城市">
          <button type="button" data-album-filter="all" aria-pressed="true">全部 <span>{locations.length}</span></button>
          <button type="button" data-album-filter="domestic" aria-pressed="false">国内 <span>{locations.filter(album => album.country === '中国').length}</span></button>
          <button type="button" data-album-filter="international" aria-pressed="false">国外 <span>{locations.filter(album => album.country !== '中国').length}</span></button>
        </div>
        <nav class="album-list" aria-label="旅行城市">
          {locations.map((album, index) => <div class="album-row" data-album-row={album.id} data-region={album.country === '中国' ? 'domestic' : 'international'} data-search={[album.name, album.originalName, album.country, ...album.sourceNames].join(' ').toLowerCase()}>
            <button type="button" class="album-focus" data-focus={album.id} aria-label={`在地球上定位${album.markerName}`} aria-pressed="false">
              <img src={sitePath(album.cover)} width="56" height="56" alt={`${album.markerName}照片`} loading="lazy" />
              <span><strong>{album.name}</strong><small>{album.country} · {album.count.toLocaleString()} 张照片</small></span><em>{String(index+1).padStart(2,'0')}</em>
            </button>
            <button class="album-open" data-city-open={album.id} type="button" aria-label={`查看${album.markerName}的照片`}>↗</button>
          </div>)}
        </nav>
        <p class="empty-cities" data-empty-cities hidden>没有匹配的城市，试试其他名称。</p>
      </aside>
      <section class="world" aria-label="交互式旅行地球">
        <div id="cesium-globe" aria-label="拖动旋转地球，滚轮或双指缩放"></div>
        <div class="map-toolbar" aria-label="地图控制">
          <div class="mode-switch"><button data-mode="3d" aria-pressed="true">3D 地球</button><button data-mode="2d" aria-pressed="false">平面地图</button></div>
          <button data-home aria-label="返回全球视角">◎</button><button data-zoom="in" aria-label="放大地球">＋</button><button data-zoom="out" aria-label="缩小地球">−</button>
        </div>
        <p class="loading" data-loading role="status">正在展开你的世界…</p>
        <div class="map-markers" data-markers>
          <svg class="pin-leaders" aria-hidden="true">{locations.map(album=><line data-leader={album.id} />)}</svg>
          {locations.map((album) => <button class="map-pin" data-pin={album.id} aria-label={`在地图上查看${album.markerName}`} hidden><span class="pin-dot"></span><span data-pin-label>{album.markerName}<small>{album.count} 张</small></span></button>)}
        </div>
        <article class="selection" data-selection hidden aria-label="选中城市">
          <img data-selection-image alt="" width="180" height="120" />
          <div><small data-selection-region></small><h2 data-selection-title></h2><p data-selection-count></p><button type="button" data-selection-open>查看城市照片 ↗</button></div>
          <button data-close aria-label="关闭城市预览">×</button>
        </article>
        <div class="world-footer"><span><i></i> <span data-view-status>全球视角</span></span><span data-imagery>正在连接高清影像</span></div>
      </section>
      <script id="cesium-albums" type="application/json" is:inline set:html={JSON.stringify(locations.map(a=>({...a,cover:sitePath(a.cover)})))} />
      <script id="city-source-albums" type="application/json" is:inline set:html={JSON.stringify(albums)} />
    </main>
    <dialog class="city-gallery" data-city-gallery aria-labelledby="city-gallery-title">
      <header class="city-gallery-heading"><div><p>城市影像</p><h2 id="city-gallery-title" data-city-gallery-title></h2><span data-city-gallery-count></span></div><button type="button" data-city-gallery-close aria-label="关闭城市照片">×</button></header>
      <nav class="city-source-links" data-city-source-links aria-label="这些照片的原相册"></nav>
      <p class="city-gallery-status" data-city-gallery-status role="status"></p>
      <div class="city-photo-grid" data-city-photo-grid></div>
      <section class="city-photo-view" data-city-photo-view aria-label="照片预览" hidden>
        <button type="button" class="photo-back" data-photo-back>← 返回城市照片</button>
        <img data-city-photo-image alt="" />
        <div class="city-photo-controls"><button type="button" data-city-photo-previous aria-label="上一张照片">‹</button><p data-city-photo-caption></p><button type="button" data-city-photo-next aria-label="下一张照片">›</button></div>
      </section>
    </dialog>
    <script>import '../scripts/travel-globe';</script>
    <script>import '../scripts/travel-city-gallery';</script>
  </body>
</html>
<style is:global>
  @import 'cesium/Build/Cesium/Widgets/widgets.css';
  .location-note{font-size:10px;line-height:1.7;color:#8cabb5;margin:12px 0}.original-albums{font-size:11px;color:#b8d3dc;border-bottom:1px solid #d9eaff1a;padding-bottom:10px;flex-shrink:0}.original-albums summary{cursor:pointer;min-height:30px;padding:6px 0}.original-albums nav{max-height:180px;overflow:auto}.original-albums a{display:block;padding:8px 0;border-top:1px solid #d9eaff0c}.original-albums small{display:block;color:#78939e;margin-top:4px}.city-search{width:100%;min-height:36px;border:1px solid #b1d9ee26;border-radius:6px;background:#0b122180;color:#edf4f7;font:inherit;font-size:12px;padding:8px 10px;margin:0 0 10px;flex-shrink:0}.city-search:focus-visible{outline:2px solid #a5f3fc;outline-offset:2px}.album-open{background:none;border:0}.empty-cities{color:#9daeb6;font-size:12px}.selection [data-selection-open]{font-size:11px;color:#d0f2fc;border:0;border-bottom:1px solid #91c6d8;background:none;padding:5px 0}.map-pin.is-cluster{justify-content:center;min-width:48px;min-height:48px;border-radius:50%;padding:8px;background:#294553e8;border-color:#b9e7f0a8}.map-pin.is-cluster .pin-dot{display:none}.map-pin.is-cluster [data-pin-label]{font-size:14px;font-weight:700}.map-pin.is-cluster small{font-size:8px;font-weight:400}
  .city-gallery{width:min(1120px,calc(100% - 48px));height:min(850px,calc(100dvh - 48px));max-width:none;max-height:none;margin:auto;padding:24px;border:1px solid #8fc7d448;border-radius:14px;background:#091820;color:#edf4f7;overflow:auto}.city-gallery::backdrop{background:#000b;backdrop-filter:blur(6px)}.city-gallery-heading{display:flex;align-items:flex-start;justify-content:space-between;gap:20px}.city-gallery-heading p{font-size:10px;letter-spacing:2px;color:#8cabb5;margin:0 0 8px}.city-gallery-heading h2{font-size:28px;margin:0 0 8px}.city-gallery-heading span{font-size:12px;color:#aac1cb}.city-gallery-heading button,.city-photo-controls button{border:1px solid #b1d9ee40;border-radius:50%;background:#0b1221;color:#edf4f7;width:44px;height:44px;font-size:26px;flex-shrink:0}.city-source-links{display:flex;gap:8px;flex-wrap:wrap;margin:20px 0}.city-source-links a{border:1px solid #b1d9ee26;border-radius:6px;padding:9px 11px;font-size:11px}.city-gallery-status{font-size:13px;color:#aac1cb}.city-photo-grid{columns:4;column-gap:12px}.city-photo-grid button{display:block;width:100%;padding:0;margin:0 0 12px;border:0;border-radius:7px;overflow:hidden;break-inside:avoid;background:#142832;cursor:zoom-in}.city-photo-grid img{display:block;width:100%;height:auto}.city-photo-view{position:sticky;inset:0;height:100%;display:flex;flex-direction:column;gap:16px;align-items:center;background:#091820}.city-photo-view>img{width:100%;min-height:0;flex:1;object-fit:contain}.photo-back{align-self:flex-start;min-height:40px;background:none;border:0;color:#d0f2fc}.city-photo-controls{display:flex;align-items:center;justify-content:center;gap:20px;width:100%;flex-shrink:0}.city-photo-controls p{font-size:12px;color:#aac1cb;text-align:center}.city-gallery.is-photo-view .city-gallery-heading,.city-gallery.is-photo-view .city-source-links,.city-gallery.is-photo-view .city-gallery-status,.city-gallery.is-photo-view .city-photo-grid{display:none}
  @media(max-width:820px){.city-gallery{width:calc(100% - 16px);height:calc(100dvh - 16px);padding:16px;border-radius:10px}.city-photo-grid{columns:2;column-gap:8px}.city-photo-grid button{margin-bottom:8px}.city-gallery-heading h2{font-size:24px}.city-photo-controls{gap:12px}.city-gallery .city-photo-controls p{font-size:11px}.city-search{font-size:16px}.atlas .album-list{max-height:520px;overflow-y:auto}.atlas .journal{min-height:700px}}
  .album-filters{display:flex;gap:5px;padding:0 0 12px;flex-shrink:0}.album-filters button{flex:1;border:1px solid #b1d9ee26;border-radius:6px;background:#0b122180;min-height:36px;font-size:11px}.album-filters button[aria-pressed=true]{background:#eff8ff;color:#101923;border-color:#eff8ff}.album-filters button span{font-size:10px;opacity:.65;margin-left:4px}
  *{box-sizing:border-box}html,body{margin:0;min-width:320px;background:#010409;color:#edf4f7;font-family:Arial,'Microsoft YaHei',sans-serif}button,a{-webkit-tap-highlight-color:transparent}button{font:inherit;cursor:pointer;color:inherit}a{color:inherit;text-decoration:none}button:focus-visible,a:focus-visible{outline:2px solid #a5f3fc;outline-offset:3px}[hidden]{display:none!important}
  .atlas{height:100svh;min-height:650px;display:grid;grid-template-columns:330px minmax(0,1fr);position:relative;background:#010409}
  .topbar{position:absolute;top:25px;left:330px;right:0;text-align:center;z-index:4;pointer-events:none}.topbar h1{font-size:40px;letter-spacing:-2px;margin:0;font-weight:750}.topbar p{font-size:12px;color:#a1aab6;margin:7px 0 12px}.topbar a{pointer-events:auto;font-size:11px;display:inline-block;padding:8px 16px;background:#0b1221a8;border:1px solid #b8c9df26}.brand{border-radius:6px 0 0 6px}.back{border-radius:0 6px 6px 0}.brand-icon,.divider{display:none}
  .journal{grid-column:1;grid-row:1;z-index:2;min-height:0;padding:130px 20px 20px;border-right:1px solid #c5e9f21c;display:flex;flex-direction:column;background:linear-gradient(155deg,#07161bba,#010409eb);backdrop-filter:blur(12px)}.eyebrow{font-size:9px;letter-spacing:2.5px;color:#7dcae0;margin:0 0 10px}.atlas-title{font-size:24px;margin:0}.intro{font-size:11px;line-height:1.9;color:#9daeb6;margin:15px 0}.totals{display:flex;gap:23px;border-top:1px solid #d3ecff16;border-bottom:1px solid #d3ecff16;padding:15px 0;color:#9aabb5;font-size:9px}.totals b{display:block;font-size:22px;line-height:1.6;font-weight:600;color:#f1f7fa}.collection-heading{display:flex;justify-content:space-between;align-items:center;padding:20px 0 10px}.collection-heading h2{font-size:12px;font-weight:500;margin:0}.collection-heading>span{font-size:8px;color:#72929f}.album-list{overflow-y:auto;min-height:0;scrollbar-width:thin;scrollbar-color:#27404a transparent}.album-row{display:flex;align-items:center;border-bottom:1px solid #d9eaff0c;border-radius:7px}.album-row.is-selected,.album-row:hover{background:#8bd8eb15}.album-focus{display:flex;text-align:left;align-items:center;gap:10px;border:0;background:none;padding:10px 3px;min-width:0;flex:1}.album-focus img{width:44px;height:44px;object-fit:cover;border-radius:6px}.album-focus>span{min-width:0;flex:1}.album-focus strong{font-size:11px;font-weight:500;display:block;line-height:1.6}.album-focus small{display:block;margin-top:3px;font-size:9px;color:#8cabb5}.album-focus em{font-size:9px;color:#5b7d88;font-style:normal}.album-open{padding:16px 8px;min-width:32px;text-align:center;color:#b5e2f0}
  .world{grid-column:2;grid-row:1;position:relative;min-height:0;overflow:hidden;background:#010409}#cesium-globe{position:absolute;inset:0}.map-toolbar{position:absolute;z-index:4;bottom:62px;left:50%;transform:translateX(-50%);display:flex;align-items:center;gap:7px;white-space:nowrap}.map-toolbar button{border:1px solid #b1d9ee26;background:#0b1221c9;min-width:36px;height:36px;border-radius:6px;backdrop-filter:blur(12px);font-size:18px}.mode-switch{display:flex;border:1px solid #b1d9ee26;padding:3px;border-radius:6px;background:#0b1221c9;margin-right:4px}.mode-switch button{border:0;background:none;font-size:10px;height:28px;padding:0 13px;min-width:0}.mode-switch button[aria-pressed=true]{background:#eff8ff;color:#101923}.map-markers{position:absolute;inset:0;pointer-events:none}.map-pin{position:absolute;display:flex;gap:6px;align-items:center;transform:translate(-50%,-50%);pointer-events:auto;border:1px solid #c7edff45;background:#071523ad;border-radius:5px;padding:5px 8px;white-space:nowrap;font-size:10px;box-shadow:0 2px 10px #0004}.pin-dot{width:6px;height:6px;border-radius:50%;background:#88ddeb;box-shadow:0 0 8px #77dfff}.map-pin small{display:block;font-size:8px;color:#b2d5de;margin-top:2px}.map-pin:hover{background:#194453}.world-footer{position:absolute;bottom:29px;left:22px;right:22px;display:flex;justify-content:space-between;pointer-events:none;font-size:9px;color:#8ea7b4}.world-footer i{display:inline-block;width:5px;height:5px;background:#a5f3fc;border-radius:50%;margin-right:7px}.loading{position:absolute;top:46%;width:100%;text-align:center;color:#c6eaf1;font-size:13px;pointer-events:none}.selection{position:absolute;bottom:116px;left:24px;right:24px;max-width:390px;padding:10px;display:flex;gap:15px;border:1px solid #a6dff62e;border-radius:9px;background:#061019df;backdrop-filter:blur(16px);box-shadow:0 15px 70px #0007;z-index:5}.selection>img{width:110px;height:118px;object-fit:cover;border-radius:5px}.selection>div{padding:8px 0;min-width:0}.selection small{font-size:9px;color:#95c7d4}.selection h2{font-size:15px;font-weight:500;margin:7px 22px 7px 0}.selection p{font-size:10px;color:#9baab5;margin:0 0 16px}.selection a{font-size:11px;color:#d0f2fc;border-bottom:1px solid #91c6d8;padding:5px 0}.selection>button{position:absolute;right:5px;top:3px;border:0;background:none;font-size:22px;color:#a9c8d4;min-width:32px;min-height:32px}.cesium-widget-credits{font-size:8px!important}.cesium-viewer-bottom{left:10px!important}.pin-leaders{position:absolute;inset:0;width:100%;height:100%;pointer-events:none}.pin-leaders line{stroke:#d3f2ff;stroke-width:1;stroke-opacity:.55}
  @media(max-height:780px) and (min-width:821px){.journal{padding-top:100px}.intro{margin:10px 0}.album-focus{padding:7px 3px}}
  @media(max-width:820px){.atlas{height:auto;min-height:100svh;grid-template-columns:1fr;grid-template-rows:560px auto}.topbar{top:25px;left:0;right:0}.topbar h1{font-size:30px;letter-spacing:-1.4px}.topbar p{font-size:10px}.topbar a{font-size:10px;padding:7px 12px}.world{grid-column:1;grid-row:1;height:560px}.journal{grid-column:1;grid-row:2;padding:22px 20px 30px;border-right:0;border-top:1px solid #bde6f51c}.journal .intro{display:none}.atlas-title{font-size:22px}.totals{justify-content:space-between;margin-top:15px}.album-list{max-height:none;overflow:visible}.album-focus img{width:52px;height:52px}.album-focus{padding:12px 3px}.album-focus strong{font-size:13px}.album-focus small{font-size:10px}.map-toolbar{bottom:62px}.world-footer{font-size:8px;left:14px;right:14px;bottom:32px}.selection{bottom:114px;left:12px;right:12px}.selection>img{height:100px;width:90px}.selection>div{padding:3px 0}.selection h2{font-size:14px}.selection p{margin-bottom:9px}}
  @media(prefers-reduced-motion:reduce){*{scroll-behavior:auto!important}}
</style>
