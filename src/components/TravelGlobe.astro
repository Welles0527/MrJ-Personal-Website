---
import { sitePath } from '../data/site';
interface Location { id: string; name: string; markerName: string; mapLabel?: string; mapGroup?: string; country: string; region: string; count: number; latitude: number; longitude: number; href: string; cover: string }
interface MapPlace { id: string; label: string; latitude: number; longitude: number; albumIds: string[]; count: number; provinceId?: string; isProvince?: boolean }
interface Props { locations: Location[]; provinces: { id: string; label: string; placeIds: string[] }[] }
const { locations, provinces } = Astro.props;
const total = locations.reduce((sum, album) => sum + album.count, 0);
const countries = new Set(locations.map((album) => album.country));
const placesById = new Map<string, MapPlace>();
for (const album of locations) {
  const id = album.mapGroup ?? album.id;
  const place = placesById.get(id);
  if (place) {
    place.albumIds.push(album.id);
    place.count += album.count;
  } else {
    const { latitude, longitude, count } = album;
    placesById.set(id, { id, label: album.mapLabel ?? album.markerName, latitude, longitude, count, albumIds: [album.id] });
  }
}
for (const { id, label, placeIds } of provinces) {
  const members = [...placesById.values()].filter(place => placeIds.includes(place.id));
  if (!members.length) continue;
  for (const place of members) place.provinceId = id;
  placesById.set(id, {
    id, label, isProvince: true,
    latitude: members.reduce((sum, place) => sum + place.latitude, 0) / members.length,
    longitude: members.reduce((sum, place) => sum + place.longitude, 0) / members.length,
    albumIds: members.flatMap(place => place.albumIds),
    count: members.reduce((sum, place) => sum + place.count, 0),
  });
}
const places = [...placesById.values()];
const fallbackPlaces = places.filter(place => !place.provinceId && !place.isProvince);
const placeLabel = (place: MapPlace) => place.albumIds.length > 1
  ? `${place.label}，查看 ${place.albumIds.length} 本相册`
  : `在地球上定位${place.label}`;
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#060c15" />
    <meta name="robots" content="noindex" />
    <title>星球上的回忆 · J先生旅行相册</title>
    <script is:inline src="/officialwebsite/account-entry.js" defer></script>
  </head>
  <body>
    <main class="atlas" data-atlas>
      <header class="topbar"><a class="other-projects" href="/#projects">查看其他AI项目</a><p>从一个地方到另一个地方，把沿途的时光留在这里。</p><a href={sitePath('/topics/space/travel/photo-wall/')} class="brand"><span class="brand-icon">✧</span> J先生 <span class="divider">/</span> 旅行影像志</a><a class="back" href={sitePath('/topics/space/travel/photo-wall/')}>返回相册墙 ↗</a></header>
      <aside class="journal">
        <a class="other-projects" href="/#projects">查看其他AI项目</a>
        <p class="intro">那些远行与日常，都在这颗星球上。<br />选择一册回忆，让视线抵达那里。</p>
        <div class="totals"><span><b>{countries.size.toString().padStart(2,'0')}</b> 个国家</span><span><b>{locations.length.toString().padStart(2,'0')}</b> 本相册</span><span><b>{total.toLocaleString()}</b> 张照片</span></div>
        <div class="collection-heading"><h2>我的旅行收藏</h2><span data-filter-count aria-live="polite">全部 · {locations.length} 本</span></div>
        <div class="album-filters" role="group" aria-label="按旅行区域筛选相册">
          <button type="button" data-album-filter="all" aria-pressed="true">全部 <span>{locations.length}</span></button>
          <button type="button" data-album-filter="domestic" aria-pressed="false">国内 <span>{locations.filter(album => album.country === '中国').length}</span></button>
          <button type="button" data-album-filter="international" aria-pressed="false">国外 <span>{locations.filter(album => album.country !== '中国').length}</span></button>
        </div>
        <nav class="album-list" aria-label="旅行相册">
          {locations.map((album, index) => <div class="album-row" data-album-row={album.id} data-region={album.country === '中国' ? 'domestic' : 'international'}>
            <button type="button" class="album-focus" data-focus={album.id} aria-label={`在地球上定位${album.markerName}`} aria-pressed="false">
              <img src={sitePath(album.cover)} width="56" height="56" alt={`${album.markerName}相册封面`} />
              <span><strong>{album.name}</strong><small>{album.country} · {album.count.toLocaleString()} 张照片</small></span><em>{String(index+1).padStart(2,'0')}</em>
            </button>
            <a class="album-open" href={album.href} aria-label={`打开${album.markerName}相册`}>↗</a>
          </div>)}
        </nav>
      </aside>
      <section class="world" aria-label="交互式旅行地球">
        <div id="cesium-globe" aria-label="拖动旋转地球，滚轮或双指缩放"></div>
        <div class="flat-fallback" data-fallback-map hidden>
          <div class="fallback-earth" role="group" aria-label="旅行相册平面地图">
            <img src={sitePath('/cesium/Assets/Textures/NaturalEarthII/0/0/0.jpg')} alt="" />
            <img src={sitePath('/cesium/Assets/Textures/NaturalEarthII/0/1/0.jpg')} alt="" />
            {fallbackPlaces.map(place => <button type="button" class="fallback-pin" data-place={place.id} data-multiple={place.albumIds.length > 1 ? '' : undefined} aria-label={placeLabel(place)} style={`left:${(place.longitude + 180) / 360 * 100}%;top:${(90 - place.latitude) / 180 * 100}%`}><i></i><span class="place-tag"><span class="pin-dot" aria-hidden="true"></span>{place.label}</span></button>)}
          </div>
          <div class="fallback-provinces" role="group" aria-label="按省份查看相册">
            {places.filter(place => place.isProvince).map(place => <button type="button" class="place-tag" data-place={place.id} aria-label={placeLabel(place)}><span class="pin-dot" aria-hidden="true"></span>{place.label}</button>)}
          </div>
        </div>
        <div class="map-toolbar" aria-label="地图控制">
          <div class="mode-switch"><button data-mode="3d" aria-pressed="true">3D 地球</button><button data-mode="2d" aria-pressed="false">平面地图</button></div>
          <button data-home aria-label="返回全球视角">◎</button><button data-zoom="in" aria-label="放大地球" disabled>＋</button><button data-zoom="out" aria-label="缩小地球" disabled>−</button>
        </div>
        <p class="loading" data-loading role="status">正在展开3D相册，首次加载较慢，请耐心等待。</p>
        <div class="map-markers" data-markers>
          <svg class="pin-leaders" aria-hidden="true">{places.map(place=><line data-leader={place.id} />)}</svg>
          {places.map(place => <button type="button" class="map-pin place-tag" data-pin={place.id} data-place={place.id} aria-label={place.isProvince ? `放大查看${place.label}的 ${place.albumIds.length} 本相册` : placeLabel(place)} hidden><span class="pin-dot" aria-hidden="true"></span>{place.label}</button>)}
        </div>
        <div class="world-footer"><span><i></i> <span data-view-status>全球视角</span></span><span data-imagery>正在连接高清影像</span></div>
      </section>
      <aside class="selection" data-selection hidden aria-labelledby="travel-album-title" tabindex="-1">
        <header class="selection-header">
          <div><h2 id="travel-album-title" data-selection-title></h2><p data-selection-count></p></div>
          <a data-selection-link>打开相册 ↗</a>
          <button type="button" data-close aria-label="关闭相册预览">×</button>
        </header>
        <div class="selection-scroll" data-selection-scroll>
          <p class="selection-status" data-selection-status role="status" hidden></p>
          <div data-selection-gallery></div>
        </div>
      </aside>
      <script id="cesium-albums" type="application/json" is:inline set:html={JSON.stringify(locations.map(a=>({...a,cover:sitePath(a.cover)})))} />
      <script id="cesium-places" type="application/json" is:inline set:html={JSON.stringify(places)} />
    </main>
    <script>import '../scripts/travel-globe';</script>
  </body>
</html>
<style is:global>
  @import 'cesium/Build/Cesium/Widgets/widgets.css';
  .flat-fallback{position:absolute;inset:0;z-index:1;background:#010409;display:grid;align-items:center}
  .fallback-earth{position:relative;display:flex;width:100%;aspect-ratio:2;overflow:hidden}
  .fallback-earth>img{width:50%;height:100%;object-fit:fill}
  .fallback-pin{position:absolute;transform:translate(-50%,-50%);min-width:28px;min-height:28px;padding:0;border:0;background:none;display:grid;place-items:center}
  .fallback-pin>i{width:7px;height:7px;background:#a5f3fc;border:1px solid #062b38;border-radius:50%;box-shadow:0 0 7px #000}
  .fallback-pin>span{display:none;position:absolute;bottom:27px;pointer-events:none}
  .fallback-pin[data-multiple]{z-index:1}
  .fallback-pin:is(:hover,:focus-visible,[aria-pressed=true]){z-index:2}
  .fallback-pin:is(:hover,:focus-visible,[aria-pressed=true])>span{display:flex}
  .fallback-provinces { position: absolute; left: 50%; bottom: 113px; transform: translateX(-50%); display: flex; gap: 12px; }
  .map-pin { position: absolute; transform: translate(-50%,-50%); pointer-events: auto; }
  .place-tag {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 5px 8px;
    border: 1px solid #c7edff45;
    border-radius: 5px;
    background: #071523ad;
    white-space: nowrap;
    font-size: 10px;
    box-shadow: 0 2px 10px #0004;
  }
  .pin-dot { flex: none; width: 6px; height: 6px; border-radius: 50%; background: #88ddeb; box-shadow: 0 0 8px #77dfff; }
  button.place-tag:hover { background: #194453; }
  .fallback-provinces button { min-height: 38px; }
  .fallback-pin:focus-visible { outline: none; }
  .fallback-pin:focus-visible>span { outline: 2px solid #a5f3fc; }
  .atlas .loading{z-index:3;padding:0 20px;line-height:1.7}
  .atlas .world-footer{z-index:4}
  .atlas[data-ready=fallback] .loading{top:auto;bottom:158px;margin:0;text-shadow:0 1px 2px #010409}
  .atlas[data-ready=fallback] .map-markers{display:none}
  .map-toolbar button:disabled{opacity:.4;cursor:default}
  .album-filters{display:flex;gap:5px;padding:0 0 12px;flex-shrink:0}.album-filters button{flex:1;border:1px solid #b1d9ee26;border-radius:6px;background:#0b122180;min-height:36px;font-size:11px}.album-filters button[aria-pressed=true]{background:#eff8ff;color:#101923;border-color:#eff8ff}.album-filters button span{font-size:10px;opacity:.65;margin-left:4px}
  *{box-sizing:border-box}html,body{margin:0;min-width:320px;background:#010409;color:#edf4f7;font-family:Arial,'Microsoft YaHei',sans-serif}button,a{-webkit-tap-highlight-color:transparent}button{font:inherit;cursor:pointer;color:inherit}a{color:inherit;text-decoration:none}button:focus-visible,a:focus-visible{outline:2px solid #a5f3fc;outline-offset:3px}[hidden]{display:none!important}
  .atlas{height:calc(100svh - var(--mj-account-visible-height,0px));min-height:650px;display:grid;--journal-width:330px;grid-template-columns:var(--journal-width) minmax(0,1fr);position:relative;background:#010409}
  .topbar{position:absolute;top:25px;left:var(--journal-width);right:0;text-align:center;z-index:4;pointer-events:none}.topbar p{font-size:12px;color:#a1aab6;margin:7px 0 12px}.topbar a{pointer-events:auto;font-size:11px;display:inline-block;padding:8px 16px;background:#0b1221a8;border:1px solid #b8c9df26}.brand{border-radius:6px 0 0 6px}.back{border-radius:0 6px 6px 0}.brand-icon,.divider{display:none}
  .journal{grid-column:1;grid-row:1;z-index:2;min-height:0;padding:84px 20px 20px;border-right:1px solid #c5e9f21c;display:flex;flex-direction:column;background:linear-gradient(155deg,#07161bba,#010409eb);backdrop-filter:blur(12px)}.intro{font-size:11px;line-height:1.9;color:#9daeb6;margin:15px 0}.totals{display:flex;gap:23px;border-top:1px solid #d3ecff16;border-bottom:1px solid #d3ecff16;padding:15px 0;color:#9aabb5;font-size:9px}.totals b{display:block;font-size:22px;line-height:1.6;font-weight:600;color:#f1f7fa}.collection-heading{display:flex;justify-content:space-between;align-items:center;padding:20px 0 10px}.collection-heading h2{font-size:12px;font-weight:500;margin:0}.collection-heading>span{font-size:8px;color:#72929f}.album-list{overflow-y:auto;min-height:0;scrollbar-width:thin;scrollbar-color:#27404a transparent}.album-row{display:flex;align-items:center;border-bottom:1px solid #d9eaff0c;border-radius:7px}.album-row.is-selected,.album-row:hover{background:#8bd8eb15}.album-focus{display:flex;text-align:left;align-items:center;gap:10px;border:0;background:none;padding:10px 3px;min-width:0;flex:1}.album-focus img{width:44px;height:44px;object-fit:cover;border-radius:6px}.album-focus>span{min-width:0;flex:1}.album-focus strong{font-size:11px;font-weight:500;display:block;line-height:1.6}.album-focus small{display:block;margin-top:3px;font-size:9px;color:#8cabb5}.album-focus em{font-size:9px;color:#5b7d88;font-style:normal}.album-open{padding:16px 8px;min-width:32px;text-align:center;color:#b5e2f0}
  .world{grid-column:2;grid-row:1;position:relative;min-height:0;overflow:hidden;background:#010409}#cesium-globe{position:absolute;inset:0}.map-toolbar{position:absolute;z-index:4;bottom:62px;left:50%;transform:translateX(-50%);display:flex;align-items:center;gap:7px;white-space:nowrap}.map-toolbar button{border:1px solid #b1d9ee26;background:#0b1221c9;min-width:36px;height:36px;border-radius:6px;backdrop-filter:blur(12px);font-size:18px}.mode-switch{display:flex;border:1px solid #b1d9ee26;padding:3px;border-radius:6px;background:#0b1221c9;margin-right:4px}.mode-switch button{border:0;background:none;font-size:10px;height:28px;padding:0 13px;min-width:0}.mode-switch button[aria-pressed=true]{background:#eff8ff;color:#101923}.map-markers{position:absolute;inset:0;pointer-events:none}.world-footer{position:absolute;bottom:29px;left:22px;right:22px;display:flex;justify-content:space-between;pointer-events:none;font-size:9px;color:#8ea7b4}.world-footer i{display:inline-block;width:5px;height:5px;background:#a5f3fc;border-radius:50%;margin-right:7px}.loading{position:absolute;top:46%;width:100%;text-align:center;color:#c6eaf1;font-size:13px;pointer-events:none}.cesium-widget-credits{font-size:8px!important}.cesium-viewer-bottom{left:10px!important}.pin-leaders{position:absolute;inset:0;width:100%;height:100%;pointer-events:none}.pin-leaders line{stroke:#d3f2ff;stroke-width:1;stroke-opacity:.55}
  @media(max-height:780px) and (min-width:821px){.journal{padding-top:100px}.intro{margin:10px 0}.album-focus{padding:7px 3px}}
  @media(max-width:820px){.atlas{height:auto;min-height:100svh;grid-template-columns:1fr;grid-template-rows:560px auto}.topbar{top:25px;left:0;right:0}.topbar p{font-size:10px}.topbar a{font-size:10px;padding:7px 12px}.world{grid-column:1;grid-row:1;height:560px}.journal{grid-column:1;grid-row:2;padding:22px 20px 30px;border-right:0;border-top:1px solid #bde6f51c}.journal .intro{display:none}.totals{justify-content:space-between;margin-top:15px}.album-list{max-height:none;overflow:visible}.album-focus img{width:52px;height:52px}.album-focus{padding:12px 3px}.album-focus strong{font-size:13px}.album-focus small{font-size:10px}.map-toolbar{bottom:62px}.world-footer{font-size:8px;left:14px;right:14px;bottom:32px}}
  .selection {
    grid-column: 3;
    grid-row: 1;
    z-index: 5;
    display: flex;
    flex-direction: column;
    min-width: 0;
    min-height: 0;
    border-left: 1px solid #2a3e4c;
    background: #07111a;
  }
  .selection-header {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto auto;
    align-items: center;
    gap: 12px;
    padding: 13px 12px 13px 16px;
    border-bottom: 1px solid #273a48;
  }
  .selection-header h2 { margin: 0; font-size: 16px; line-height: 1.45; overflow-wrap: anywhere; }
  .selection-header p { margin: 3px 0 0; color: #9eb5c2; font-size: 11px; }
  .selection-header a { color: #b7e7f3; font-size: 11px; white-space: nowrap; }
  .selection-header a:hover { text-decoration: underline; }
  .selection-header button { width: 36px; height: 36px; border: 1px solid #b1d9ee39; border-radius: 6px; background: #101e2b; font-size: 22px; }
  .selection-header button:hover { background: #194453; }
  .selection-scroll { flex: 1; min-height: 0; overflow: auto; overscroll-behavior: contain; scrollbar-color: #3a5461 transparent; container-type: size; }
  .selection-status { margin: 18px 16px; color: #b3c8d2; font-size: 13px; }
  .selection-albums { margin: 0; padding: 6px 14px; list-style: none; }
  .selection-albums button { display: flex; width: 100%; align-items: center; justify-content: space-between; gap: 12px; min-height: 44px; padding: 8px; border: 0; border-bottom: 1px solid #273a48; background: none; color: #edf4f7; font-size: 13px; text-align: left; }
  .selection-albums button:hover { background: #194453; }
  .selection-albums small { color: #9eb5c2; white-space: nowrap; }
  .selection-group { padding: 10px 6px 5px; }
  .selection-group h3 { margin: 4px 8px 9px; color: #d8e6ec; font-size: 12px; font-weight: 600; }
  .selection-photos { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 3px; }
  .selection-photo { display: block; width: 100%; min-width: 0; aspect-ratio: 4 / 3; padding: 0; border: 0; overflow: hidden; background: #13222e; cursor: zoom-in; }
  .selection-photo img { display: block; width: 100%; height: 100%; object-fit: cover; }
  .selection-photo[aria-expanded=true] { grid-column: 1 / -1; aspect-ratio: auto; cursor: zoom-out; }
  .selection-photo[aria-expanded=true] img { height: auto; max-height: min(42svh, 420px); max-height: min(100cqh, 480px); object-fit: contain; }
  .selection-photo:focus-visible { outline-offset: -3px; }
  @media (min-width: 821px) {
    .atlas:has(.selection:not([hidden])) {
      --journal-width: clamp(210px, 24vw, 330px);
      --selection-width: clamp(260px, 30vw, 440px);
      grid-template-columns: var(--journal-width) minmax(0, 1fr) var(--selection-width);
    }
    .atlas:has(.selection:not([hidden])) .topbar { right: var(--selection-width); }
    .atlas:has(.selection:not([hidden])) #mj-account[data-embedded=travel] {
      right: calc(var(--selection-width) + 18px);
    }
  }
  @media (max-width: 820px) {
    .selection {
      position: fixed;
      inset: auto 0 0;
      height: min(56svh, 490px);
      padding-bottom: env(safe-area-inset-bottom);
      border: 1px solid #2a3e4c;
      border-radius: 12px 12px 0 0;
      box-shadow: 0 -12px 36px #0006;
    }
    .selection-header { gap: 9px; padding: 8px 10px 8px 14px; }
    .selection-header h2 { font-size: 14px; }
    .selection-header button { width: 44px; height: 44px; }
    .atlas:has(.selection:not([hidden])) .map-toolbar { top: 178px; bottom: auto; }
  }
  @media (max-width: 820px) and (max-height: 500px) {
    .atlas:has(.selection:not([hidden])) .map-toolbar { visibility: hidden; }
  }
  .other-projects{padding:0;border:0;background:none;color:#a5c6cd;font-size:11px;line-height:1.6;white-space:nowrap;z-index:5}
  .journal>.other-projects{position:absolute;top:36px;left:calc(var(--journal-width) - 20px);transform:translateX(-100%)}
  .topbar>.other-projects{display:none}
  .other-projects:hover{color:#edf4f7;text-decoration:underline;text-underline-offset:4px}
  @media(max-width:820px){.journal>.other-projects{display:none}.topbar>.other-projects{position:absolute;display:block;top:14px;right:14px;padding:0;border:0;background:none;font-size:10px}}
  @media(prefers-reduced-motion:reduce){*{scroll-behavior:auto!important}}
</style>
