---
import '../styles/worship-entry.css';

const basePath = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const accountHref = `${basePath}topics/space/planning/todo`;
const worshipAssets = {
  hero: `${basePath}worship/assets/worship-hero-valley.png`,
  album: `${basePath}worship/assets/album-grace-valley.png`,
  band: `${basePath}worship/assets/artist-golden-band.png`,
  quiet: `${basePath}worship/assets/artist-quiet-water.png`,
  video: `${basePath}worship/assets/worship-video-gathering.png`,
};
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#f4ede2" />
    <meta http-equiv="Cache-Control" content="no-cache, no-store, must-revalidate" />
    <meta http-equiv="Pragma" content="no-cache" />
    <meta http-equiv="Expires" content="0" />
    <title>敬拜音乐 · 让赞美成为今天的力量</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Noto+Serif+SC:wght@500;600;700;900&family=Manrope:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <script is:inline>
      try {
        const savedTheme = localStorage.getItem('worship:theme');
        if (savedTheme === 'dark') document.documentElement.dataset.theme = 'dark';
      } catch {}
    </script>
  </head>
  <body>
    <div class="ambient ambient-one"></div><div class="ambient ambient-two"></div>
    <div class="app">
      <aside class="sidebar">
        <a class="logo" href="#top"><img src={worshipAssets.album} alt="" /><span><strong>敬拜音乐</strong><small>与神相遇 · 生命被更新</small></span></a>
        <nav class="side-nav" aria-label="网站导航">
          <button class="side-link active" data-nav="discover"><span>⌂</span>发现</button>
          <button class="side-link" data-nav="picked"><span>☆</span>为你精选</button>
          <button class="side-link" data-nav="artists"><span>♧</span>歌手合集</button>
          <button class="side-link" data-nav="singles"><span>▣</span>经典单曲</button>
          <button class="side-link" data-nav="favorites"><span>♡</span>我的收藏 <i class="nav-dot" hidden></i></button>
          <button class="side-link" data-nav="recent"><span>◷</span>最近播放</button>
          <button class="side-link" data-nav="mine"><span>＋</span>我的歌曲</button>
          <button class="side-link" data-nav="library"><span>☷</span>全部歌单</button>
        </nav>
        <div class="source-links"><span>聆听来源</span><a href="https://www.youtube.com/" target="_blank" rel="noreferrer">▶ <b>YouTube</b></a><a href="https://www.bilibili.com/" target="_blank" rel="noreferrer">▣ <b>B站</b></a></div>
        <div class="account"><div class="avatar" id="accountAvatar">恩</div><div><strong id="accountName">共享主站账号</strong><small id="syncStatus">正在读取主站登录状态…</small></div><a class="account-link" href={accountHref} aria-label="登录或管理主站账号">↗</a></div>
      </aside>

      <main id="top">
        <header class="topbar"><button class="mobile-menu" id="mobileMenu" aria-label="打开导航">☰</button><label class="search"><input id="searchInput" type="search" placeholder="搜索歌曲、歌手或心情…" /><span>⌕</span></label><a class="member-link" href={accountHref}>♛ <span>会员中心</span></a><button class="theme-toggle" id="themeToggle" type="button" aria-label="切换到深色皮肤" aria-pressed="false"><span aria-hidden="true">◐</span><b>深色</b></button><button class="top-action" id="randomButton">随心听一首 <span>↗</span></button></header>

        <section
          class="feature reveal"
          data-fallback-album={worshipAssets.album}
          data-fallback-band={worshipAssets.band}
          data-fallback-quiet={worshipAssets.quiet}
          data-fallback-video={worshipAssets.video}
        >
          <img class="feature-art" id="featureArt" src={worshipAssets.hero} alt="" />
          <div class="feature-media-card" aria-label="当前歌曲视频">
            <div class="media-player-shell" style={`--video-poster:url("${worshipAssets.video}")`}>
              <iframe id="mediaPlayer" title="敬拜音乐播放器" allow="autoplay; encrypted-media; fullscreen; picture-in-picture" referrerpolicy="strict-origin-when-cross-origin"></iframe>
              <div id="playerPrompt"><span>▶</span><strong>这一生最美的祝福</strong><small>赞美之泉</small></div>
            </div>
          </div>
          <div class="feature-copy">
            <div class="feature-heading">
              <div class="feature-album">
                <img id="featureAlbumImage" src={worshipAssets.album} alt="这一生最美的祝福歌曲图片" />
                <span id="featureAlbumBadge">赞美之泉</span>
              </div>
              <div class="feature-identity">
                <span class="kicker" id="featureKicker">正在播放</span>
                <h1><button type="button" class="feature-hero-title" id="featureHeroTitle" data-play="这一生最美的祝福" data-artist="赞美之泉">这一生最美的祝福</button></h1>
                <p class="tagline"><button type="button" class="feature-hero-artist" id="featureHeroArtist" data-artist-filter="赞美之泉">赞美之泉</button></p>
              </div>
            </div>
            <p class="feature-description" id="featureHeroDescription">永恒的盼望 · 温暖治愈</p>
            <div class="feature-track"><span>入选理由</span><p id="featureReason">官方版本、现场敬拜与翻唱长期流传</p></div>
            <div class="feature-controls">
              <button class="big-play" data-play="这一生最美的祝福" data-artist="赞美之泉">▶</button>
              <button data-skip="prev" aria-label="上一首">|◀</button>
              <button class="feature-play" data-play="这一生最美的祝福" data-artist="赞美之泉" aria-label="播放">▶</button>
              <button data-skip="next" aria-label="下一首">▶|</button>
              <div class="feature-progress"><i id="featureProgress"></i></div>
              <small id="featureTime">00:00 / 05:26</small>
            </div>
            <button class="add-song-trigger feature-add-song" id="addSongButton"><span>＋</span> 添加歌曲</button>
          </div>
        </section>

        <div class="content-grid">
          <section class="main-column reveal delay-2">
            <section class="home-artists" id="homeArtists"><div class="section-head"><div><h2>敬拜乐团与专辑</h2></div></div><div class="home-artist-grid">
              <article class="home-artist-card"><button class="home-artist-open" data-artist-filter="赞美之泉"><img src={worshipAssets.band} alt="" /><span><strong>赞美之泉</strong><small>10 首歌曲</small></span></button><button class="home-artist-queue" data-add-artist-queue="赞美之泉" aria-label="将赞美之泉专辑添加至播放列表">▶</button></article>
              <article class="home-artist-card"><button class="home-artist-open" data-artist-filter="天韵合唱团"><img src={worshipAssets.album} alt="" /><span><strong>天韵合唱团</strong><small>10 首歌曲</small></span></button><button class="home-artist-queue" data-add-artist-queue="天韵合唱团" aria-label="将天韵合唱团专辑添加至播放列表">▶</button></article>
              <article class="home-artist-card"><button class="home-artist-open" data-artist-filter="小羊诗歌"><img src={worshipAssets.quiet} alt="" /><span><strong>小羊诗歌</strong><small>10 首歌曲</small></span></button><button class="home-artist-queue" data-add-artist-queue="小羊诗歌" aria-label="将小羊诗歌专辑添加至播放列表">▶</button></article>
              <article class="home-artist-card"><button class="home-artist-open" data-artist-filter="盛晓玫"><img src={worshipAssets.band} alt="" /><span><strong>盛晓玫</strong><small>10 首歌曲</small></span></button><button class="home-artist-queue" data-add-artist-queue="盛晓玫" aria-label="将盛晓玫专辑添加至播放列表">▶</button></article>
              <article class="home-artist-card"><button class="home-artist-open" data-artist-filter="泥土音乐"><img src={worshipAssets.quiet} alt="" /><span><strong>泥土音乐</strong><small>10 首歌曲</small></span></button><button class="home-artist-queue" data-add-artist-queue="泥土音乐" aria-label="将泥土音乐专辑添加至播放列表">▶</button></article>
              <article class="home-artist-card"><button class="home-artist-open" data-artist-filter="约书亚乐团"><img src={worshipAssets.video} alt="" /><span><strong>约书亚乐团</strong><small>10 首歌曲</small></span></button><button class="home-artist-queue" data-add-artist-queue="约书亚乐团" aria-label="将约书亚乐团专辑添加至播放列表">▶</button></article>
              <article class="home-artist-card"><button class="home-artist-open" data-artist-filter="GOOD TV 好音乐"><img src={worshipAssets.album} alt="" /><span><strong>GOOD TV 好音乐</strong><small>10 首歌曲</small></span></button><button class="home-artist-queue" data-add-artist-queue="GOOD TV 好音乐" aria-label="将 GOOD TV 好音乐专辑添加至播放列表">▶</button></article>
              <article class="home-artist-card"><button class="home-artist-open" data-artist-filter="KUA Worship"><img src={worshipAssets.band} alt="" /><span><strong>KUA Worship</strong><small>10 首歌曲</small></span></button><button class="home-artist-queue" data-add-artist-queue="KUA Worship" aria-label="将 KUA Worship 专辑添加至播放列表">▶</button></article>
              <article class="home-artist-card"><button class="home-artist-open" data-artist-filter="生命河灵粮堂"><img src={worshipAssets.quiet} alt="" /><span><strong>生命河灵粮堂</strong><small>11 首歌曲</small></span></button><button class="home-artist-queue" data-add-artist-queue="生命河灵粮堂" aria-label="将生命河灵粮堂专辑添加至播放列表">▶</button></article>
              <article class="home-artist-card"><button class="home-artist-open" data-artist-filter="迦南诗选"><img src={worshipAssets.video} alt="" /><span><strong>迦南诗选</strong><small>10 首歌曲</small></span></button><button class="home-artist-queue" data-add-artist-queue="迦南诗选" aria-label="将迦南诗选专辑添加至播放列表">▶</button></article>
            </div></section>
            <div class="category-row"><h2>歌曲分类</h2><section class="moods"><button class="mood" data-mood="温暖治愈"><span>☼</span>温暖治愈</button><button class="mood" data-mood="激情敬拜"><span>♨</span>激情敬拜</button><button class="mood" data-mood="欢快感恩"><span>☺</span>欢快感恩</button></section></div>
            <div class="section-head"><div><h2 id="listTitle">为你精选</h2></div><div class="section-actions"><button class="library-add-button" id="libraryAddButton" hidden>＋ 添加歌曲</button><button class="all-button" id="clearFilter">查看全部 →</button></div></div><div id="songList" class="song-list"></div><div id="artistList" class="artist-grid" hidden></div><div id="emptyState" class="empty" hidden>没有找到匹配歌曲，换个关键词试试。</div>
          </section>
          <aside class="queue-panel reveal delay-3" id="queuePanel">
            <div class="queue-head"><div><h2>正在播放</h2></div><button id="clearQueue">清理列表</button></div>
            <div class="now-card"><div class="cover cover-sun">这一生最美的祝福</div><div><button type="button" class="now-song-title" id="nowTitle" data-play="这一生最美的祝福" data-artist="赞美之泉">这一生最美的祝福</button><button type="button" class="now-artist" id="nowArtist" data-artist-filter="赞美之泉">赞美之泉</button></div><span class="heart filled">♥</span><div class="now-progress"><i id="nowProgress"></i></div><small class="time">点击歌曲开始播放</small></div>
            <div class="now-controls"><button data-skip="prev" aria-label="上一首">|◀</button><button id="queuePlayToggle" data-play="这一生最美的祝福" data-artist="赞美之泉" class="queue-main-play">▶</button><button data-skip="next" aria-label="下一首">▶|</button></div>
            <button class="lyrics-button" id="lyricsButton">查看歌词</button>
            <div class="queue-cover-stage">
              <img id="queueCoverImage" src={worshipAssets.album} alt="当前播放歌曲封面" />
              <span>当前歌曲封面</span>
            </div>
            <div class="queue-head queue-list-head"><h3 id="queueTitle" role="button" tabindex="0" aria-pressed="false" title="双击进入多选模式">播放列表 · <span id="queueCount">12</span><small>双击多选</small></h3><button id="addQueue">＋ 当前列表</button></div>
            <div class="queue-batch-actions" id="queueBatchActions" hidden><span>已选 <b id="queueSelectedCount">0</b> 首</span><button id="queueSelectAll">全选</button><button id="queuePlaySelected" disabled>▶ 播放</button><button id="queueDeleteSelected" class="danger" disabled>删除</button><button id="queueCancelSelection">完成</button></div>
            <p class="queue-status" id="queueStatus" aria-live="polite"></p>
            <div id="queueList" class="queue-list"></div>
          </aside>
        </div>
      </main>
    </div>

    <div class="player"><div class="player-cover cover cover-sun" aria-hidden="true"></div><div class="player-meta"><button type="button" class="player-song-title" id="playerTitle" data-play="这一生最美的祝福" data-artist="赞美之泉">这一生最美的祝福</button><button type="button" class="player-artist" id="playerArtist" data-artist-filter="赞美之泉">赞美之泉</button><button class="mini-heart" data-favorite="这一生最美的祝福" aria-label="收藏">♥</button></div><div class="player-controls"><button data-skip="prev" aria-label="上一首">|◀</button><button class="pause" id="playToggle" aria-label="播放">▶</button><button data-skip="next" aria-label="下一首">▶|</button></div><div class="player-seek"><span>来源</span><div><i id="playerProgress"></i></div><span id="playerSourceLabel">YouTube</span></div><button class="player-icon" id="lyricsButtonBottom" aria-label="歌词">▤</button><button class="player-icon" id="fullscreenPlayer" aria-label="全屏播放器">⛶</button></div>

    <dialog id="lyricsDialog" class="lyrics-dialog">
      <div class="dialog-head"><div><span class="kicker">LYRICS</span><h2 id="dialogSong">这一生最美的祝福</h2><p id="dialogArtist">赞美之泉</p></div><button id="closeDialog" aria-label="关闭">×</button></div>
      <div class="dialog-body">
        <div class="dialog-lyrics is-empty" id="dialogLyrics">这首歌暂未收录授权歌词。</div>
        <p class="lyrics-permission-note">请只粘贴官方允许转载、你自行创作或你已获得使用许可的歌词。网站不会自动抓取第三方完整歌词。</p>
        <div class="dialog-lyrics-actions">
          <button type="button" class="secondary-button" id="editLyricsButton">补充歌词</button>
          <a id="sourceLink" href="https://www.youtube.com/" target="_blank" rel="noreferrer">打开真实播放源 ↗</a>
        </div>
        <form id="lyricsForm" hidden>
          <label class="field field-wide"><span>歌词内容</span><textarea id="lyricsInput" maxlength="12000" rows="12" placeholder="在这里粘贴你有权使用的歌词；换行会按原样显示。"></textarea></label>
          <div class="song-form-actions"><button type="button" class="secondary-button" id="cancelLyricsEdit">取消</button><button type="submit" class="primary-button">保存歌词</button></div>
        </form>
      </div>
    </dialog>
    <dialog id="songDialog" class="song-editor-dialog">
      <form id="songForm" method="dialog">
        <div class="dialog-head"><div><span class="kicker">MY WORSHIP LIBRARY</span><h2 id="songDialogTitle">添加我喜欢的歌曲</h2><p>保存到当前主站账号，登录后可跨设备同步。</p></div><button type="button" id="closeSongDialog" aria-label="关闭">×</button></div>
        <div class="song-form-body">
          <label class="field field-wide"><span>播放链接 <b>必填</b></span><input id="songSourceUrl" name="sourceUrl" type="url" inputmode="url" placeholder="粘贴 YouTube 或 B站视频链接" required /><small>支持 youtube.com、youtu.be 和 bilibili.com 视频链接</small></label>
          <label class="field"><span>歌名 <b>必填</b></span><input id="songTitle" name="title" maxlength="80" required placeholder="例如：如鹰展翅上腾" /></label>
          <label class="field"><span>歌手 / 乐团 <b>必填</b></span><input id="songArtist" name="artist" maxlength="80" required placeholder="例如：生命河灵粮堂" /></label>
          <label class="field"><span>专辑或备注</span><input id="songAlbum" name="album" maxlength="80" placeholder="可选" /></label>
          <label class="field"><span>歌曲时长</span><input id="songDuration" name="duration" maxlength="8" inputmode="numeric" placeholder="例如 05:20" /></label>
          <fieldset class="mood-picker field-wide"><legend>歌曲分类</legend><label><input type="checkbox" name="moods" value="温暖治愈" checked /><span>☼ 温暖治愈</span></label><label><input type="checkbox" name="moods" value="激情敬拜" /><span>♨ 激情敬拜</span></label><label><input type="checkbox" name="moods" value="欢快感恩" /><span>☺ 欢快感恩</span></label></fieldset>
          <p class="form-error field-wide" id="songFormError" role="alert" hidden></p>
        </div>
        <div class="song-form-actions"><button type="button" class="secondary-button" id="cancelSongEdit">取消</button><button type="submit" class="primary-button" id="saveSongButton">保存到我的歌曲</button></div>
      </form>
    </dialog>
    <dialog id="categoryDialog" class="category-dialog">
      <form id="categoryForm" method="dialog">
        <div class="dialog-head"><div><span class="kicker">SONG CATEGORY</span><h2 id="categorySongTitle">修改歌曲分类</h2><p id="categorySongArtist"></p></div><button type="button" id="closeCategoryDialog" aria-label="关闭">×</button></div>
        <div class="category-form-body">
          <p>可以选择一个或多个分类，保存后会同步到当前主站账号。</p>
          <fieldset class="mood-picker"><legend>歌曲分类</legend><label><input type="checkbox" name="categoryMoods" value="温暖治愈" /><span>☼ 温暖治愈</span></label><label><input type="checkbox" name="categoryMoods" value="激情敬拜" /><span>♨ 激情敬拜</span></label><label><input type="checkbox" name="categoryMoods" value="欢快感恩" /><span>☺ 欢快感恩</span></label></fieldset>
          <p class="form-error" id="categoryFormError" role="alert" hidden></p>
        </div>
        <div class="song-form-actions"><button type="button" class="secondary-button" id="cancelCategoryEdit">取消</button><button type="submit" class="primary-button">保存分类</button></div>
      </form>
    </dialog>
    <script>
      import { getCloudDb, getCloudSession, getRememberedSession } from '../scripts/site-auth';
      import { initializeWorshipApp } from '../scripts/worship-app';
      import { createWorshipCloudStore } from '../scripts/worship-cloud-store';

      let identity = getRememberedSession();
      try { identity = await getCloudSession() || identity; } catch { /* 本地回退由共享存储处理。 */ }

      const getIdentity = async () => {
        if (identity?.uid) return identity;
        try { identity = await getCloudSession(); } catch { identity = null; }
        return identity;
      };
      const cloudStore = createWorshipCloudStore({
        getIdentity,
        getIdentitySnapshot: () => identity,
        getDocumentRef: (userId: string) => getCloudDb().collection('officialWebsiteWorshipMusic').doc(userId),
        storage: window.localStorage,
      });
      (window as any).worshipCloudStore = cloudStore;
      window.addEventListener('site-auth-change', (event) => { identity = (event as CustomEvent).detail || null; });
      initializeWorshipApp(cloudStore);
    </script>
  </body>
</html>
