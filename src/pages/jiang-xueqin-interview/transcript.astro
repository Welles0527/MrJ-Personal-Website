---
import dialogue from '../../data/jiang-xueqin-transcript.json';

import englishDialogue from '../../data/jiang-xueqin-transcript-en.json';
import captionAlignment from '../../data/jiang-xueqin-transcript-alignment.json';

const englishParagraphs: Record<string, string[]> = englishDialogue;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const interview = `${base}/jiang-xueqin-interview/`;
const videoId = 'Gkq-BaA0-Pk';
const video = `https://www.youtube.com/watch?v=${videoId}`;
// The host's recorded introduction follows the opening teaser.
const formalOpening = dialogue.findIndex(({ id }) => id === 'turn-1494');
const fullInterview = dialogue.slice(Math.max(0, formalOpening));
function formatVideoTime(seconds: number) {
  const hours = Math.floor(seconds / 3600);
  const minutes = Math.floor(seconds / 60) % 60;
  const remainder = String(seconds % 60).padStart(2, '0');
  return hours ? `${hours}:${String(minutes).padStart(2, '0')}:${remainder}` : `${minutes}:${remainder}`;
}

const labels: Record<string, string> = {
  host: '主持人 · Robinson Erhardt',
  guest: '江学勤',
};
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#272a2b" />
    <meta name="description" content="江学勤与 Robinson Erhardt 第三次访谈的中英文对话逐字稿，附原声播放。" />
    <title>完整访谈（逐字稿） · 江学勤访谈</title>
    <link rel="icon" href={`${base}/favicon.png`} />
    <style is:inline>
      :root {
        color-scheme: dark;
        --background: #272a2b;
        --border: #505553;
        --cream: #f2e8d8;
        --muted: #b7c0bb;
        --sage: #bbd2bf;
      }
      *, *::before, *::after { box-sizing: border-box; }
      html { min-width: 320px; }
      body { margin: 0; background: var(--background); color: var(--cream); font: 16px/1.85 "Noto Sans SC", "Microsoft YaHei", system-ui, sans-serif; }
      [hidden] { display: none !important; }
      a { color: var(--sage); text-decoration: none; }
      a:hover { text-decoration: underline; }
      :focus-visible { outline: 2px solid #e4bb52; outline-offset: 3px; }
      .shell { width: min(900px, calc(100% - 72px)); margin-inline: auto; }
      .topbar { display: flex; justify-content: space-between; align-items: center; gap: 12px; min-height: 68px; border-bottom: 1px solid var(--border); font-size: 14px; }
      .listen {
        display: inline-flex; align-items: center; justify-content: center; gap: 7px;
        flex-shrink: 0; min-height: 42px; padding: 5px 13px; border: 1px solid #72857a; border-radius: 8px;
        background: #35423b; color: #e0eddf; cursor: pointer; font: inherit;
      }
      .listen:hover { background: #44534a; }
      .listen svg { width: 17px; height: 17px; fill: none; stroke: currentColor; stroke-width: 1.6; }
      .intro { margin: 35px 0 25px; }
      .interview { color: var(--sage); margin: 0; font-size: 13px; }
      h1 { margin: 5px 0 8px; font-size: clamp(28px, 4vw, 48px); line-height: 1.3; letter-spacing: -.03em; }
      .source-note { max-width: 53em; margin: 0; color: var(--muted); font-size: 14px; }
      .language-switch { display: inline-flex; gap: 2px; margin: 8px 0; padding: 2px; border: 1px solid var(--border); border-radius: 9px; }
      .language-switch button { min-height: 44px; padding: 2px 15px; border: 0; border-radius: 6px; background: transparent; color: var(--muted); cursor: pointer; font: inherit; font-size: 14px; }
      .language-switch button[aria-pressed="true"] { background: #405047; color: #e0eddf; font-weight: 650; }
      .search-row { display: flex; align-items: center; flex-wrap: wrap; gap: 8px 15px; padding: 13px 0; border-block: 1px solid var(--border); }
      #search { flex: 1 0 210px; min-width: 0; padding: 8px 12px; border: 1px solid var(--border); border-radius: 8px; background: #222626; color: var(--cream); font: inherit; }
      #search::placeholder { color: var(--muted); }
      .search-actions { display: flex; gap: 8px; }
      .toolbar-button {
        min-height: 44px; border: 1px solid var(--border); border-radius: 8px;
        background: transparent; color: var(--cream); cursor: pointer; font: inherit;
      }
      .toolbar-button { flex: none; padding: 4px 11px; font-size: 14px; }
      .favorites-toggle span { margin-left: 4px; color: var(--muted); font-variant-numeric: tabular-nums; }
      .toolbar-button:hover { background: #35423b; }
      .favorites-toggle[aria-pressed="true"] { color: #f0cc76; border-color: #9e824c; background: #403a2d; }
      .turn-actions { display: flex; flex: none; align-items: center; }
      .turn-language, .turn-time, #close-video {
        min-height: 44px; padding: 0 6px; border: 0; border-radius: 6px;
        background: transparent; color: var(--sage); cursor: pointer; font: inherit; font-size: 13px;
      }
      .turn-language { min-width: 44px; }
      .turn-time { min-width: 44px; font-variant-numeric: tabular-nums; text-decoration: underline; text-underline-offset: 3px; }
      .turn-language:hover, .turn-time:hover, #close-video:hover { background: #35423b; }
      .turn-player { max-width: 640px; margin-bottom: 14px; }
      .player-controls { display: flex; justify-content: space-between; align-items: center; font-size: 13px; }
      .turn-player iframe { display: block; width: 100%; aspect-ratio: 16 / 9; min-height: 200px; border: 0; background: #171a1a; }
      .star {
        display: grid; place-items: center; min-width: 44px; min-height: 44px;
        padding: 0; border: 0; border-radius: 6px; background: transparent;
        color: var(--muted); cursor: pointer; font: 16px/1 system-ui, sans-serif;
      }
      .star:hover { background: #35423b; }
      .star[aria-pressed="true"] { color: #f0cc76; }
      .highlights-panel {
        width: min(620px, calc(100% - 34px)); max-height: min(720px, calc(100dvh - 34px));
        padding: 0 18px 18px; border: 1px solid var(--border); border-radius: 12px;
        background: #2d3230; color: var(--cream);
      }
      .highlights-panel[open] { display: flex; flex-direction: column; }
      .highlights-panel::backdrop { background: #141716b8; }
      .highlights-header { display: flex; justify-content: space-between; align-items: center; gap: 12px; padding: 10px 0; }
      .highlights-header h2 { margin: 0; font-size: 21px; }
      #highlights-list { margin: 0; padding: 4px; overflow: auto; list-style: none; }
      #highlights-list li + li { margin-top: 8px; }
      .highlight-link {
        display: block; width: 100%; padding: 10px 12px; border: 1px solid var(--border); border-radius: 8px;
        background: #272a2b; color: var(--cream); text-align: start; font: inherit; cursor: pointer;
      }
      .highlight-link:hover { border-color: var(--sage); }
      .highlight-meta { display: block; margin-bottom: 3px; color: var(--muted); font-size: 13px; }
      .highlight-quote { color: #f5d784; overflow-wrap: anywhere; }
      #no-highlights { margin: 0; color: var(--muted); }
      #count { color: var(--muted); font-size: 13px; }
      #count:empty { display: none; }
      .dialogue { margin: 0 0 58px; }
      .turn { padding: 21px 0; border-bottom: 1px solid #414644; }
      .turn-header { display: flex; justify-content: space-between; align-items: center; gap: 12px; margin-bottom: 4px; }
      .turn h2 { margin: 0; color: var(--sage); font-size: 14px; font-weight: 650; }
      .turn[data-speaker="guest"] h2 { color: #e9c990; }
      .turn p { margin: 0; overflow-wrap: anywhere; }
      .turn p + p { margin-top: 9px; }
      .highlight-hint { margin: 9px 0 0; color: var(--muted); font-size: 13px; }
      .search-highlight, .personal-highlight { border-radius: 2px; color: #152522; }
      .search-highlight { background: #b4dcf5; }
      .personal-highlight { background: #f5d784; }
      .personal-highlight.search-highlight { box-shadow: inset 0 -3px #5494c0; }
      .selection-actions {
        position: fixed; z-index: 5; display: flex; gap: 5px; padding: 5px;
        border: 1px solid #75837d; border-radius: 9px; background: #303833;
        box-shadow: 0 5px 22px #0008;
      }
      .selection-actions button {
        min-height: 44px; padding: 3px 11px; border: 1px solid var(--border); border-radius: 6px;
        background: #222626; color: var(--cream); white-space: nowrap; cursor: pointer; font: 14px/1.4 system-ui, sans-serif;
      }
      .selection-actions button:hover { background: #46534b; }
      .selection-actions #add-highlight { color: #221a0d; background: #f5d784; }
      .visually-hidden { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
      .empty { margin: 23px 0 60px; color: var(--muted); }
      @media (max-width: 680px) {
        .shell { width: calc(100% - 34px); }
        .topbar { min-height: 60px; }
        .listen { min-height: 38px; padding-inline: 9px; }
        .intro { margin-top: 24px; }
        #search { flex-basis: 100%; }
        .turn { padding: 16px 0; }
      }
    </style>
  </head>
  <body>
    <main class="shell">
      <nav class="topbar" aria-label="访谈导航">
        <a href={interview}>← 返回访谈问答</a>
        <a class="listen" href={video} target="_blank" rel="noopener noreferrer" title="在 YouTube 播放原声">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 10v4h4l5 4V6l-5 4H4Zm12-1a4 4 0 0 1 0 6m2-9a8 8 0 0 1 0 12" /></svg>
          <span>听访谈原声</span>
        </a>
      </nav>
      <header class="intro">
        <p class="interview">Robinson Erhardt × 江学勤 · 第三次对谈</p>
        <h1>完整访谈（逐字稿）</h1>
        <div class="language-switch" role="group" aria-label="逐字稿语言">
          <button type="button" data-lang="zh" aria-pressed="true">中文</button>
          <button type="button" data-lang="en" lang="en" aria-pressed="false">English</button>
        </div>
        <p class="source-note">英文取自原视频字幕，少量重叠发言可能有识别误差。英文字幕未收录的 17 段简短应答按中文字幕译出。</p>
      </header>
      <div class="search-row">
        <input id="search" type="search" aria-label="搜索对话" placeholder="搜索对话内容" autocomplete="off" />
        <div class="search-actions">
          <button class="toolbar-button favorites-toggle" type="button" id="show-favorites" aria-pressed="false">我的收藏 <span id="favorites-count">0</span></button>
          <button class="toolbar-button" type="button" id="show-highlights" aria-haspopup="dialog" aria-controls="highlights-panel">我的高亮</button>
        </div>
        <output id="count" for="search" aria-live="polite"></output>
      </div>
      <p class="highlight-hint">搜索命中显示为蓝色。选中文字可添加或取消黄色高亮。中文高亮会同步到英文对应句，可在中文原文调整。</p>
      <div class="selection-actions" id="selection-actions" role="group" aria-label="文字高亮" hidden>
        <button id="add-highlight" type="button">高亮</button>
        <button id="remove-highlight" type="button">取消高亮</button>
      </div>
      <p class="visually-hidden" id="highlight-status" role="status"></p>
      <dialog class="highlights-panel" id="highlights-panel" aria-labelledby="highlights-title">
        <div class="highlights-header">
          <h2 id="highlights-title">我的高亮</h2>
          <form method="dialog"><button class="toolbar-button" type="submit" autofocus>关闭</button></form>
        </div>
        <p id="no-highlights" hidden>选中逐字稿里的文字并添加高亮，摘录就会出现在这里。</p>
        <ul id="highlights-list" role="list"></ul>
      </dialog>
      <p class="empty" id="empty" hidden>没有找到符合条件的对话。</p>
      <div class="turn-player" id="turn-player" data-embed={`https://www.youtube.com/embed/${videoId}`} role="region" aria-label="原视频播放器" hidden>
        <div class="player-controls">
          <a id="video-source" href={video} target="_blank" rel="noopener noreferrer">在 YouTube 打开</a>
          <button id="close-video" type="button">关闭播放器</button>
        </div>
        <iframe id="interview-video" title="江学勤访谈原视频" allow="autoplay; encrypted-media; picture-in-picture" allowfullscreen referrerpolicy="strict-origin-when-cross-origin"></iframe>
      </div>
      <div class="dialogue" aria-label="对话逐字稿">
        {fullInterview.map(({ id, speaker, paragraphs, startSeconds }) => (
          <article class="turn" id={id} data-speaker={speaker}>
            <header class="turn-header">
              <h2>
                <span data-version="zh">{labels[speaker]}</span>
                <span data-version="en" lang="en" hidden>{speaker === 'host' ? 'Host · Robinson Erhardt' : 'Jiang Xueqin'}</span>
              </h2>
              <div class="turn-actions">
                <button class="turn-language" type="button" lang="en" aria-label="本段切换为英文">EN</button>
                <button class="turn-time" type="button" data-start={startSeconds} aria-controls="turn-player" aria-expanded="false" aria-label={`从 ${formatVideoTime(startSeconds)} 播放原视频`}>
                  {formatVideoTime(startSeconds)}
                </button>
                <button class="star" type="button" aria-label="收藏此段发言" aria-pressed="false">☆</button>
              </div>
            </header>
            <div data-version="zh">{paragraphs.map((paragraph) => <p>{paragraph}</p>)}</div>
            <div data-version="en" lang="en" hidden>{englishParagraphs[id].map((paragraph) => <p>{paragraph}</p>)}</div>
          </article>
        ))}
      </div>
    </main>
    <script is:inline define:vars={{ captionAlignment }}>
      const search = document.getElementById('search');
      const count = document.getElementById('count');
      const empty = document.getElementById('empty');
      const favoritesToggle = document.getElementById('show-favorites');
      const favoritesCount = document.getElementById('favorites-count');
      const selectionActions = document.getElementById('selection-actions');
      const addHighlight = document.getElementById('add-highlight');
      const removeHighlight = document.getElementById('remove-highlight');
      const highlightStatus = document.getElementById('highlight-status');
      const highlightsToggle = document.getElementById('show-highlights');
      const highlightsPanel = document.getElementById('highlights-panel');
      const highlightsList = document.getElementById('highlights-list');
      const noHighlights = document.getElementById('no-highlights');
      const highlightKey = 'jiang-xueqin-transcript-highlights-v1';
      const paragraphs = new Map();
      const languageButtons = document.querySelectorAll('.language-switch button');
      let language = 'zh';
      const player = document.getElementById('turn-player');
      const iframe = document.getElementById('interview-video');
      const videoSource = document.getElementById('video-source');
      const sourceUrl = new URL(videoSource.href);
      const closeVideo = document.getElementById('close-video');
      let playingButton = null;

      function indexVersion(turn, lang) {
        const [heading, body] = turn.querySelectorAll(`[data-version="${lang}"]`);
        const blocks = [];
        let text = '';
        for (const [index, node] of [heading, ...body.querySelectorAll('p')].entries()) {
          if (index) text += ' ';
          const block = { node, text: node.textContent, offset: text.length, paintKey: '' };
          if (index) {
            block.id = lang === 'zh' ? `${turn.id}:${index}` : `${turn.id}:en:${index}`;
            block.lang = lang;
            block.turnId = turn.id;
            paragraphs.set(block.id, block);
          }
          blocks.push(block);
          text += block.text;
        }
        return { heading, body, blocks, text: text.toLowerCase() };
      }
      const turns = [...document.querySelectorAll('.turn')].map((turn) => ({
        turn, star: turn.querySelector('.star'),
        languageButton: turn.querySelector('.turn-language'),
        timeButton: turn.querySelector('.turn-time'),
        preferredLanguage: null,
        zh: indexVersion(turn, 'zh'), en: indexVersion(turn, 'en'),
      }));
      const turnsById = new Map(turns.map((entry) => [entry.turn.id, entry]));
      const storageKey = 'jiang-xueqin-transcript-favorites-v1';
      let onlyFavorites = false;
      let canSave = true;
      let selected = [];
      let selectionFrame = 0;
      let canSaveHighlights = true;

      function readFavorites() {
        try {
          const stored = JSON.parse(localStorage.getItem(storageKey) || '[]');
          return new Set(Array.isArray(stored) ? stored.filter((id) => turnsById.has(id)) : []);
        } catch {
          return null;
        }
      }
      let favorites = readFavorites() ?? new Set();

      function readHighlights() {
        try {
          const stored = JSON.parse(localStorage.getItem(highlightKey) || '{}');
          const valid = new Map();
          for (const [id, block] of paragraphs) {
            const record = stored?.[id];
            if (record?.text !== block.text || !Array.isArray(record.ranges)) continue;
            const ranges = record.ranges.filter((range) => Array.isArray(range) && range.length === 2
              && range.every(Number.isInteger) && range[0] >= 0 && range[0] < range[1] && range[1] <= block.text.length);
            if (ranges.length) valid.set(id, mergeRanges(ranges));
          }
          return valid;
        } catch {
          return null;
        }
      }
      let highlights = readHighlights() ?? new Map();

      function mergeRanges(ranges) {
        const merged = [];
        for (const [start, end] of [...ranges].sort((a, b) => a[0] - b[0])) {
          const last = merged[merged.length - 1];
          if (last && start <= last[1]) last[1] = Math.max(last[1], end);
          else merged.push([start, end]);
        }
        return merged;
      }

      function matchesFor(text, term) {
        const matches = [];
        if (!term) return matches;
        for (let start = text.indexOf(term); start !== -1; start = text.indexOf(term, start + term.length)) {
          matches.push([start, start + term.length]);
        }
        return matches;
      }

      function getLinkedHighlights() {
        const linked = new Map();
        for (const [id, ranges] of highlights) {
          // Offsets use the same UTF-16 indexes as selections and saved highlights.
          for (const [start, end, targetId, targetStart, targetEnd] of captionAlignment[id] ?? []) {
            if (!ranges.some(([left, right]) => left < end && start < right)) continue;
            if (!linked.has(targetId)) linked.set(targetId, []);
            linked.get(targetId).push([targetStart, targetEnd]);
          }
        }
        return linked;
      }

      function paint(block, matches, linkedRanges) {
        const end = block.offset + block.text.length;
        const searchRanges = matches
          .filter(([start, finish]) => start < end && finish > block.offset)
          .map(([start, finish]) => [Math.max(start - block.offset, 0), Math.min(finish, end) - block.offset]);
        const direct = highlights.get(block.id) ?? [];
        const marked = linkedRanges ? mergeRanges([...direct, ...linkedRanges]) : direct;
        const paintKey = searchRanges.length || marked.length ? JSON.stringify([searchRanges, marked]) : '';
        if (paintKey === block.paintKey) return;
        block.paintKey = paintKey;
        const boundaries = [...new Set([0, block.text.length, ...searchRanges.flat(), ...marked.flat()])].sort((a, b) => a - b);
        const result = document.createDocumentFragment();
        for (let index = 1; index < boundaries.length; index++) {
          const start = boundaries[index - 1];
          const text = block.text.slice(start, boundaries[index]);
          const isMatch = searchRanges.some(([left, right]) => left <= start && start < right);
          const isMarked = marked.some(([left, right]) => left <= start && start < right);
          if (isMatch || isMarked) {
            const mark = document.createElement('mark');
            mark.classList.toggle('search-highlight', isMatch);
            mark.classList.toggle('personal-highlight', isMarked);
            mark.textContent = text;
            result.append(mark);
          } else {
            result.append(text);
          }
        }
        block.node.replaceChildren(result);
      }

      function filter() {
        const term = search.value.trim().toLowerCase();
        const linked = getLinkedHighlights();
        let visible = 0;
        for (const entry of turns) {
          const { turn, star, languageButton, timeButton } = entry;
          const zhMatches = matchesFor(entry.zh.text, term);
          const enMatches = matchesFor(entry.en.text, term);
          const matchLanguage = language === 'zh' && !zhMatches.length && enMatches.length ? 'en'
            : language === 'en' && !enMatches.length && zhMatches.length ? 'zh' : language;
          const shown = entry.preferredLanguage ?? matchLanguage;
          const { blocks } = entry[shown];
          const saved = favorites.has(turn.id);
          const needsFocus = document.activeElement === star;
          turn.hidden = (onlyFavorites && !saved) || (term !== '' && !zhMatches.length && !enMatches.length);
          if (turn.hidden && playingButton === timeButton) stopVideo();
          for (const version of ['zh', 'en']) {
            entry[version].heading.hidden = entry[version].body.hidden = version !== shown;
          }
          entry.shownLanguage = shown;
          languageButton.lang = shown === 'zh' ? 'en' : 'zh-CN';
          languageButton.textContent = shown === 'zh' ? 'EN' : '中文';
          languageButton.setAttribute('aria-label', shown === 'zh' ? '本段切换为英文' : '本段切换为中文');
          star.setAttribute('aria-pressed', String(saved));
          star.textContent = saved ? '★' : '☆';
          if (turn.hidden && needsFocus) favoritesToggle.focus({ preventScroll: true });
          if (!turn.hidden) {
            visible++;
            for (const block of blocks) {
              paint(block, shown === 'zh' ? zhMatches : enMatches, linked.get(block.id));
            }
          }
        }
        favoritesCount.textContent = favorites.size;
        empty.hidden = visible !== 0;
        empty.textContent = onlyFavorites
          ? favorites.size ? '没有找到符合条件的收藏。' : '还没有收藏的段落，点击「我的收藏」可返回全文。'
          : '没有找到符合条件的对话。';
        count.textContent = term ? `${visible} 段匹配` : '';
      }

      function offsetWithin(node, container, offset, fallback) {
        if (!node.contains(container)) return fallback;
        const prefix = document.createRange();
        prefix.selectNodeContents(node);
        prefix.setEnd(container, offset);
        return prefix.toString().length;
      }

      function closeActions() {
        selectionActions.hidden = true;
        selected = [];
      }

      function updateSelection() {
        const selection = window.getSelection();
        if (!selection?.rangeCount || selection.isCollapsed) {
          if (!selectionActions.contains(document.activeElement)) closeActions();
          return;
        }
        const range = selection.getRangeAt(0);
        const segments = [];
        for (const [id, { node, text }] of paragraphs) {
          if (!range.intersectsNode(node) || !node.getClientRects().length) continue;
          const start = offsetWithin(node, range.startContainer, range.startOffset, 0);
          const finish = offsetWithin(node, range.endContainer, range.endOffset, text.length);
          if (start < finish && text.slice(start, finish).trim()) segments.push({ id, start, finish });
        }
        const width = document.documentElement.clientWidth;
        const height = document.documentElement.clientHeight;
        const box = [...range.getClientRects()].reverse().find((rect) => rect.bottom > 0 && rect.top < height && rect.width > 0);
        if (!box || !segments.length) {
          closeActions();
          return;
        }
        selected = segments;
        removeHighlight.hidden = !segments.some(({ id, start, finish }) =>
          highlights.get(id)?.some(([left, right]) => left < finish && right > start));
        selectionActions.hidden = false;
        const { offsetWidth: menuWidth, offsetHeight: menuHeight } = selectionActions;
        const left = Math.min(width - menuWidth - 8, Math.max(8, box.left + (box.width - menuWidth) / 2));
        const top = box.bottom + menuHeight + 14 < height ? box.bottom + 7 : Math.max(8, box.top - menuHeight - 7);
        selectionActions.style.left = `${left}px`;
        selectionActions.style.top = `${top}px`;
      }

      function queueSelection() {
        if (selectionFrame) return;
        selectionFrame = requestAnimationFrame(() => {
          selectionFrame = 0;
          updateSelection();
        });
      }

      function changeHighlight(remove) {
        if (!selected.length) return;
        if (canSaveHighlights) highlights = readHighlights() ?? highlights;
        for (const { id, start, finish } of selected) {
          const current = highlights.get(id) ?? [];
          let updated = [];
          if (remove) {
            for (const [left, right] of current) {
              if (right <= start || left >= finish) updated.push([left, right]);
              else {
                if (left < start) updated.push([left, start]);
                if (right > finish) updated.push([finish, right]);
              }
            }
          } else {
            updated = mergeRanges([...current, [start, finish]]);
          }
          if (updated.length) highlights.set(id, updated);
          else highlights.delete(id);
        }
        if (canSaveHighlights) {
          try {
            const stored = Object.fromEntries([...highlights].map(([id, ranges]) => [id, { text: paragraphs.get(id).text, ranges }]));
            localStorage.setItem(highlightKey, JSON.stringify(stored));
          } catch {
            canSaveHighlights = false;
          }
        }
        window.getSelection()?.removeAllRanges();
        closeActions();
        highlightStatus.textContent = remove ? '已取消选中的高亮。' : '已添加高亮。';
        filter();
      }

      function jumpToHighlight(entry, block, start) {
        const wasHidden = entry.turn.hidden;
        entry.preferredLanguage = block.lang;
        if (wasHidden) {
          search.value = '';
          onlyFavorites = false;
          favoritesToggle.setAttribute('aria-pressed', 'false');
        }
        highlightsPanel.close();
        filter();
        block.node.tabIndex = -1;
        block.node.focus({ preventScroll: true });
        let end = 0;
        for (const child of block.node.childNodes) {
          end += child.textContent.length;
          if (start >= end) continue;
          const target = child instanceof HTMLElement ? child : block.node;
          target.scrollIntoView({ block: 'center' });
          break;
        }
      }

      function renderHighlights() {
        const results = document.createDocumentFragment();
        for (const [id, block] of paragraphs) {
          const ranges = highlights.get(id);
          if (!ranges) continue;
          const entry = turnsById.get(block.turnId);
          const label = entry[block.lang].blocks[0].text;
          const time = entry.timeButton.textContent.trim();
          for (const [start, end] of ranges) {
            const item = document.createElement('li');
            const button = document.createElement('button');
            const meta = document.createElement('span');
            const quote = document.createElement('span');
            button.type = 'button';
            button.className = 'highlight-link';
            meta.className = 'highlight-meta';
            meta.textContent = `${time} · ${label} · ${block.lang === 'zh' ? '中文' : 'English'}`;
            quote.className = 'highlight-quote';
            quote.lang = block.lang === 'zh' ? 'zh-CN' : 'en';
            quote.textContent = block.text.slice(start, end);
            button.append(meta, quote);
            button.addEventListener('click', () => jumpToHighlight(entry, block, start));
            item.append(button);
            results.append(item);
          }
        }
        noHighlights.hidden = results.childElementCount > 0;
        highlightsList.replaceChildren(results);
      }

      highlightsToggle.addEventListener('click', () => {
        window.getSelection()?.removeAllRanges();
        closeActions();
        if (canSaveHighlights) highlights = readHighlights() ?? highlights;
        renderHighlights();
        highlightsPanel.showModal();
      });

      function toggleFavorite(id) {
        if (canSave) favorites = readFavorites() ?? favorites;
        if (favorites.has(id)) favorites.delete(id);
        else favorites.add(id);
        if (canSave) {
          try {
            localStorage.setItem(storageKey, JSON.stringify([...favorites]));
          } catch {
            canSave = false;
          }
        }
        filter();
      }

      function stopVideo() {
        playingButton?.setAttribute('aria-expanded', 'false');
        playingButton = null;
        player.hidden = true;
        iframe.removeAttribute('src');
      }

      function playVideo(turn, button) {
        if (playingButton === button) {
          stopVideo();
          return;
        }
        stopVideo();
        const { start } = button.dataset;
        const url = new URL(player.dataset.embed);
        url.search = new URLSearchParams({ start, autoplay: '1', playsinline: '1' });
        sourceUrl.searchParams.set('t', `${start}s`);
        videoSource.href = sourceUrl.href;
        turn.querySelector('.turn-header').after(player);
        iframe.src = url.href;
        player.hidden = false;
        playingButton = button;
        button.setAttribute('aria-expanded', 'true');
      }

      closeVideo.addEventListener('click', () => {
        const button = playingButton;
        stopVideo();
        button?.focus({ preventScroll: true });
      });
      for (const entry of turns) {
        const { turn, star, languageButton, timeButton } = entry;
        star.addEventListener('click', () => toggleFavorite(turn.id));
        timeButton.addEventListener('click', () => playVideo(turn, timeButton));
        languageButton.addEventListener('click', () => {
          window.getSelection()?.removeAllRanges();
          closeActions();
          entry.preferredLanguage = entry.shownLanguage === 'zh' ? 'en' : 'zh';
          filter();
        });
      }
      favoritesToggle.addEventListener('click', () => {
        onlyFavorites = !onlyFavorites;
        favoritesToggle.setAttribute('aria-pressed', String(onlyFavorites));
        filter();
      });
      window.addEventListener('storage', (event) => {
        if (event.key !== storageKey && event.key !== highlightKey && event.key !== null) return;
        if (canSave && event.key !== highlightKey) favorites = readFavorites() ?? favorites;
        if (canSaveHighlights && event.key !== storageKey) {
          highlights = readHighlights() ?? highlights;
          if (highlightsPanel.open) renderHighlights();
        }
        filter();
      });
      document.addEventListener('selectionchange', queueSelection);
      window.addEventListener('scroll', queueSelection, { passive: true });
      window.addEventListener('resize', queueSelection);
      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape' && !selectionActions.hidden) {
          window.getSelection()?.removeAllRanges();
          closeActions();
        }
      });
      selectionActions.addEventListener('pointerdown', (event) => event.preventDefault());
      addHighlight.addEventListener('click', () => changeHighlight(false));
      removeHighlight.addEventListener('click', () => changeHighlight(true));
      search.addEventListener('input', filter);

      function showLanguage(lang) {
        language = lang;
        window.getSelection()?.removeAllRanges();
        closeActions();
        search.value = '';
        search.placeholder = lang === 'en' ? 'Search transcript' : '搜索对话内容';
        for (const button of languageButtons) {
          button.setAttribute('aria-pressed', String(button.dataset.lang === lang));
        }
        for (const entry of turns) entry.preferredLanguage = null;
        filter();
      }
      for (const button of languageButtons) {
        button.addEventListener('click', () => {
          const lang = button.dataset.lang;
          if (lang === language && !turns.some((entry) => entry.preferredLanguage)) return;
          const url = new URL(location.href);
          if (lang === 'en') url.searchParams.set('lang', 'en');
          else url.searchParams.delete('lang');
          history.replaceState(history.state, '', url);
          showLanguage(lang);
        });
      }
      showLanguage(new URL(location.href).searchParams.get('lang') === 'en' ? 'en' : 'zh');
    </script>
  </body>
</html>
