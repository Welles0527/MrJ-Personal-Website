---
import BaseLayout from '../../../../../layouts/BaseLayout.astro';

const basePath = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const theologyHref = `${basePath}topics/applications/inspiration-station/theology/`;
const pageAddress = `${basePath}topics/applications/inspiration-station/theology/alternative-knowledge/`;
---

<BaseLayout title="另类知识｜微读圣经" activeTheme="applications" bare>
  <main class="alternative-archive">
    <div class="archive-orbit archive-orbit-one" aria-hidden="true"></div>
    <div class="archive-orbit archive-orbit-two" aria-hidden="true"></div>

    <header class="archive-header">
      <a href={theologyHref} class="archive-back"><span aria-hidden="true">←</span> 返回微读圣经</a>
      <div class="archive-index" aria-hidden="true">08</div>
      <p class="archive-kicker">ALTERNATIVE KNOWLEDGE · ARCHIVE 08</p>
      <h1>另类知识</h1>
      <p class="archive-lede">这里将收纳圣经中的地理、礼仪、象征，以及那些容易被忽略、却能打开阅读视角的知识线索。</p>
    </header>

    <section class="archive-status" aria-labelledby="archive-status-title">
      <div class="archive-status-mark" aria-hidden="true">
        <span></span>
        <i></i>
      </div>
      <div class="archive-status-copy">
        <p>ADDRESS RESERVED</p>
        <h2 id="archive-status-title">站内入口已经建立</h2>
        <p>内容正在另一个任务中准备。完成后可以直接把本地页面与资源接入这个固定地址，无需再次修改主导航。</p>
        <code>{pageAddress}</code>
      </div>
      <span class="archive-status-badge">等待内容接入</span>
    </section>

    <section class="archive-preview" aria-label="计划收录的内容类型">
      <article>
        <span>01</span>
        <p>PLACES</p>
        <h2>地理与名山</h2>
        <small>地点、路线与事件发生的空间背景</small>
      </article>
      <article>
        <span>02</span>
        <p>RITUALS</p>
        <h2>礼仪与献祭</h2>
        <small>仪式、器物与敬拜秩序的知识脉络</small>
      </article>
      <article>
        <span>03</span>
        <p>SYMBOLS</p>
        <h2>象征与线索</h2>
        <small>数字、意象与跨经卷呼应的阅读入口</small>
      </article>
    </section>
  </main>
</BaseLayout>

<style>
  :global(html),
  :global(body) {
    background: #070a11;
  }

  .alternative-archive {
    --archive-gold: #d8b45f;
    --archive-cream: #fff1c9;
    --archive-muted: rgba(232, 235, 231, 0.62);
    position: relative;
    min-height: 100vh;
    overflow: hidden;
    padding: clamp(1.2rem, 4vw, 3rem);
    background:
      radial-gradient(circle at 80% 12%, rgba(93, 75, 158, 0.23), transparent 30rem),
      radial-gradient(circle at 14% 88%, rgba(25, 79, 104, 0.2), transparent 28rem),
      linear-gradient(145deg, #101426 0%, #080b12 50%, #05070c 100%);
    color: var(--archive-cream);
    font-family: "Noto Sans SC", "Microsoft YaHei", sans-serif;
  }

  .alternative-archive::before {
    position: absolute;
    inset: 0;
    background-image: radial-gradient(rgba(242, 218, 158, 0.28) 0.7px, transparent 0.7px);
    background-size: 28px 28px;
    content: "";
    opacity: 0.35;
    pointer-events: none;
  }

  .archive-orbit {
    position: absolute;
    border: 1px solid rgba(216, 180, 95, 0.12);
    border-radius: 50%;
    pointer-events: none;
  }

  .archive-orbit-one {
    top: -16rem;
    right: -11rem;
    width: 44rem;
    height: 44rem;
  }

  .archive-orbit-two {
    top: -8rem;
    right: -3rem;
    width: 28rem;
    height: 28rem;
  }

  .archive-header,
  .archive-status,
  .archive-preview {
    position: relative;
    z-index: 1;
    width: min(100%, 1180px);
    margin-inline: auto;
  }

  .archive-header {
    padding: clamp(1rem, 3vw, 2.4rem) 0 clamp(2.8rem, 7vw, 6.8rem);
  }

  .archive-back {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    margin-bottom: clamp(4rem, 10vw, 8rem);
    color: rgba(255, 241, 201, 0.64);
    font-size: 0.82rem;
    font-weight: 800;
    text-decoration: none;
    transition: color 180ms ease, transform 180ms ease;
  }

  .archive-back:hover {
    color: var(--archive-gold);
    transform: translateX(-0.22rem);
  }

  .archive-index {
    position: absolute;
    right: 0;
    bottom: 1rem;
    color: rgba(216, 180, 95, 0.08);
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(10rem, 28vw, 23rem);
    font-weight: 700;
    line-height: 0.72;
    pointer-events: none;
  }

  .archive-kicker,
  .archive-status-copy > p:first-child,
  .archive-preview article > p {
    margin: 0;
    color: var(--archive-gold);
    font-family: ui-monospace, Consolas, monospace;
    font-size: 0.7rem;
    font-weight: 900;
    letter-spacing: 0.14em;
  }

  .archive-header h1 {
    max-width: 8em;
    margin: 0.72rem 0 0;
    font-family: "Noto Serif SC", "Songti SC", SimSun, serif;
    font-size: clamp(4rem, 12vw, 9.6rem);
    letter-spacing: -0.08em;
    line-height: 0.94;
  }

  .archive-lede {
    max-width: 42rem;
    margin: 1.6rem 0 0;
    color: var(--archive-muted);
    font-size: clamp(0.98rem, 2vw, 1.16rem);
    line-height: 1.9;
  }

  .archive-status {
    display: grid;
    grid-template-columns: 8rem minmax(0, 1fr) auto;
    align-items: center;
    gap: clamp(1.2rem, 4vw, 2.4rem);
    border: 1px solid rgba(216, 180, 95, 0.28);
    border-radius: 1.1rem;
    padding: clamp(1.2rem, 4vw, 2.3rem);
    background:
      linear-gradient(135deg, rgba(255, 255, 255, 0.055), rgba(255, 255, 255, 0.018)),
      rgba(7, 10, 17, 0.68);
    box-shadow: 0 1.8rem 5rem rgba(0, 0, 0, 0.3);
    backdrop-filter: blur(14px);
  }

  .archive-status-mark {
    position: relative;
    display: grid;
    width: 8rem;
    height: 8rem;
    place-items: center;
    border: 1px solid rgba(216, 180, 95, 0.3);
    border-radius: 50%;
  }

  .archive-status-mark::before,
  .archive-status-mark::after {
    position: absolute;
    background: rgba(216, 180, 95, 0.28);
    content: "";
  }

  .archive-status-mark::before {
    width: 70%;
    height: 1px;
  }

  .archive-status-mark::after {
    width: 1px;
    height: 70%;
  }

  .archive-status-mark span {
    width: 2.35rem;
    height: 2.35rem;
    border: 2px solid var(--archive-gold);
    border-radius: 50%;
  }

  .archive-status-mark i {
    position: absolute;
    width: 84%;
    height: 84%;
    border: 1px dashed rgba(216, 180, 95, 0.22);
    border-radius: 50%;
  }

  .archive-status-copy h2 {
    margin: 0.48rem 0 0;
    font-family: "Noto Serif SC", "Songti SC", SimSun, serif;
    font-size: clamp(1.6rem, 4vw, 2.8rem);
  }

  .archive-status-copy > p:not(:first-child) {
    max-width: 43rem;
    margin: 0.65rem 0 0;
    color: var(--archive-muted);
    font-size: 0.88rem;
    line-height: 1.8;
  }

  .archive-status-copy code {
    display: block;
    margin-top: 0.9rem;
    color: rgba(255, 241, 201, 0.72);
    font-family: ui-monospace, Consolas, monospace;
    font-size: 0.72rem;
    line-height: 1.7;
    overflow-wrap: anywhere;
  }

  .archive-status-badge {
    flex: none;
    border: 1px solid rgba(216, 180, 95, 0.34);
    border-radius: 999px;
    padding: 0.62rem 0.82rem;
    color: #e4c879;
    font-size: 0.72rem;
    font-weight: 900;
    white-space: nowrap;
  }

  .archive-preview {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.8rem;
    padding: clamp(2rem, 5vw, 4rem) 0 4rem;
  }

  .archive-preview article {
    position: relative;
    min-height: 13rem;
    overflow: hidden;
    border: 1px solid rgba(216, 180, 95, 0.14);
    border-radius: 0.9rem;
    padding: 1.25rem;
    background: rgba(255, 255, 255, 0.025);
  }

  .archive-preview article > span {
    position: absolute;
    right: 0.75rem;
    bottom: -1.3rem;
    color: rgba(216, 180, 95, 0.08);
    font-family: Georgia, serif;
    font-size: 7.5rem;
    font-weight: 700;
    line-height: 1;
  }

  .archive-preview h2 {
    margin: 2.7rem 0 0.45rem;
    font-family: "Noto Serif SC", "Songti SC", SimSun, serif;
    font-size: 1.45rem;
  }

  .archive-preview small {
    position: relative;
    z-index: 1;
    color: var(--archive-muted);
    line-height: 1.7;
  }

  @media (max-width: 760px) {
    .archive-index {
      bottom: 3rem;
    }

    .archive-status {
      grid-template-columns: 1fr;
    }

    .archive-status-mark {
      width: 5.6rem;
      height: 5.6rem;
    }

    .archive-status-badge {
      width: fit-content;
    }

    .archive-preview {
      grid-template-columns: 1fr;
    }

    .archive-preview article {
      min-height: 10rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .archive-back {
      transition: none;
    }
  }
</style>
