<!doctype html>
<html lang="zh-CN">
<head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>小组查经 · 微读圣经</title>
<style is:global>
:root{color-scheme:dark;--bg:#11110e;--panel:#1b1b16;--line:#3b3829;--gold:#e8bf70;--ink:#f2eddd;--muted:#b2ad9b}*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--ink);font:15px/1.65 "Microsoft YaHei",sans-serif}button,input,textarea,select{font:inherit}button,a,input,textarea,select{touch-action:manipulation}button,.button{border:1px solid var(--line);border-radius:7px;padding:9px 15px;background:transparent;color:var(--ink);cursor:pointer;text-decoration:none;display:inline-block}button:hover,.button:hover{border-color:var(--gold);color:var(--gold)}:focus-visible{outline:2px solid var(--gold);outline-offset:3px}.primary{background:var(--gold);color:#201b10;border-color:var(--gold);font-weight:700}.primary:hover{background:#f6d898;color:#201b10}input,textarea,select{width:100%;min-width:0;background:#12130f;color:var(--ink);border:1px solid var(--line);border-radius:6px;padding:10px 12px}textarea{resize:vertical;min-height:92px;line-height:1.8}label{display:block;color:var(--muted);font-size:13px}label input,label textarea,label select{margin-top:6px}h1,h2,h3,p{margin:0}h1,h2{font-family:"Songti SC","SimSun",serif}h1{font-size:42px;letter-spacing:.06em}h2{font-size:25px}h3{font-size:17px}a{color:var(--gold)}.eyebrow{color:var(--gold);font-size:11px;letter-spacing:.22em}.muted{color:var(--muted);font-size:13px}.shell{display:grid;grid-template-columns:244px minmax(0,1fr);min-height:100vh}aside{border-right:1px solid var(--line);padding:34px 22px;background:#151610;position:sticky;top:0;height:100vh;overflow:auto}.brand{display:block;color:var(--ink);text-decoration:none;font-family:serif;font-size:23px;margin:8px 0 34px}.side-heading{display:flex;align-items:center;justify-content:space-between;margin-bottom:14px}#plans{display:grid;gap:10px;margin:18px 0 28px}#plans button{text-align:left;overflow-wrap:anywhere}#plans button[aria-current=true]{background:#2b281c;border-color:var(--gold)}#plans small{display:block;color:var(--muted)}.local-note{border-top:1px solid var(--line);padding-top:20px}.workspace{max-width:1210px;width:100%;padding:30px 46px 70px;margin:auto}.topbar,.actions,.section-head{display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap}.topbar{margin-bottom:40px}.hero{border-bottom:1px solid var(--line);padding-bottom:26px;margin-bottom:26px}.hero p{margin-top:8px}.tabs{display:flex;gap:22px;flex-wrap:wrap;margin-top:24px}.tabs a{text-decoration:none;font-size:13px;color:var(--muted)}.tabs a:hover{color:var(--gold)}section{scroll-margin-top:20px;margin-top:32px}.section-head{margin-bottom:18px}.section-head .eyebrow{margin-right:12px}.paper{background:var(--panel);border:1px solid var(--line);border-radius:12px;padding:24px}.fields{display:grid;grid-template-columns:1fr 1fr;gap:16px}.wide{grid-column:1/-1}.stack{display:grid;gap:14px}.step,.question,.resource,.passage{border:1px solid var(--line);border-radius:8px;padding:18px;background:#171812}.step{border-left:3px solid #665c3d}.step.focus,.question.focus{border-left:3px solid var(--gold);background:#252215}.step-head{display:grid;grid-template-columns:30px minmax(0,1fr) 90px;gap:10px;align-items:center;margin-bottom:12px}.step-number{font:22px Georgia,serif;color:var(--gold)}.tools{display:flex;gap:8px;flex-wrap:wrap;margin-top:12px}.tools button{font-size:12px;padding:5px 10px}.notes-preview{white-space:pre-wrap;overflow-wrap:anywhere;border-top:1px dashed var(--line);padding-top:12px;margin-top:12px;color:#d4cbb6}mark{background:#e8bf70;color:#211c10;border-radius:2px;padding:1px 2px}.scripture-picker{display:grid;grid-template-columns:2fr 1fr 1fr 1fr auto;gap:10px;align-items:end}.verse{margin-top:10px;line-height:1.95}.verse button{padding:2px 7px;margin-right:9px;color:var(--gold)}.resource{display:flex;align-items:center;justify-content:space-between;gap:12px}.resource div{min-width:0}.resource a{overflow-wrap:anywhere}.resource small{display:block;color:var(--muted)}.resource-form{display:grid;grid-template-columns:110px 1fr 2fr auto;gap:10px;margin-top:16px}.question textarea{margin-top:10px}.empty{padding:18px 0;color:var(--muted);font-size:14px}.footer{border-top:1px solid var(--line);margin-top:38px;padding-top:20px}.save-error{color:#ffad99!important}#notice{position:fixed;bottom:22px;left:50%;transform:translateX(-50%);background:#f1d79f;color:#221b0d;border-radius:7px;padding:12px 22px;z-index:10;max-width:90vw}#notice:empty{display:none}body.present input,body.present textarea{background:transparent;border-color:transparent}body.present .edit-only{display:none}body.present aside{display:none}body.present .shell{grid-template-columns:1fr}body.present textarea{resize:none}.backup{display:flex;gap:8px;flex-wrap:wrap;margin-top:12px}.backup button{font-size:12px}input[type=file]{max-width:100%}
.brand{font-size:18px;white-space:nowrap}
@media(max-width:760px){.shell{grid-template-columns:1fr}aside{position:relative;height:auto;padding:20px;border-right:0;border-bottom:1px solid var(--line)}.brand{margin:5px 0 15px}#plans{display:flex;overflow:auto;margin:12px 0}#plans button{min-width:170px;max-width:230px}.local-note{padding-top:12px}.workspace{padding:24px 18px 45px}.topbar{margin-bottom:28px}h1{font-size:34px}.paper{padding:16px}.fields{grid-template-columns:1fr}.scripture-picker{grid-template-columns:repeat(3,1fr)}.scripture-picker label:first-child{grid-column:1/-1}.scripture-picker button{grid-column:1/-1}.resource-form{grid-template-columns:1fr}.resource{align-items:flex-start}.tabs{gap:16px}.step-head{grid-template-columns:23px minmax(0,1fr) 72px}.step,.question,.passage{padding:13px}}
.tabs{display:grid;gap:4px;margin:0 0 24px}.tabs a{display:block;padding:9px 12px;border-left:2px solid var(--line)}.tabs a:hover,.tabs a:focus-visible{background:#252215;border-left-color:var(--gold)}@media(max-width:760px){.tabs{grid-template-columns:1fr 1fr;gap:4px}}
.account-panel{margin-left:auto;max-width:100%;text-align:right}.account-panel>p{margin-bottom:10px;color:var(--gold);font-size:14px;overflow-wrap:anywhere}.account-panel .actions{flex-wrap:wrap}dialog{width:min(420px,calc(100vw - 32px));background:var(--panel);color:var(--ink);border:1px solid var(--gold);border-radius:12px;padding:24px}dialog::backdrop{background:#000b}dialog label{margin:14px 0}#login-error{color:#ffad99;margin:12px 0}.topbar .actions{justify-content:flex-end}button[hidden]{display:none}@media print{body{background:white;color:black}aside,.topbar,.tabs,.edit-only,.tools,.backup,#notice{display:none!important}.shell{display:block}.workspace{padding:0;max-width:none}.paper,.step,.question,.passage,.resource{background:white;color:black;break-inside:avoid}input,textarea{color:black;background:white;border:0}h1,h2,a,.muted,label{color:black}.notes-preview{color:black}}
.shell{display:block}.plan-library{position:static;height:auto;max-width:1210px;margin:auto;padding:22px 46px;border-right:0;border-bottom:1px solid var(--line);background:transparent;overflow:visible}.library-heading{display:flex;justify-content:space-between;align-items:center;gap:14px;flex-wrap:wrap}.library-heading .brand{margin:0}.library-heading .side-heading{margin:0;gap:16px}.plan-library #plans{display:flex;gap:10px;flex-wrap:wrap;max-height:150px;overflow:auto;margin:18px 0 10px}.plan-library #plans button{min-width:180px;max-width:260px}.backup-details{font-size:12px;color:var(--muted)}.backup-details summary{cursor:pointer;width:fit-content}.backup-details .local-note{border:0;padding-top:10px}.workspace{padding-top:24px}.hero{margin-bottom:0}.tabs{display:flex;gap:6px;position:sticky;top:0;z-index:4;background:var(--bg);padding:12px 0;margin:0 0 28px;border-bottom:1px solid var(--line);overflow:auto;flex-wrap:nowrap}.tabs a{flex:1;min-width:100px;text-align:center;border:1px solid transparent;border-radius:7px;padding:11px 14px;white-space:nowrap}.tabs a[aria-selected="true"]{border-color:var(--gold);background:#2b281c;color:var(--gold)}[role="tabpanel"][hidden]{display:none!important}section{scroll-margin-top:80px}.rich-editor{min-height:90px;padding:16px;line-height:1.95;white-space:pre-wrap;overflow-wrap:anywhere;color:var(--ink);outline:none}.rich-editor:empty::before{content:attr(data-placeholder);color:#8d897b;pointer-events:none}.rich-editor:focus{box-shadow:inset 0 0 0 1px var(--gold);border-radius:5px}.editor-block{margin-top:12px;border:1px solid var(--line);border-radius:7px;background:#13140f;overflow:hidden}.rich-tools{display:flex;flex-wrap:wrap;gap:8px;border-bottom:1px solid var(--line);padding:7px 10px}.rich-tools button{padding:3px 9px;font-size:12px}.question>.editor-block:first-of-type .rich-editor{min-height:64px}.question.is-dragging{opacity:.55;border-style:dashed;border-color:var(--gold)}.drag-handle{touch-action:none;cursor:grab;user-select:none;font-size:12px}.drag-handle:active{cursor:grabbing}.followup-panel{margin-top:24px}body.present .rich-editor{background:transparent;border:0;min-height:0}body.present .editor-block{background:transparent}body.present .plan-library{display:none}@media(max-width:760px){.plan-library{padding:18px}.plan-library #plans{flex-wrap:nowrap;max-height:none}.tabs{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:4px}.tabs a{min-width:0;padding:9px 6px}.rich-editor{padding:12px}.library-heading .brand{font-size:17px}}
</style>
</head>
<body>
<div class="shell">
<aside class="plan-library"><div class="library-heading"><a class="brand" href="../">微读圣经 / 查经手册</a><div class="side-heading"><span>我的聚会</span><button id="new-plan" class="primary" aria-label="新建查经计划">＋ 新建</button></div></div><div id="plans"></div><details class="backup-details"><summary>备份与保存说明</summary><div class="local-note"><p class="muted">登录后自动保存到账号云端；离线编辑保留在此浏览器，联网后重试。</p><div class="backup"><button id="export">导出全部备份</button><button id="import">导入备份</button></div><input id="import-file" type="file" accept="application/json,.json" hidden></div></details></aside>
<main class="workspace">
<div class="topbar"><span id="save-state" class="muted" role="status">本地草稿</span><div class="account-panel"><p id="account-name" role="status">正在检查登录状态…</p><div class="actions"><button id="login-open">登录账号</button><button id="sync-now">同步</button><button id="logout" hidden>退出账号</button><button id="present">带领模式</button><a class="button" href="../">← 返回圣经</a></div></div></div>
<header class="hero"><span class="eyebrow">SMALL GROUP STUDY · 05</span><h1>小组查经</h1></header>
<nav class="tabs" aria-label="查经手册章节" role="tablist"><a href="#overview">聚会信息</a><a href="#scripture">查考经文</a><a href="#resources">视频与资料</a><a href="#flow">流程安排</a><a href="#discussion">问题与记录</a></nav>
<section id="overview" class="paper"><div class="section-head"><h2>本次聚会</h2><span class="muted" id="total-time"></span></div><div class="fields"><label class="wide">查经主题<input id="title" maxlength="150" data-meta="title" placeholder="例如：在起初，看见创造的美好"></label><label>聚会日期<input type="date" data-meta="date"></label><label>带领人 / 小组<input data-meta="leader" maxlength="150" placeholder="填写带领人或小组名称"></label><label class="wide">本次目标<textarea data-meta="goal" placeholder="希望大家从经文中看见什么？如何回应？"></textarea></label></div></section>
<section id="scripture"><div class="section-head"><h2><span class="eyebrow">01</span>查考经文</h2><span class="muted">和合本 · 简体</span></div><div class="paper"><form id="scripture-form" class="scripture-picker edit-only"><label>书卷<select id="book"></select></label><label>章<input id="chapter" type="number" min="1" max="150" value="1" required></label><label>起始节<input id="verse-start" type="number" min="1" value="1" required></label><label>结束节<input id="verse-end" type="number" min="1" value="5" required></label><button class="primary" id="add-scripture">加入经文</button></form><p id="scripture-status" class="muted" role="status"></p><div id="passages" class="stack"></div></div></section>
<section id="resources"><div class="section-head"><h2><span class="eyebrow">02</span>视频与资料</h2></div><div class="paper"><div id="resource-list" class="stack"></div><form id="resource-form" class="resource-form edit-only"><label>类型<select id="resource-type"><option>视频</option><option>文章</option><option>其他链接</option></select></label><label>标题<input id="resource-title" maxlength="200" required placeholder="例如：本章背景视频"></label><label>链接<input id="resource-url" type="url" required placeholder="https://…"></label><button class="primary">添加资料</button></form><p class="muted">资料在新标签页打开；可添加视频平台链接，无需上传视频。</p></div></section>
<section id="flow"><div class="section-head"><h2><span class="eyebrow">03</span>流程安排</h2><button id="add-step" class="edit-only">＋ 添加环节</button></div><p class="muted edit-only">可上下调整顺序；选中内容中的文字后点击“高亮选中文字”。</p><div id="steps" class="stack"></div></section>
<section id="discussion"><div class="section-head"><h2><span class="eyebrow">04</span>问题与记录</h2><button id="add-question" class="edit-only">＋ 添加问题</button></div><div id="questions" class="stack"></div>
<div class="paper followup-panel"><div class="section-head"><h2>带走与回应</h2></div><div class="fields"><label class="wide">聚会记录 / 代祷事项<textarea data-meta="notes" placeholder="记录大家的分享、需要继续查考的问题和代祷事项。"></textarea></label><label class="wide">下次跟进<textarea data-meta="followup" placeholder="谁来跟进？下次见面前可以实践什么？"></textarea></label></div></div></section>
<footer class="footer muted">你们要彼此劝慰，互相建立。 · 帖撒罗尼迦前书 5:11<br>请尊重组员隐私，导出备份前留意其中的个人分享。</footer>
</main></div><div id="notice" role="status"></div><dialog id="login-dialog"><form id="login-form"><h2>登录同步账号</h2><p class="muted">使用网站已有的账号。</p><label>邮箱<input id="login-email" type="email" autocomplete="username" required></label><label>密码<input id="login-password" type="password" autocomplete="current-password" required></label><p id="login-error" role="alert"></p><div class="actions"><button type="button" id="login-cancel">取消</button><button class="primary" id="login-submit">登录</button></div></form></dialog><script>import "../../../../../../../public/topics/applications/inspiration-station/theology/group-study/app.js";</script>
</body></html>
