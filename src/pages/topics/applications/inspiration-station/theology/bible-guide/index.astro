---
import BaseLayout from '../../../../../../layouts/BaseLayout.astro';
import bibleGuideData from '../../../../../../data/bible-guide-chapters.json';

const basePath = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const theologyHref = `${basePath}topics/applications/inspiration-station/theology/`;
const bookImageBase = `${basePath}images/bible-guide/`;
const pentateuchImageBase = `${basePath}images/bible-guide/pentateuch/`;
const overviewImageBase = `${basePath}images/bible-guide/overview/`;

const importedBooksBySlug = new Map(bibleGuideData.books.map((book) => [book.slug, book]));
const categoryIdByWorkbookCategory: Record<string, string> = {
  '摩西五经': 'pentateuch',
  '历史书': 'history',
  '诗歌智慧书': 'wisdom',
  '大先知书': 'prophets',
  '小先知书': 'prophets',
  '福音书': 'gospels',
  '教会历史': 'gospels',
  '保罗书信': 'epistles',
  '普通书信': 'epistles',
  '启示文学': 'epistles'
};
const categoryTitleById: Record<string, string> = {
  pentateuch: '摩西五经',
  history: '历史书',
  wisdom: '诗歌智慧书',
  prophets: '先知书',
  gospels: '福音书',
  epistles: '书信'
};
const collectionIdByWorkbookCategory: Record<string, string> = {
  '摩西五经': 'pentateuch',
  '历史书': 'history',
  '诗歌智慧书': 'wisdom',
  '大先知书': 'major-prophets',
  '小先知书': 'minor-prophets',
  '福音书': 'gospels',
  '教会历史': 'gospels',
  '保罗书信': 'pauline-epistles',
  '普通书信': 'general-epistles',
  '启示文学': 'revelation'
};
const featuredCategoryImageBase: Record<string, string> = {
  pentateuch: `${bookImageBase}pentateuch/`,
  history: `${bookImageBase}history/`,
  wisdom: `${bookImageBase}wisdom/`,
  prophets: `${bookImageBase}prophets/`,
  gospels: `${bookImageBase}gospels/`,
  epistles: `${bookImageBase}epistles/`
};
const categories = [
  {
    id: 'pentateuch',
    title: '摩西五经',
    icon: '▱',
    books: [
      { slug: 'genesis', title: '创世记', english: 'Genesis', description: '上帝的创造，人的尊严与堕落', reference: '创 1:1–2:25', image: `${pentateuchImageBase}genesis.webp` },
      { slug: 'exodus', title: '出埃及记', english: 'Exodus', description: '上帝的救赎，带领百姓出奴役进入立约', reference: '出 20:1–17', image: `${pentateuchImageBase}exodus.webp` },
      { slug: 'leviticus', title: '利未记', english: 'Leviticus', description: '上帝的圣洁，呼召子民分别为圣', reference: '利 11:44–45', image: `${pentateuchImageBase}leviticus.webp` },
      { slug: 'numbers', title: '民数记', english: 'Numbers', description: '上帝的同在，在旷野中引导与管教', reference: '民 14:18', image: `${pentateuchImageBase}numbers.webp` },
      { slug: 'deuteronomy', title: '申命记', english: 'Deuteronomy', description: '上帝的立约，呼吁人以爱与顺服回应', reference: '申 6:5', image: `${pentateuchImageBase}deuteronomy.webp` }
    ]
  },
  {
    id: 'history',
    title: '历史书',
    icon: '♔',
    books: [
      { slug: 'joshua', title: '约书亚记', english: 'Joshua', description: '上帝信守应许，带领百姓进入应许之地', reference: '书 1:6–9', image: '' },
      { slug: 'judges', title: '士师记', english: 'Judges', description: '人的反复悖逆与上帝不止息的拯救', reference: '士 2:16–19', image: '' },
      { slug: 'ruth', title: '路得记', english: 'Ruth', description: '上帝在忠诚与恩慈中成就救赎', reference: '得 1:16–17', image: '' },
      { slug: 'first-samuel', title: '撒母耳记上', english: '1 Samuel', description: '上帝鉴察人心，兴起合祂心意的王', reference: '撒上 16:7', image: '' },
      { slug: 'second-samuel', title: '撒母耳记下', english: '2 Samuel', description: '上帝坚定祂的约，也审判王的罪', reference: '撒下 7:12–16', image: '' }
    ]
  },
  {
    id: 'wisdom',
    title: '诗歌智慧书',
    icon: '♩',
    books: [
      { slug: 'job', title: '约伯记', english: 'Job', description: '上帝在苦难中显明超越人的智慧', reference: '伯 42:1–6', image: '' },
      { slug: 'psalms', title: '诗篇', english: 'Psalms', description: '上帝配得敬拜，成为百姓永远的避难所', reference: '诗 23:1–6', image: '' },
      { slug: 'proverbs', title: '箴言', english: 'Proverbs', description: '敬畏上帝是一切智慧与生活的起点', reference: '箴 1:7', image: '' },
      { slug: 'ecclesiastes', title: '传道书', english: 'Ecclesiastes', description: '上帝使短暂人生在敬畏中得着意义', reference: '传 12:13–14', image: '' },
      { slug: 'song-of-songs', title: '雅歌', english: 'Song of Songs', description: '上帝所赐的爱忠贞、美好而有力量', reference: '歌 8:6–7', image: '' }
    ]
  },
  {
    id: 'prophets',
    title: '先知书',
    icon: '♙',
    books: [
      { slug: 'isaiah', title: '以赛亚书', english: 'Isaiah', description: '圣洁的上帝审判罪，也应许救赎之仆', reference: '赛 53:4–6', image: '' },
      { slug: 'jeremiah', title: '耶利米书', english: 'Jeremiah', description: '上帝呼唤悔改，并应许写在人心的新约', reference: '耶 31:31–34', image: '' },
      { slug: 'ezekiel', title: '以西结书', english: 'Ezekiel', description: '上帝的荣耀离开、归回并更新祂的百姓', reference: '结 36:26–28', image: '' },
      { slug: 'daniel', title: '但以理书', english: 'Daniel', description: '上帝掌管列国，在异乡保守忠信见证', reference: '但 7:13–14', image: '' },
      { slug: 'hosea', title: '何西阿书', english: 'Hosea', description: '上帝以不离不弃的爱挽回失信的百姓', reference: '何 11:8–9', image: '' }
    ]
  },
  {
    id: 'gospels',
    title: '福音书',
    icon: '†',
    books: [
      { slug: 'matthew', title: '马太福音', english: 'Matthew', description: '耶稣是应许的君王，带来天国的实现', reference: '太 5:1–12', image: '' },
      { slug: 'mark', title: '马可福音', english: 'Mark', description: '耶稣是服事与舍命的上帝之子', reference: '可 10:45', image: '' },
      { slug: 'luke', title: '路加福音', english: 'Luke', description: '耶稣寻找失丧者，把救恩带给万民', reference: '路 19:10', image: '' },
      { slug: 'john', title: '约翰福音', english: 'John', description: '耶稣是道成肉身、赐人永生的上帝之子', reference: '约 20:30–31', image: '' },
      { slug: 'acts', title: '使徒行传', english: 'Acts', description: '圣灵建立教会，使福音传到地极', reference: '徒 1:8', image: '' }
    ]
  },
  {
    id: 'epistles',
    title: '书信',
    icon: '✉',
    books: [
      { slug: 'romans', title: '罗马书', english: 'Romans', description: '上帝的义借着福音临到一切相信的人', reference: '罗 1:16–17', image: '' },
      { slug: 'first-corinthians', title: '哥林多前书', english: '1 Corinthians', description: '十字架塑造圣洁、相爱与合一的教会', reference: '林前 13:1–13', image: '' },
      { slug: 'galatians', title: '加拉太书', english: 'Galatians', description: '基督释放人脱离律法主义，靠圣灵而活', reference: '加 5:1, 22–23', image: '' },
      { slug: 'ephesians', title: '以弗所书', english: 'Ephesians', description: '上帝在基督里使万有同归于一', reference: '弗 1:9–10', image: '' },
      { slug: 'revelation', title: '启示录', english: 'Revelation', description: '上帝最终更新万有，与祂的百姓永远同住', reference: '启 21:1–5', image: '' }
    ]
  }
];

const overviewCards = [
  { title: '历史书', description: '上帝在历史中成就应许与管治', target: 'history', image: `${overviewImageBase}history-books.webp` },
  { title: '诗歌智慧书', description: '上帝赐下智慧与安慰，指引人心', target: 'wisdom', image: `${overviewImageBase}poetry-wisdom.webp` },
  { title: '大先知书', description: '上帝呼召悔改，宣告审判与盼望', target: 'major-prophets', image: `${overviewImageBase}major-prophets.webp` },
  { title: '小先知书', description: '上帝在列国中发声，宣告心意', target: 'minor-prophets', image: `${overviewImageBase}minor-prophets.webp` },
  { title: '福音书与使徒行传', description: '耶稣基督的生平、教会的诞生与扩展', target: 'gospels', image: `${overviewImageBase}gospels-acts.webp` },
  { title: '保罗书信', description: '福音的真理与教会的生命实践', target: 'pauline-epistles', image: `${overviewImageBase}pauline-epistles.webp` },
  { title: '普通书信', description: '劝勉与教导，建立信徒的信仰与品格', target: 'general-epistles', image: `${overviewImageBase}general-epistles.webp` },
  { title: '启示录', description: '上帝的终极启示、盼望与新天新地', target: 'revelation', image: `${overviewImageBase}revelation.webp` }
];

categories.forEach((category) => {
  category.books = category.books.map((book) => ({
    ...book,
    description: importedBooksBySlug.get(book.slug)?.summary ?? book.description,
    image: `${featuredCategoryImageBase[category.id]}${book.slug}.webp`
  }));
});

const featuredBookReferences = new Map(
  categories.flatMap((category) => category.books.map((book) => [book.slug, book.reference]))
);

const guideBooks = bibleGuideData.books.map((book) => {
  const categoryId = categoryIdByWorkbookCategory[book.category] ?? 'epistles';
  return {
    ...book,
    categoryId,
    categoryTitle: categoryTitleById[categoryId],
    collectionId: collectionIdByWorkbookCategory[book.category] ?? categoryId,
    description: book.summary,
    reference: featuredBookReferences.get(book.slug) ?? `全书共 ${book.chapterCount} 章`,
    image: `${featuredCategoryImageBase[categoryId]}${book.slug}.webp`
  };
});

categories.forEach((category) => {
  category.books = guideBooks.filter((book) => book.categoryId === category.id);
});

const subcollections = [
  { id: 'major-prophets', parentCategoryId: 'prophets', title: '大先知书', books: guideBooks.filter((book) => book.collectionId === 'major-prophets') },
  { id: 'minor-prophets', parentCategoryId: 'prophets', title: '小先知书', books: guideBooks.filter((book) => book.collectionId === 'minor-prophets') },
  { id: 'pauline-epistles', parentCategoryId: 'epistles', title: '保罗书信', books: guideBooks.filter((book) => book.collectionId === 'pauline-epistles') },
  { id: 'general-epistles', parentCategoryId: 'epistles', title: '普通书信', books: guideBooks.filter((book) => book.collectionId === 'general-epistles') },
  { id: 'revelation', parentCategoryId: 'epistles', title: '启示录', books: guideBooks.filter((book) => book.collectionId === 'revelation') }
];
---

<BaseLayout title="圣经导读｜微读圣经" activeTheme="applications" bare>
  <div class="guide-page" data-guide-page style={`--guide-reader-image:url("${pentateuchImageBase}genesis.webp");--guide-videos-image:url("${pentateuchImageBase}exodus.webp");`}>
    <header class="guide-header">
      <a class="guide-brand" href={theologyHref} aria-label="返回微读圣经主页">
        <span class="guide-logo" aria-hidden="true">
          <svg viewBox="0 0 48 48"><path d="M9 13c6-2 11-.8 15 3v21c-4-3.8-9-4.8-15-2V13Zm30 0c-6-2-11-.8-15 3v21c4-3.8 9-4.8 15-2V13Z"/><path d="M24 11v26M19 9l5 3 5-3"/></svg>
        </span>
        <span><strong>圣经关系图谱</strong><small>BIBLE ATLAS</small></span>
      </a>

      <nav class="guide-main-nav" aria-label="圣经导读导航">
        <button class="is-active" type="button" data-jump-category="pentateuch">旧约</button>
        <button type="button" data-jump-category="gospels">新约</button>
        <a href="#guide-categories">主题索引</a>
        <button type="button" data-open-about>关于</button>
        <span class="nav-divider" aria-hidden="true"></span>
        <button class="guide-search-toggle" type="button" data-search-toggle aria-expanded="false" aria-controls="guide-search-panel" aria-label="打开书卷搜索">
          <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="10.8" cy="10.8" r="6.7"/><path d="m16 16 5 5"/></svg>
        </button>
      </nav>

      <div class="guide-search-panel" id="guide-search-panel" data-search-panel hidden>
        <label for="guide-search">搜索书卷</label>
        <div class="guide-search-field">
          <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="10.8" cy="10.8" r="6.7"/><path d="m16 16 5 5"/></svg>
          <input id="guide-search" data-guide-search type="search" placeholder="输入中文、英文书名或分类" autocomplete="off" />
          <button type="button" data-search-close aria-label="关闭搜索">×</button>
        </div>
        <div class="guide-search-results" data-search-results aria-live="polite"></div>
      </div>
    </header>

    <section class="guide-hero" aria-labelledby="guide-title">
      <div class="guide-hero-copy">
        <h1 id="guide-title">圣经每一卷与上帝的关系</h1>
        <p>用一句话看见每卷书如何启示上帝、人的回应与救赎历史。</p>
        <span class="hero-rule" aria-hidden="true"><i></i></span>
      </div>
    </section>

    <nav class="guide-tabs" id="guide-categories" aria-label="圣经书卷分类">
      {categories.map((category, index) => (
        <button type="button" data-category={category.id} class={index === 0 ? 'is-active' : ''}>
          <span aria-hidden="true">{category.icon}</span>{category.title}
        </button>
      ))}
    </nav>

    <main class="guide-content">
      <section class="guide-primary" aria-live="polite" aria-label="当前分类书卷">
        <header class="guide-collection-status">
          <span>当前书卷</span>
          <strong data-collection-title>{categories[0].title}</strong>
          <small data-collection-count>共 {categories[0].books.length} 卷</small>
        </header>
        <div class="guide-book-list" data-primary-list>
          {categories[0].books.map((book, index) => (
            <article class="guide-book-card">
              <span class="guide-book-number">{index + 1}</span>
              <img src={book.image} alt="" loading={index < 2 ? 'eager' : 'lazy'} />
              <div class="guide-book-copy">
                <h2>{book.title}</h2>
                <p>{book.description}</p>
                <small>参考经文：{book.reference}</small>
              </div>
              <button class="guide-book-detail" type="button" data-open-book={book.slug}>查看详情 <span aria-hidden="true">→</span></button>
            </article>
          ))}
        </div>
      </section>

      <aside class="guide-overview" aria-labelledby="guide-overview-title">
        <div class="guide-overview-title">
          <span aria-hidden="true"></span>
          <h2 id="guide-overview-title">更多圣经书卷概览</h2>
          <i aria-hidden="true"></i>
        </div>
        <div class="guide-overview-grid">
          {overviewCards.map((card) => (
            <button type="button" data-explore={card.target} aria-pressed="false">
              <span class="guide-overview-thumb" aria-hidden="true"><img src={card.image} alt="" decoding="async" /></span>
              <span>
                <strong>{card.title}</strong>
                <small>{card.description}</small>
                <em>探索更多 →</em>
              </span>
            </button>
          ))}
        </div>
      </aside>
    </main>

    <section class="guide-banner" id="guide-about" aria-label="圣经整体信息">
      <div class="guide-banner-cta">
        <img src={`${pentateuchImageBase}deuteronomy.webp`} alt="摩西在应许之地前教导以色列人" loading="lazy" />
        <div>
          <h2>探索圣经的整体信息与上帝的救赎计划</h2>
          <p>从创世到启示录，一段关于上帝与人同行的故事。</p>
        </div>
        <a class="guide-banner-link" href={theologyHref}>开始探索圣经 →</a>
      </div>
      <blockquote>
        <span aria-hidden="true">“</span>
        <p>圣经都是神所默示的，于教训、督责、使人归正、教导人学义，都是有益的，叫属神的人得以完全，预备行各样的善事。</p>
        <cite>— 提摩太后书 3:16–17</cite>
      </blockquote>
    </section>

    <dialog class="guide-chapter-dialog" data-chapter-dialog aria-labelledby="chapter-dialog-title">
      <div class="guide-chapter-shell">
        <header class="guide-chapter-header">
          <img data-chapter-image src={`${pentateuchImageBase}genesis.webp`} alt="" />
          <div>
            <p>BIBLE ATLAS · CHAPTER GUIDE</p>
            <h2 id="chapter-dialog-title" data-chapter-title>创世记</h2>
            <span data-chapter-english>Genesis</span>
            <small data-chapter-total>共 50 章</small>
          </div>
          <button type="button" data-close-chapters aria-label="关闭章节导读">×</button>
        </header>
        <div class="guide-chapter-intro">
          <strong data-chapter-description>上帝的创造，人的尊严与堕落</strong>
          <span>逐章一句话概览</span>
        </div>
        <div class="guide-chapter-scroll" data-chapter-scroll>
          <ol data-chapter-list></ol>
        </div>
      </div>
    </dialog>

    <dialog class="guide-about-dialog" data-about-dialog aria-labelledby="about-dialog-title">
      <button type="button" data-close-about aria-label="关闭">×</button>
      <small>BIBLE ATLAS</small>
      <h2 id="about-dialog-title">关于圣经导读</h2>
      <p>本页以圣经六大书卷分类为入口，用一句话建立每卷书与上帝救赎计划的关系。可通过分类、搜索和书卷详情继续探索。</p>
      <a href={theologyHref}>返回微读圣经主页 →</a>
    </dialog>
  </div>
</BaseLayout>

<script is:inline define:vars={{ categories, subcollections, guideBooks }}>
  // @ts-nocheck -- Astro injects the define:vars values at build time.
  const page = document.querySelector('[data-guide-page]');
  const list = page?.querySelector('[data-primary-list]');
  const tabs = [...(page?.querySelectorAll('[data-category]') || [])];
  const overviewButtons = [...(page?.querySelectorAll('[data-explore]') || [])];
  const collectionTitle = page?.querySelector('[data-collection-title]');
  const collectionCount = page?.querySelector('[data-collection-count]');
  const panel = page?.querySelector('[data-search-panel]');
  const searchInput = page?.querySelector('[data-guide-search]');
  const searchResults = page?.querySelector('[data-search-results]');
  const searchToggle = page?.querySelector('[data-search-toggle]');
  const aboutDialog = page?.querySelector('[data-about-dialog]');
  const chapterDialog = page?.querySelector('[data-chapter-dialog]');
  const chapterList = page?.querySelector('[data-chapter-list]');
  const chapterScroll = page?.querySelector('[data-chapter-scroll]');
  const allBooks = guideBooks;
  const cardTemplates = [...(list?.children || [])].map((card) => card.cloneNode(true));

  const createBookCard = (book, index) => {
    const card = cardTemplates[index % cardTemplates.length]?.cloneNode(true);
    if (!card) return null;
    card.querySelector('.guide-book-number').textContent = String(index + 1);
    const image = card.querySelector('img');
    image.src = book.image;
    image.alt = '';
    image.loading = index < 2 ? 'eager' : 'lazy';
    card.querySelector('.guide-book-copy h2').textContent = book.title;
    card.querySelector('.guide-book-copy p').textContent = book.description;
    card.querySelector('.guide-book-copy small').textContent = `参考经文：${book.reference}`;
    card.querySelector('[data-open-book]').dataset.openBook = book.slug;
    return card;
  };

  const openChapterGuide = (slug) => {
    const book = allBooks.find((item) => item.slug === slug);
    if (!book || !chapterDialog || !chapterList) return;

    page.querySelector('[data-chapter-image]').src = book.image;
    page.querySelector('[data-chapter-image]').alt = `${book.title}导读场景`;
    page.querySelector('[data-chapter-title]').textContent = book.title;
    page.querySelector('[data-chapter-english]').textContent = book.english;
    page.querySelector('[data-chapter-total]').textContent = `共 ${book.chapters.length} 章`;
    page.querySelector('[data-chapter-description]').textContent = book.summary;

    const rows = book.chapters.map((chapter) => {
      const item = document.createElement('li');
      const number = document.createElement('span');
      number.className = 'guide-chapter-number';
      number.textContent = String(chapter.number).padStart(2, '0');
      const copy = document.createElement('div');
      const heading = document.createElement('strong');
      heading.textContent = `第 ${chapter.number} 章`;
      const text = document.createElement('p');
      text.textContent = chapter.summary;
      copy.append(heading, text);
      item.append(number, copy);
      return item;
    });
    chapterList.replaceChildren(...rows);
    if (chapterScroll) chapterScroll.scrollTop = 0;
    chapterDialog.showModal();
  };

  const selectCategory = (categoryId, shouldScroll = false) => {
    const collection = subcollections.find((item) => item.id === categoryId)
      || categories.find((item) => item.id === categoryId)
      || categories[0];
    const parentCategoryId = collection.parentCategoryId || collection.id;
    tabs.forEach((tab) => tab.classList.toggle('is-active', tab.dataset.category === parentCategoryId));
    overviewButtons.forEach((button) => {
      const isActive = button.dataset.explore === collection.id;
      button.classList.toggle('is-active', isActive);
      button.setAttribute('aria-pressed', String(isActive));
    });
    if (collectionTitle) collectionTitle.textContent = collection.title;
    if (collectionCount) collectionCount.textContent = `共 ${collection.books.length} 卷`;
    const cards = collection.books.map(createBookCard).filter(Boolean);
    list?.replaceChildren(...cards);
    if (shouldScroll) document.querySelector('#guide-categories')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
  };

  const closeSearch = () => {
    if (!panel) return;
    panel.hidden = true;
    searchToggle?.setAttribute('aria-expanded', 'false');
  };

  tabs.forEach((tab) => tab.addEventListener('click', () => selectCategory(tab.dataset.category)));
  page?.querySelectorAll('[data-explore], [data-jump-category]').forEach((control) => {
    control.addEventListener('click', () => selectCategory(control.dataset.explore || control.dataset.jumpCategory, true));
  });

  searchToggle?.addEventListener('click', () => {
    if (!panel) return;
    panel.hidden = !panel.hidden;
    searchToggle.setAttribute('aria-expanded', String(!panel.hidden));
    if (!panel.hidden) window.setTimeout(() => searchInput?.focus(), 30);
  });
  page?.querySelector('[data-search-close]')?.addEventListener('click', closeSearch);
  list?.addEventListener('click', (event) => {
    const trigger = event.target.closest('[data-open-book]');
    if (trigger) openChapterGuide(trigger.dataset.openBook);
  });
  page?.querySelector('[data-close-chapters]')?.addEventListener('click', () => chapterDialog?.close());
  chapterDialog?.addEventListener('click', (event) => {
    if (event.target === chapterDialog) chapterDialog.close();
  });

  searchInput?.addEventListener('input', () => {
    const query = searchInput.value.trim().toLocaleLowerCase();
    searchResults?.replaceChildren();
    if (!query) return;
    const matches = allBooks.filter((book) => [book.title, book.english, book.categoryTitle].some((value) => value.toLocaleLowerCase().includes(query))).slice(0, 8);
    if (!matches.length) {
      const empty = document.createElement('p');
      empty.textContent = '没有找到匹配的书卷。';
      searchResults?.append(empty);
      return;
    }
    matches.forEach((book) => {
      const button = document.createElement('button');
      button.type = 'button';
      const name = document.createElement('strong');
      name.textContent = book.title;
      const meta = document.createElement('span');
      meta.textContent = `${book.english} · ${book.categoryTitle}`;
      button.append(name, meta);
      button.addEventListener('click', () => {
        selectCategory(book.categoryId);
        closeSearch();
        openChapterGuide(book.slug);
      });
      searchResults?.append(button);
    });
  });

  page?.querySelector('[data-open-about]')?.addEventListener('click', () => aboutDialog?.showModal());
  page?.querySelector('[data-close-about]')?.addEventListener('click', () => aboutDialog?.close());
  aboutDialog?.addEventListener('click', (event) => {
    if (event.target === aboutDialog) aboutDialog.close();
  });
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') closeSearch();
  });
</script>

