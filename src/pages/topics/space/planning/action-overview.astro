---
const basePath = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="按周汇总已完成事项的行动全览看板。" />
    <link rel="icon" type="image/png" href={`${basePath}favicon.png?v=20260806-white`} />
    <title>To-Do-List｜行动全览</title>
  </head>
  <body>
    <div class="action-shell" data-action-overview>
      <div class="topline">
        <p data-today>今天</p>
        <div class="sync-summary">
          <strong data-auth-status>正在检查登录状态…</strong>
          <small data-last-sync>尚未完成云端校验</small>
        </div>
      </div>

      <header class="page-header">
        <a class="brand-wrap" href={`${basePath}topics/space/planning/todo`} aria-label="返回我的待办">
          <span class="brand">To-Do-<br />List</span>
          <span class="logo-orb" aria-hidden="true"></span>
        </a>
        <div class="header-actions">
          <button class="outline-btn" type="button" data-action="sign-out" hidden>退出登录</button>
          <button class="icon-btn" type="button" data-action="focus-search" aria-label="搜索事项" title="搜索">⌕</button>
          <span class="icon-btn is-static" aria-hidden="true">☀</span>
          <span class="icon-btn is-static" aria-hidden="true">♧</span>
          <a class="primary-btn" href={`${basePath}topics/space/planning/todo`}>＋ 新建待办</a>
        </div>
      </header>

      <section class="mode-nav" aria-label="待办页面模式与分类筛选">
        <div class="mode-tabs">
          <a class="mode-tab" href={`${basePath}topics/space/planning/todo`}>周计划</a>
          <span class="mode-tab is-active" aria-current="page">▦ 行动全览</span>
          <button class="mode-tab" type="button" data-action="monthly-review" aria-disabled="true">月度复盘</button>
        </div>
        <div class="filters" data-category-filters>
          <button class="filter-chip is-active" type="button" data-action="filter-category" data-category="all">全部</button>
          <button class="filter-chip" type="button" data-action="filter-category" data-category="work">工作</button>
          <button class="filter-chip" type="button" data-action="filter-category" data-category="study">投资</button>
          <button class="filter-chip" type="button" data-action="filter-category" data-category="life">生活</button>
          <button class="filter-chip" type="button" data-action="filter-category" data-category="health">运动</button>
          <button class="filter-chip" type="button" data-action="filter-category" data-category="other">信仰</button>
          <button class="outline-btn export-btn" type="button" data-action="export-overview">⇩ 导出 Excel 数据</button>
        </div>
      </section>

      <section class="hero" aria-labelledby="overview-title">
        <div>
          <h1 id="overview-title">我的行动足迹</h1>
          <p>按周回看真正完成的事情；同日同类同名先去重，同周重复事项自动合并为“事项 × 次数”。</p>
        </div>
        <div class="controls">
          <label class="sr-only" for="overview-year">年份</label>
          <select id="overview-year" class="control" data-year></select>
          <label class="sr-only" for="overview-range">日期范围</label>
          <select id="overview-range" class="control" data-range>
            <option value="8">最近 8 周</option>
            <option value="4">最近 4 周</option>
            <option value="month">本月</option>
            <option value="quarter">本季度</option>
            <option value="year">本年</option>
            <option value="custom">自定义范围</option>
          </select>
          <span class="custom-range" data-custom-range hidden>
            <label class="sr-only" for="overview-start">开始日期</label>
            <input id="overview-start" class="control date-control" type="date" data-start />
            <span aria-hidden="true">—</span>
            <label class="sr-only" for="overview-end">结束日期</label>
            <input id="overview-end" class="control date-control" type="date" data-end />
          </span>
          <span class="control completed-control" aria-label="数据范围">只看已完成</span>
          <label class="sr-only" for="overview-search">搜索已完成事项</label>
          <input id="overview-search" class="control search-control" type="search" placeholder="搜索已完成事项…" data-search />
        </div>
      </section>

      <div class="status-banner" data-status role="status" aria-live="polite">正在读取云端已完成事项…</div>

      <section class="kpi-grid" aria-label="行动全览统计">
        <article class="kpi">
          <span class="kpi-label">完成记录</span>
          <strong class="kpi-value" data-kpi-records>0</strong>
          <small class="kpi-note">已去除同日同名重复项</small>
        </article>
        <article class="kpi">
          <span class="kpi-label">独立事项</span>
          <strong class="kpi-value" data-kpi-unique>0</strong>
          <small class="kpi-note">按分类与事项名称统计</small>
        </article>
        <article class="kpi">
          <span class="kpi-label">活跃天数</span>
          <strong class="kpi-value" data-kpi-days>0</strong>
          <small class="kpi-note">所选范围内有完成记录</small>
        </article>
        <article class="kpi">
          <span class="kpi-label">分类覆盖</span>
          <strong class="kpi-value" data-kpi-coverage>0 / 5</strong>
          <small class="kpi-note">工作 · 投资 · 生活 · 运动 · 信仰</small>
        </article>
        <article class="kpi">
          <span class="kpi-label">最活跃分类</span>
          <strong class="kpi-value kpi-value-text" data-kpi-top>—</strong>
          <small class="kpi-note" data-kpi-top-note>暂无完成记录</small>
        </article>
      </section>

      <section class="overview-grid">
        <article class="card trend-card">
          <header class="card-head">
            <div>
              <h2>每周完成趋势</h2>
              <p>柱高代表总量，颜色代表分类构成</p>
            </div>
            <span data-range-label>—</span>
          </header>
          <div class="trend" data-trend></div>
        </article>
        <article class="card category-card">
          <header class="card-head">
            <div>
              <h2>分类投入</h2>
              <p>所选范围内的完成次数</p>
            </div>
          </header>
          <div class="category-list" data-category-totals></div>
        </article>
      </section>

      <section class="summary-strip">
        <strong>本周一句</strong>
        <p data-summary>本周暂时没有已完成记录。</p>
        <button class="outline-btn copy-report" type="button" data-action="copy-report">复制周报</button>
      </section>

      <section class="matrix-card card" aria-labelledby="matrix-title">
        <header class="matrix-toolbar">
          <div>
            <h2 id="matrix-title">周 × 分类全览</h2>
            <p>每行是一周，每列是一个生活领域；点击单元格或事项查看完整记录。</p>
          </div>
          <span>默认按周倒序 · 周一至周日</span>
        </header>
        <div class="matrix-scroll">
          <div class="matrix" data-matrix></div>
        </div>
        <div class="mobile-weeks" data-mobile-weeks></div>
      </section>

      <footer>行动全览 · 数据来自个人云端待办 · 仅展示已完成且已有日期的记录</footer>

      <div class="drawer-backdrop" data-drawer-backdrop hidden></div>
      <aside class="detail-drawer" data-drawer aria-labelledby="drawer-title" aria-hidden="true">
        <header>
          <div>
            <span data-drawer-kicker>完成明细</span>
            <h2 id="drawer-title" data-drawer-title>事项详情</h2>
          </div>
          <button class="drawer-close" type="button" data-action="close-drawer" aria-label="关闭详情">×</button>
        </header>
        <div class="drawer-body" data-drawer-body></div>
      </aside>

      <div class="toast" data-toast role="status" aria-live="polite" hidden></div>
    </div>

    <script>
      import { mountActionOverview } from '../../../../scripts/action-overview';

      const root = document.querySelector<HTMLElement>('[data-action-overview]');
      if (root) mountActionOverview(root);
    </script>
  </body>
</html>

<style is:global>
  :root {
    color-scheme: dark;
    --surface-canvas: #0b0d0e;
    --surface-main: #111718;
    --surface-panel: #1c2425;
    --surface-card: #222b2d;
    --surface-item: #293436;
    --surface-raised: #323f41;
    --surface-recessed: #151c1d;
    --text-primary: #f3efe7;
    --text-secondary: #c1bbb0;
    --text-muted: #807b73;
    --border-subtle: rgba(238, 224, 199, 0.1);
    --border-gold: rgba(216, 154, 53, 0.28);
    --accent-copper: #d39458;
    --accent-copper-bright: #efb171;
    --accent-copper-deep: #925b35;
    --work: #9b8ab7;
    --study: #d77b5c;
    --life: #7ea5ae;
    --health: #a7ac56;
    --other: #c9a15a;
    --radius-panel: 14px;
    --radius-card: 10px;
    --radius-item: 7px;
    --radius-pill: 999px;
  }

  * {
    box-sizing: border-box;
  }

  .action-shell [hidden] {
    display: none !important;
  }

  html {
    min-width: 320px;
    background: var(--surface-canvas);
    scroll-behavior: smooth;
  }

  body {
    min-height: 100vh;
    margin: 0;
    overflow-x: hidden;
    background:
      radial-gradient(900px 420px at 75% 3%, rgba(169, 105, 29, 0.13), transparent 60%),
      radial-gradient(700px 520px at 12% 45%, rgba(82, 72, 49, 0.08), transparent 70%),
      repeating-linear-gradient(143deg, transparent 0 88px, rgba(255, 255, 255, 0.012) 89px 90px),
      linear-gradient(145deg, #0c0d0e, #090a0b 55%, #0b0c0d);
    color: var(--text-primary);
    font-family: "Aptos", "Segoe UI Variable Text", "Microsoft YaHei UI", "Microsoft YaHei", sans-serif;
  }

  button,
  input,
  select {
    font: inherit;
  }

  button,
  a {
    -webkit-tap-highlight-color: transparent;
  }

  button:focus-visible,
  a:focus-visible,
  input:focus-visible,
  select:focus-visible {
    outline: 2px solid var(--accent-copper-bright);
    outline-offset: 2px;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .action-shell {
    width: min(100%, 1638px);
    margin: 0 auto;
    padding: 28px 34px 56px;
  }

  .topline,
  .page-header,
  .mode-nav,
  .hero,
  .card-head,
  .summary-strip,
  .matrix-toolbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .topline {
    min-height: 34px;
    color: #d9d5ce;
    font-size: 0.78rem;
    font-weight: 700;
  }

  .topline p {
    margin: 0;
  }

  .sync-summary {
    display: grid;
    justify-items: end;
    gap: 0.18rem;
  }

  .sync-summary strong {
    font-size: 0.78rem;
  }

  .sync-summary small {
    color: #77746e;
    font-weight: 600;
  }

  .page-header {
    min-height: 76px;
  }

  .brand-wrap,
  .header-actions,
  .mode-tabs,
  .filters,
  .controls,
  .custom-range {
    display: flex;
    align-items: center;
  }

  .brand-wrap {
    gap: 1.1rem;
    color: inherit;
    text-decoration: none;
  }

  .brand {
    font-size: clamp(2.15rem, 3.4vw, 3.2rem);
    font-weight: 800;
    line-height: 0.9;
    letter-spacing: 0.01em;
  }

  .logo-orb {
    width: 34px;
    height: 34px;
    border: 1px solid rgba(232, 180, 83, 0.45);
    border-radius: 50%;
    background:
      radial-gradient(circle at 42% 42%, #d99b2f 0 25%, #75568a 26% 45%, transparent 46%),
      radial-gradient(circle at 50% 50%, #352c34 0 61%, #151718 62%);
    box-shadow: 0 0 0 6px rgba(216, 154, 53, 0.04), 0 0 24px rgba(220, 159, 61, 0.18);
  }

  .header-actions,
  .mode-tabs,
  .filters,
  .controls {
    gap: 0.58rem;
  }

  .outline-btn,
  .icon-btn,
  .primary-btn,
  .mode-tab,
  .filter-chip,
  .control {
    border: 1px solid var(--border-subtle);
    background: #181b1c;
    color: var(--text-secondary);
  }

  .outline-btn,
  .icon-btn,
  .primary-btn,
  .mode-tab,
  .filter-chip {
    min-height: 38px;
    cursor: pointer;
    text-decoration: none;
    transition: 160ms ease;
  }

  .outline-btn,
  .primary-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.58rem 1rem;
    border-color: var(--border-gold);
    border-radius: var(--radius-pill);
  }

  .outline-btn:hover,
  .mode-tab:hover,
  .filter-chip:hover {
    border-color: rgba(239, 177, 113, 0.42);
    color: #fff4df;
    transform: translateY(-1px);
  }

  .icon-btn {
    display: grid;
    width: 40px;
    min-width: 40px;
    padding: 0;
    place-items: center;
    border-color: rgba(212, 167, 79, 0.24);
    border-radius: 50%;
  }

  .icon-btn.is-static {
    cursor: default;
  }

  .primary-btn {
    border-radius: 12px;
    background: linear-gradient(180deg, #9b6427, #563512);
    color: #fff9ef;
    font-weight: 800;
    box-shadow: 0 12px 26px rgba(205, 139, 40, 0.16);
  }

  .primary-btn:hover {
    border-color: var(--accent-copper-bright);
    background: linear-gradient(180deg, #ad742e, #6b4317);
    transform: translateY(-1px);
  }

  .mode-nav {
    gap: 1rem;
    margin: 1rem 0 0.85rem;
  }

  .mode-tabs,
  .filters {
    flex-wrap: wrap;
  }

  .mode-tab {
    display: inline-flex;
    min-width: 138px;
    align-items: center;
    justify-content: center;
    padding: 0.48rem 1rem;
    border-radius: 11px;
    font-weight: 750;
  }

  .mode-tab.is-active {
    border-color: rgba(229, 168, 65, 0.54);
    background: linear-gradient(180deg, rgba(150, 94, 29, 0.66), rgba(79, 47, 12, 0.72));
    color: #fff3dc;
  }

  button.mode-tab[aria-disabled="true"] {
    cursor: not-allowed;
    opacity: 0.72;
  }

  .filter-chip {
    min-width: 98px;
    padding: 0.45rem 1rem;
    border-radius: var(--radius-pill);
    box-shadow: inset 0 -2px color-mix(in srgb, var(--filter-color, var(--accent-copper)) 42%, transparent);
    font-weight: 700;
  }

  .filter-chip[data-category="work"] { --filter-color: var(--work); }
  .filter-chip[data-category="study"] { --filter-color: var(--study); }
  .filter-chip[data-category="life"] { --filter-color: var(--life); }
  .filter-chip[data-category="health"] { --filter-color: var(--health); }
  .filter-chip[data-category="other"] { --filter-color: var(--other); }

  .filter-chip.is-active {
    border-color: rgba(229, 168, 65, 0.58);
    background: linear-gradient(180deg, #382914, #241a0d);
    color: #fff3dc;
  }

  .export-btn {
    border-radius: 11px;
  }

  .hero {
    gap: 1.5rem;
    align-items: flex-end;
    padding: 1.35rem 1.5rem;
    border: 1px solid var(--border-gold);
    border-radius: 18px;
    background: linear-gradient(180deg, rgba(29, 32, 32, 0.97), rgba(17, 20, 20, 0.97));
    box-shadow: 0 20px 55px rgba(0, 0, 0, 0.34);
  }

  .hero h1,
  .hero p,
  .card-head h2,
  .card-head p,
  .matrix-toolbar h2,
  .matrix-toolbar p,
  .summary-strip p {
    margin: 0;
  }

  .hero h1 {
    font-size: clamp(1.55rem, 2vw, 2rem);
  }

  .hero p,
  .card-head p,
  .matrix-toolbar p {
    margin-top: 0.42rem;
    color: var(--text-muted);
    font-size: 0.78rem;
  }

  .controls {
    flex-wrap: wrap;
    justify-content: flex-end;
  }

  .control {
    min-height: 38px;
    padding: 0.45rem 0.75rem;
    border-radius: 9px;
    outline: 0;
  }

  .control:focus {
    border-color: rgba(239, 177, 113, 0.44);
  }

  .search-control {
    width: 220px;
  }

  .date-control {
    width: 136px;
  }

  .custom-range {
    gap: 0.35rem;
    color: var(--text-muted);
  }

  .completed-control {
    display: inline-flex;
    align-items: center;
    color: #9d978d;
    cursor: default;
  }

  .status-banner {
    margin-top: 0.7rem;
    padding: 0.65rem 0.85rem;
    border: 1px solid rgba(201, 135, 77, 0.2);
    border-radius: 9px;
    background: rgba(135, 82, 31, 0.08);
    color: #c8b89f;
    font-size: 0.78rem;
  }

  .status-banner.is-success {
    border-color: rgba(126, 165, 174, 0.25);
    background: rgba(126, 165, 174, 0.07);
    color: #acc4c8;
  }

  .status-banner.is-error {
    border-color: rgba(215, 123, 92, 0.34);
    background: rgba(215, 123, 92, 0.08);
    color: #e6a28a;
  }

  .kpi-grid {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 0.75rem;
    margin-top: 0.85rem;
  }

  .kpi {
    position: relative;
    min-height: 104px;
    overflow: hidden;
    padding: 1rem 1.1rem;
    border: 1px solid rgba(255, 255, 255, 0.07);
    border-radius: 14px;
    background: linear-gradient(180deg, #1a1d1e, #121516);
    box-shadow: 0 10px 28px rgba(0, 0, 0, 0.22);
  }

  .kpi::after {
    content: "";
    position: absolute;
    top: -52px;
    right: -50px;
    width: 105px;
    height: 105px;
    border-radius: 50%;
    background: rgba(213, 151, 51, 0.07);
  }

  .kpi-label,
  .kpi-note {
    display: block;
    color: #8f8a82;
    font-size: 0.7rem;
    font-weight: 700;
  }

  .kpi-value {
    display: block;
    margin-top: 0.38rem;
    font-size: 1.8rem;
    letter-spacing: -0.02em;
  }

  .kpi-value-text {
    font-size: 1.45rem;
  }

  .kpi-note {
    margin-top: 0.18rem;
    color: #aaa39a;
    font-weight: 500;
  }

  .overview-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.85fr) minmax(300px, 0.85fr);
    gap: 0.85rem;
    margin-top: 0.85rem;
  }

  .card {
    border: 1px solid rgba(255, 255, 255, 0.07);
    border-radius: 15px;
    background: linear-gradient(180deg, #171a1b, #111415);
    box-shadow: 0 16px 36px rgba(0, 0, 0, 0.24);
  }

  .card-head {
    padding: 1rem 1.15rem 0;
  }

  .card-head h2,
  .matrix-toolbar h2 {
    font-size: 1rem;
  }

  .card-head > span,
  .matrix-toolbar > span {
    color: var(--text-muted);
    font-size: 0.7rem;
  }

  .trend {
    display: flex;
    height: 218px;
    align-items: flex-end;
    gap: clamp(0.45rem, 1.2vw, 1rem);
    padding: 1.35rem 1.35rem 1rem;
  }

  .week-bar-wrap {
    display: flex;
    height: 174px;
    min-width: 38px;
    flex: 1;
    flex-direction: column;
    align-items: center;
    justify-content: flex-end;
    padding: 0;
    border: 0;
    background: transparent;
    color: #aca69d;
    cursor: pointer;
  }

  .bar-total {
    margin-bottom: 0.3rem;
    color: #ded8ce;
    font-size: 0.68rem;
    font-weight: 800;
  }

  .week-bar {
    display: flex;
    width: min(46px, 72%);
    min-height: 22px;
    overflow: hidden;
    flex-direction: column-reverse;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 8px 8px 3px 3px;
    background: #202324;
    transition: 160ms ease;
  }

  .week-bar-wrap:hover .week-bar,
  .week-bar-wrap:focus-visible .week-bar {
    filter: brightness(1.13);
    transform: translateY(-4px);
  }

  .bar-segment {
    display: block;
    width: 100%;
    min-height: 1px;
  }

  .bar-label {
    margin-top: 0.42rem;
    color: #88837b;
    font-size: 0.66rem;
  }

  .cat-work { background: var(--work); }
  .cat-study { background: var(--study); }
  .cat-life { background: var(--life); }
  .cat-health { background: var(--health); }
  .cat-other { background: var(--other); }

  .category-list {
    padding: 0.65rem 1.15rem 1rem;
  }

  .category-total {
    margin: 0.75rem 0;
    transition: 160ms ease;
  }

  .category-total.is-muted {
    opacity: 0.2;
  }

  .category-total-head {
    display: flex;
    justify-content: space-between;
    color: #c9c3b9;
    font-size: 0.75rem;
  }

  .category-total-head strong {
    color: #f0ece5;
  }

  .legend-dot,
  .header-dot,
  .task-dot {
    display: inline-block;
    border-radius: 50%;
  }

  .legend-dot {
    width: 8px;
