---
import albumData from '../../../../../data/jamaica-photo-album.json';
import { sitePath } from '../../../../../data/site';

const photoWallHref = sitePath('/topics/space/travel/photo-wall');
const events = albumData.album.eventOrder.map((event) => ({
  name: event,
  count: albumData.album.countsByEvent[event],
}));
const categories = [
  { value: 'all', label: '全部', count: albumData.album.count },
  { value: 'people', label: '人物', count: albumData.album.countsByCategory.people },
  { value: 'scenery', label: '风景', count: albumData.album.countsByCategory.scenery },
];
const chapterMap = new Map();
for (const photo of albumData.photos) {
  const key = `${photo.event}\u0000${photo.chapter}`;
  if (!chapterMap.has(key)) {
    const label = photo.chapterPath.at(-1) || photo.event;
    const context = photo.chapterPath.length > 0
      ? [photo.event, ...photo.chapterPath.slice(0, -1)].join(' / ')
      : '事件根目录';
    chapterMap.set(key, { key, event: photo.event, label, context, photos: [] });
  }
  chapterMap.get(key).photos.push(photo);
}
const chapters = [...chapterMap.values()];
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#07120d" />
    <meta name="robots" content="noindex" />
    <meta name="description" content={`牙买加生活相册，共${albumData.album.count}张照片，依照事件目录编排。`} />
    <title>(2004-2005)牙买加 · 生活相册</title>
    <style>
      :root {
        color-scheme: dark;
        font-family: "Noto Sans SC", "Microsoft YaHei", system-ui, sans-serif;
        background: #07120d;
        color: #f4efe3;
      }

      * { box-sizing: border-box; }
      html { scroll-behavior: smooth; }
      body {
        min-width: 320px;
        min-height: 100svh;
        margin: 0;
        overflow-x: hidden;
        background:
          linear-gradient(33deg, transparent 48.25%, rgba(254, 209, 0, 0.075) 48.4%, rgba(254, 209, 0, 0.075) 49.05%, transparent 49.2%),
          linear-gradient(-33deg, transparent 48.25%, rgba(254, 209, 0, 0.075) 48.4%, rgba(254, 209, 0, 0.075) 49.05%, transparent 49.2%),
          radial-gradient(circle at 7% 18%, rgba(0, 155, 58, 0.18), transparent 34rem),
          radial-gradient(circle at 92% 8%, rgba(0, 155, 58, 0.1), transparent 28rem),
          linear-gradient(180deg, rgba(0, 0, 0, 0.08), rgba(0, 20, 10, 0.06)),
          #07120d;
        background-attachment: fixed;
        background-repeat: no-repeat;
      }
      button, a { font: inherit; }
      .shell { width: min(1440px, calc(100% - 52px)); margin: 0 auto; }

      .topbar {
        display: flex;
        min-height: 78px;
        align-items: center;
        justify-content: space-between;
        gap: 24px;
        border-bottom: 1px solid rgba(244, 239, 227, 0.14);
      }
      .back-link, .home-link {
        color: #f4efe3;
        font-size: 13px;
        font-weight: 800;
        text-decoration: none;
      }
      .back-link { display: inline-flex; align-items: center; gap: 10px; }
      .back-link span { color: #e8c268; font-size: 20px; }
      .home-link {
        color: rgba(244, 239, 227, 0.7);
        text-decoration: underline;
        text-underline-offset: 5px;
      }

      .hero {
        display: grid;
        grid-template-columns: minmax(0, 1fr) auto;
        gap: 48px;
        align-items: end;
        padding: clamp(64px, 9vw, 128px) 0 54px;
      }
      .eyebrow {
        margin: 0 0 18px;
        color: #e8c268;
        font-size: 12px;
        font-weight: 900;
        letter-spacing: 0.22em;
      }
      h1 {
        margin: 0;
        font-family: Georgia, "Noto Serif SC", serif;
        font-size: clamp(42px, 7vw, 108px);
        font-weight: 500;
        letter-spacing: -0.06em;
        line-height: 0.92;
        white-space: nowrap;
      }
      .hero-meta {
        display: grid;
        min-width: 250px;
        grid-template-columns: 1fr 1fr;
        gap: 18px;
        padding-bottom: 8px;
      }
      .stat { padding-top: 14px; border-top: 1px solid rgba(244, 239, 227, 0.24); }
      .stat strong, .stat span { display: block; }
      .stat strong { font-family: Georgia, serif; font-size: 28px; font-weight: 500; }
      .stat span {
        margin-top: 5px;
        color: rgba(244, 239, 227, 0.56);
        font-size: 11px;
        letter-spacing: 0.1em;
      }
      .intro {
        max-width: 720px;
        margin: -22px 0 48px;
        color: rgba(244, 239, 227, 0.58);
        font-family: Georgia, "Noto Serif SC", serif;
        font-size: clamp(16px, 1.6vw, 20px);
        line-height: 1.8;
      }

      .filter-panel {
        position: sticky;
        z-index: 8;
        top: 8px;
        display: grid;
        grid-template-columns: minmax(0, 1fr) auto;
        gap: 14px 24px;
        margin-bottom: 54px;
        padding: 16px 18px;
        border: 1px solid rgba(244, 239, 227, 0.12);
        border-radius: 18px;
        background: rgba(16, 24, 21, 0.89);
        box-shadow: 0 14px 44px rgba(0, 0, 0, 0.26);
        backdrop-filter: blur(18px);
      }
      .filter-stack { display: grid; min-width: 0; gap: 12px; }
      .filter-group { display: grid; grid-template-columns: 62px minmax(0, 1fr); align-items: center; gap: 12px; }
      .filter-label {
        color: rgba(244, 239, 227, 0.38);
        font-size: 10px;
        font-weight: 900;
        letter-spacing: 0.14em;
      }
      .filters {
        display: flex;
        min-width: 0;
        flex-wrap: wrap;
        gap: 7px;
      }
      .filter-button {
        flex: 0 0 auto;
        min-height: 36px;
        padding: 0 14px;
        border: 1px solid rgba(244, 239, 227, 0.15);
        border-radius: 999px;
        background: transparent;
        color: rgba(244, 239, 227, 0.7);
        cursor: pointer;
        font-size: 12px;
        font-weight: 800;
        transition: border-color 160ms ease, background 160ms ease, color 160ms ease;
      }
      .filter-button:hover { border-color: rgba(232, 194, 104, 0.62); color: #f4efe3; }
      .filter-button[aria-pressed="true"] { border-color: #e8c268; background: #e8c268; color: #17201c; }
      .visible-count { align-self: center; color: rgba(244, 239, 227, 0.53); font-size: 12px; white-space: nowrap; }

      .chapters { padding-bottom: 42px; }
      .chapter-section { margin-bottom: clamp(64px, 8vw, 110px); scroll-margin-top: 150px; }
      .chapter-section[hidden] { display: none; }
      .chapter-heading {
        display: grid;
        grid-template-columns: minmax(0, 1fr) auto;
        gap: 20px;
        align-items: end;
        margin-bottom: 24px;
        padding-bottom: 17px;
        border-bottom: 1px solid rgba(244, 239, 227, 0.14);
      }
      .chapter-context {
        margin: 0 0 7px;
        overflow-wrap: anywhere;
        color: #e8c268;
        font-size: 10px;
        font-weight: 900;
        letter-spacing: 0.13em;
        text-transform: uppercase;
      }
      .chapter-heading h2 {
        margin: 0;
        font-family: Georgia, "Noto Serif SC", serif;
        font-size: clamp(28px, 4vw, 48px);
        font-weight: 500;
        line-height: 1.08;
      }
      .chapter-count { color: rgba(244, 239, 227, 0.45); font-size: 12px; white-space: nowrap; }
      .gallery { columns: 4; column-gap: 16px; }
      .photo-card {
        display: block;
        width: 100%;
        margin: 0 0 16px;
        padding: 0;
        break-inside: avoid;
        overflow: hidden;
        border: 0;
        border-radius: 12px;
        background: #1a2521;
        color: inherit;
        cursor: zoom-in;
        content-visibility: auto;
        contain-intrinsic-size: 320px 240px;
      }
      .photo-card[hidden] { display: none; }
      .photo-card img { display: block; width: 100%; height: auto; transition: transform 420ms ease, filter 420ms ease; }
      .photo-card:hover img { filter: brightness(1.06); transform: scale(1.015); }
      .photo-card:focus-visible,
      .filter-button:focus-visible,
      .back-link:focus-visible,
      .home-link:focus-visible,
      .lightbox-control:focus-visible { outline: 3px solid #e8c268; outline-offset: 4px; }

      dialog {
        width: 100vw;
        max-width: none;
        height: 100dvh;
        max-height: none;
        margin: 0;
        padding: 0;
        border: 0;
        background: rgba(7, 10, 9, 0.97);
        color: #fff;
      }
      dialog::backdrop { background: rgba(7, 10, 9, 0.98); }
      dialog[open] { display: grid; grid-template-rows: 1fr auto; }
      .lightbox-stage { position: relative; display: grid; min-height: 0; place-items: center; padding: 62px 86px 24px; }
      .lightbox-stage img {
        width: auto;
        max-width: 100%;
        height: auto;
        max-height: calc(100dvh - 150px);
        object-fit: contain;
        border-radius: 8px;
        box-shadow: 0 28px 90px rgba(0, 0, 0, 0.45);
      }
      .lightbox-control {
        position: absolute;
        display: grid;
        width: 48px;
        height: 48px;
        place-items: center;
        border: 1px solid rgba(255, 255, 255, 0.24);
        border-radius: 50%;
        background: rgba(0, 0, 0, 0.34);
        color: #fff;
        cursor: pointer;
        font-size: 24px;
      }
      .lightbox-close { top: 18px; right: 20px; }
      .lightbox-previous, .lightbox-next { top: 50%; transform: translateY(-50%); }
      .lightbox-previous { left: 20px; }
      .lightbox-next { right: 20px; }
      .lightbox-caption {
        display: flex;
        min-width: 0;
        justify-content: center;
        gap: 18px;
        padding: 10px 20px 24px;
        color: rgba(255, 255, 255, 0.68);
        font-size: 12px;
      }
      #lightbox-chapter { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
      #lightbox-file { color: rgba(255, 255, 255, 0.42); white-space: nowrap; }
      footer {
        display: flex;
        justify-content: space-between;
        gap: 20px;
        padding: 34px 0 46px;
        border-top: 1px solid rgba(244, 239, 227, 0.12);
        color: rgba(244, 239, 227, 0.48);
        font-size: 12px;
      }

      @media (max-width: 1050px) { .gallery { columns: 3; } }
      @media (max-width: 760px) {
        .shell { width: min(100% - 24px, 1440px); }
        .topbar { min-height: 66px; }
        .hero { grid-template-columns: 1fr; gap: 36px; padding: 58px 0 38px; }
        h1 { font-size: clamp(31px, 10.6vw, 52px); }
        .hero-meta { min-width: 0; }
        .intro { margin: -12px 0 34px; }
        .filter-panel { grid-template-columns: 1fr; gap: 12px; margin-bottom: 42px; padding: 13px 12px; }
        .filter-group { grid-template-columns: 1fr; gap: 6px; }
        .filters { flex-wrap: nowrap; overflow-x: auto; padding: 2px 1px 5px; scrollbar-width: none; }
        .filters::-webkit-scrollbar { display: none; }
        .visible-count { padding-left: 2px; }
        .chapter-heading { align-items: start; }
        .chapter-section { margin-bottom: 62px; }
        .gallery { columns: 2; column-gap: 10px; }
        .photo-card { margin-bottom: 10px; border-radius: 8px; }
        .lightbox-stage { padding: 58px 10px 88px; }
        .lightbox-stage img { max-height: calc(100dvh - 180px); }
        .lightbox-previous, .lightbox-next { top: auto; bottom: 18px; transform: none; }
        .lightbox-previous { left: calc(50% - 58px); }
        .lightbox-next { right: calc(50% - 58px); }
        .lightbox-caption {
          position: absolute;
          bottom: 77px;
          display: grid;
          width: 100%;
          gap: 3px;
          padding: 0 14px;
          text-align: center;
        }
        footer { flex-direction: column; padding-bottom: 30px; }
      }
      @media (prefers-reduced-motion: reduce) {
        html { scroll-behavior: auto; }
        .photo-card img, .filter-button { transition: none; }
      }
    </style>
  </head>
  <body>
    <div class="shell">
      <nav class="topbar" aria-label="相册导航">
        <a class="back-link" href={photoWallHref}><span aria-hidden="true">←</span> 返回照片墙</a>
        <a class="home-link" href={sitePath('/')}>J先生个人空间</a>
      </nav>

      <main>
        <header class="hero">
          <div>
            <p class="eyebrow">{albumData.album.eyebrow}</p>
            <h1>(2004-2005)牙买加</h1>
          </div>
          <div class="hero-meta" aria-label="相册信息">
            <div class="stat"><strong>{albumData.album.count}</strong><span>PHOTOS</span></div>
            <div class="stat"><strong>{albumData.album.eventOrder.length}</strong><span>EVENTS</span></div>
          </div>
        </header>
        <p class="intro">{albumData.album.description}</p>

        <div class="filter-panel">
          <div class="filter-stack">
            <div class="filter-group">
              <span class="filter-label">事件</span>
              <div class="filters" aria-label="按事件筛选">
                <button class="filter-button" type="button" data-filter-group="event" data-filter-value="all" aria-pressed="true">全部 · {albumData.album.count}</button>
                {events.map((event) => (
                  <button class="filter-button" type="button" data-filter-group="event" data-filter-value={event.name} aria-pressed="false">{event.name} · {event.count}</button>
                ))}
              </div>
            </div>
            <div class="filter-group">
              <span class="filter-label">属性</span>
              <div class="filters" aria-label="按照片属性筛选">
                {categories.map((category) => (
                  <button class="filter-button" type="button" data-filter-group="category" data-filter-value={category.value} aria-pressed={category.value === 'all' ? 'true' : 'false'}>{category.label} · {category.count}</button>
                ))}
              </div>
            </div>
          </div>
          <span class="visible-count" aria-live="polite">显示 {albumData.album.count} 张</span>
        </div>

        <div class="chapters" aria-label="牙买加生活照片">
          {chapters.map((chapter) => (
            <section class="chapter-section" data-event={chapter.event}>
              <header class="chapter-heading">
                <div>
                  <p class="chapter-context">{chapter.context}</p>
                  <h2>{chapter.label}</h2>
                </div>
                <span class="chapter-count" data-total={chapter.photos.length}>{chapter.photos.length} 张</span>
              </header>
              <div class="gallery">
                {chapter.photos.map((photo, index) => {
                  const chapterTitle = [photo.event, ...photo.chapterPath].join(' / ');
                  const alt = `${chapterTitle}，${photo.fileName}`;
                  return (
                    <button
                      class="photo-card"
                      type="button"
                      data-event={photo.event}
                      data-category={photo.category}
                      data-src={sitePath(photo.src)}
                      data-chapter={chapterTitle}
                      data-file={photo.fileName}
                      data-alt={alt}
                      aria-label={`查看${alt}`}
                    >
                      <img
                        src={sitePath(photo.src)}
                        alt={alt}
                        width={photo.width}
                        height={photo.height}
                        loading={index < 4 && chapter.event === albumData.album.eventOrder[0] ? 'eager' : 'lazy'}
                        decoding="async"
                      />
                    </button>
                  );
                })}
              </div>
            </section>
          ))}
        </div>
      </main>

      <footer>
        <span>牙买加 · 按生活照片目录编排</span>
        <span>{albumData.album.count} 张照片 · {albumData.album.chapterCount} 个目录章节</span>
      </footer>
    </div>

    <dialog id="lightbox" aria-label="照片预览">
      <div class="lightbox-stage">
        <img id="lightbox-image" src="" alt="" />
        <button class="lightbox-control lightbox-close" type="button" aria-label="关闭预览">×</button>
        <button class="lightbox-control lightbox-previous" type="button" aria-label="上一张">‹</button>
        <button class="lightbox-control lightbox-next" type="button" aria-label="下一张">›</button>
      </div>
      <div class="lightbox-caption">
        <span id="lightbox-chapter"></span>
        <span id="lightbox-file"></span>
        <span id="lightbox-position"></span>
      </div>
    </dialog>

    <script>
      const cards = Array.from(document.querySelectorAll<HTMLButtonElement>('.photo-card'));
      const chapterSections = Array.from(document.querySelectorAll<HTMLElement>('.chapter-section'));
      const filterButtons = Array.from(document.querySelectorAll<HTMLButtonElement>('.filter-button'));
      const visibleCount = document.querySelector<HTMLElement>('.visible-count');
      const dialog = document.querySelector<HTMLDialogElement>('#lightbox');
      const lightboxImage = document.querySelector<HTMLImageElement>('#lightbox-image');
      const lightboxChapter = document.querySelector<HTMLElement>('#lightbox-chapter');
      const lightboxFile = document.querySelector<HTMLElement>('#lightbox-file');
      const lightboxPosition = document.querySelector<HTMLElement>('#lightbox-position');
      const closeButton = document.querySelector<HTMLButtonElement>('.lightbox-close');
      const previousButton = document.querySelector<HTMLButtonElement>('.lightbox-previous');
      const nextButton = document.querySelector<HTMLButtonElement>('.lightbox-next');

      const activeFilters = { event: 'all', category: 'all' };
      let visibleCards = [...cards];
      let currentIndex = 0;

      const updateLightbox = () => {
        const card = visibleCards[currentIndex];
        if (!card || !lightboxImage || !lightboxChapter || !lightboxFile || !lightboxPosition) return;
        lightboxImage.src = card.dataset.src || '';
        lightboxImage.alt = card.dataset.alt || '牙买加生活照片';
        lightboxChapter.textContent = card.dataset.chapter || '';
        lightboxFile.textContent = card.dataset.file || '';
        lightboxPosition.textContent = `${currentIndex + 1} / ${visibleCards.length}`;
      };

      const applyFilters = () => {
        cards.forEach((card) => {
          const eventMatches = activeFilters.event === 'all' || card.dataset.event === activeFilters.event;
          const categoryMatches = activeFilters.category === 'all' || card.dataset.category === activeFilters.category;
          card.hidden = !(eventMatches && categoryMatches);
        });
        chapterSections.forEach((section) => {
          const sectionCards = Array.from(section.querySelectorAll<HTMLButtonElement>('.photo-card'));
          const sectionVisibleCount = sectionCards.filter((card) => !card.hidden).length;
          section.hidden = sectionVisibleCount === 0;
          const count = section.querySelector<HTMLElement>('.chapter-count');
          if (count) count.textContent = `${sectionVisibleCount} 张`;
        });
        visibleCards = cards.filter((card) => !card.hidden);
        if (visibleCount) visibleCount.textContent = `显示 ${visibleCards.length} 张`;
      };

      const openLightbox = (card: HTMLButtonElement) => {
        if (!dialog) return;
        visibleCards = cards.filter((item) => !item.hidden);
        currentIndex = Math.max(0, visibleCards.indexOf(card));
        updateLightbox();
        dialog.showModal();
      };
      const moveLightbox = (direction: number) => {
        if (visibleCards.length === 0) return;
        currentIndex = (currentIndex + direction + visibleCards.length) % visibleCards.length;
        updateLightbox();
      };

      cards.forEach((card) => card.addEventListener('click', () => openLightbox(card)));
      filterButtons.forEach((button) => {
        button.addEventListener('click', () => {
          const group = button.dataset.filterGroup as 'event' | 'category';
          if (!group) return;
          activeFilters[group] = button.dataset.filterValue || 'all';
          filterButtons
            .filter((item) => item.dataset.filterGroup === group)
            .forEach((item) => item.setAttribute('aria-pressed', String(item === button)));
          applyFilters();
        });
      });
      closeButton?.addEventListener('click', () => dialog?.close());
      previousButton?.addEventListener('click', () => moveLightbox(-1));
      nextButton?.addEventListener('click', () => moveLightbox(1));
      dialog?.addEventListener('click', (event) => { if (event.target === dialog) dialog.close(); });
      dialog?.addEventListener('keydown', (event) => {
        if (event.key === 'ArrowLeft') moveLightbox(-1);
        if (event.key === 'ArrowRight') moveLightbox(1);
      });
    </script>
  </body>
</html>
