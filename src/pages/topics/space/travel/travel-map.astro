---
import coffeeAlbumData from '../../../../data/coffee-latte-art-album.json';
import jamaicaAlbumData from '../../../../data/jamaica-photo-album.json';
import japanAlbumData from '../../../../data/japan-kanto-2015-album.json';
import sanyaAlbumData from '../../../../data/sanya-2016-album.json';
import { sitePath } from '../../../../data/site';

const locations = [
  {
    id: 'shanghai',
    name: '上海',
    region: '中国 · 上海',
    count: coffeeAlbumData.album.count,
    latitude: 31.2304,
    longitude: 121.4737,
    href: sitePath('/topics/space/travel/photo-wall/coffee-latte-art'),
    cover: coffeeAlbumData.album.cover,
  },
  {
    id: 'sanya',
    name: '2016 海南三亚',
    region: '中国 · 海南',
    count: sanyaAlbumData.album.count,
    latitude: 18.2528,
    longitude: 109.5119,
    href: sitePath('/topics/space/travel/photo-wall/sanya-2016'),
    cover: sanyaAlbumData.album.cover,
  },
  {
    id: 'jamaica',
    name: '(2004-2005)牙买加',
    region: '加勒比海 · 牙买加',
    count: jamaicaAlbumData.album.count,
    latitude: 18.1096,
    longitude: -77.2975,
    href: sitePath('/topics/space/travel/photo-wall/jamaica'),
    cover: jamaicaAlbumData.album.cover,
  },
  {
    id: 'japan-kanto',
    name: '2015年日本（关东）',
    region: '日本 · 关东',
    count: japanAlbumData.album.count,
    latitude: 35.6762,
    longitude: 139.6503,
    href: sitePath('/topics/space/travel/photo-wall/japan-kanto-2015'),
    cover: japanAlbumData.album.cover,
  },
];

const photoTotal = locations.reduce((sum, location) => sum + location.count, 0);
const mapPayload = JSON.stringify({
  locations,
  worldUrl: sitePath('/data/maps/ne-110m-countries.geojson'),
});
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#020808" />
    <meta name="description" content="J先生的旅行影像地图，以平面世界地图与3D地球浏览相册。" />
    <link rel="icon" href={sitePath('/favicon.png')} />
    <title>旅行影像地图 · J先生的个人空间</title>
    <style>
      :root {
        color-scheme: dark;
        font-family: "Noto Sans SC", "Microsoft YaHei", system-ui, sans-serif;
        color: #f4eadf;
        background: #020808;
        --ink: #020808;
        --panel: rgba(5, 18, 18, 0.82);
        --line: rgba(200, 179, 160, 0.28);
        --paper: #f4eadf;
        --sand: #c8b3a0;
        --teal: #2a6e6f;
        --aqua: #6fa7a8;
        --clay: #8b5f43;
      }

      * { box-sizing: border-box; }

      html,
      body {
        width: 100%;
        min-width: 320px;
        height: 100%;
        margin: 0;
        overflow: hidden;
        background: var(--ink);
      }

      button,
      a { font: inherit; }

      button { color: inherit; }

      .map-page {
        position: relative;
        isolation: isolate;
        width: 100%;
        height: 100svh;
        overflow: hidden;
        background:
          radial-gradient(circle at 67% 45%, rgba(42, 110, 111, 0.13), transparent 38%),
          radial-gradient(circle at 22% 22%, rgba(139, 95, 67, 0.09), transparent 30%),
          #020808;
      }

      .map-canvas,
      .marker-layer {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
      }

      .map-canvas {
        z-index: 1;
        display: block;
        cursor: grab;
        touch-action: none;
      }

      .map-canvas.is-dragging { cursor: grabbing; }

      .marker-layer {
        z-index: 3;
        overflow: hidden;
        pointer-events: none;
      }

      .map-marker {
        position: absolute;
        display: grid;
        width: 58px;
        height: 58px;
        place-items: center;
        border: 1px solid rgba(244, 234, 223, 0.56);
        border-radius: 50%;
        color: #fff;
        background: rgba(42, 110, 111, 0.94);
        box-shadow: 0 0 0 6px rgba(42, 110, 111, 0.16), 0 14px 34px rgba(0, 0, 0, 0.35);
        text-decoration: none;
        transform: translate(-50%, -50%);
        transition: opacity 180ms ease, transform 180ms ease, background 180ms ease;
        pointer-events: auto;
      }

      .map-marker:hover,
      .map-marker:focus-visible {
        z-index: 5;
        outline: none;
        background: rgba(139, 95, 67, 0.98);
        transform: translate(-50%, -50%) scale(1.08);
      }

      .marker-count {
        font-family: Georgia, "Times New Roman", serif;
        font-size: 0.94rem;
        font-weight: 700;
        letter-spacing: -0.03em;
      }

      .marker-card {
        position: absolute;
        left: 50%;
        bottom: calc(100% + 14px);
        display: grid;
        width: 216px;
        grid-template-columns: 64px 1fr;
        gap: 12px;
        padding: 9px;
        border: 1px solid rgba(200, 179, 160, 0.4);
        border-radius: 16px;
        opacity: 0;
        background: rgba(4, 14, 14, 0.94);
        box-shadow: 0 18px 44px rgba(0, 0, 0, 0.48);
        transform: translate(-50%, 8px);
        transition: opacity 160ms ease, transform 160ms ease;
        pointer-events: none;
      }

      .map-marker:hover .marker-card,
      .map-marker:focus-visible .marker-card {
        opacity: 1;
        transform: translate(-50%, 0);
      }

      .marker-card img {
        width: 64px;
        height: 64px;
        border-radius: 11px;
        object-fit: cover;
      }

      .marker-card-copy {
        display: flex;
        min-width: 0;
        flex-direction: column;
        justify-content: center;
      }

      .marker-card strong {
        overflow: hidden;
        font-family: Georgia, "Noto Serif SC", serif;
        font-size: 0.92rem;
        text-overflow: ellipsis;
        white-space: nowrap;
      }

      .marker-card span {
        margin-top: 4px;
        color: var(--sand);
        font-size: 0.66rem;
        letter-spacing: 0.08em;
      }

      .topbar {
        position: absolute;
        z-index: 8;
        top: 0;
        left: 0;
        display: flex;
        width: 100%;
        align-items: center;
        justify-content: space-between;
        padding: 24px 30px;
        pointer-events: none;
      }

      .brand,
      .back-link {
        pointer-events: auto;
      }

      .brand {
        display: flex;
        align-items: center;
        gap: 11px;
        color: var(--paper);
        font-size: 0.72rem;
        font-weight: 800;
        letter-spacing: 0.13em;
      }

      .brand-dot {
        width: 10px;
        height: 10px;
        border: 1px solid var(--sand);
        border-radius: 50%;
      }

      .back-link {
        color: rgba(244, 234, 223, 0.72);
        font-size: 0.7rem;
        font-weight: 700;
        letter-spacing: 0.12em;
        text-decoration: none;
        transition: color 160ms ease;
      }

      .back-link:hover { color: var(--paper); }

      .mode-switch {
        position: absolute;
        z-index: 9;
        top: 21px;
        left: 50%;
        display: flex;
        gap: 4px;
        padding: 4px;
        border: 1px solid rgba(200, 179, 160, 0.24);
        border-radius: 999px;
        background: rgba(3, 13, 13, 0.76);
        backdrop-filter: blur(14px);
        transform: translateX(-50%);
      }

      .mode-button {
        min-width: 96px;
        padding: 9px 15px;
        border: 0;
        border-radius: 999px;
        color: rgba(244, 234, 223, 0.52);
        background: transparent;
        font-size: 0.72rem;
        font-weight: 800;
        letter-spacing: 0.08em;
        cursor: pointer;
      }

      .mode-button[aria-selected="true"] {
        color: #081212;
        background: var(--paper);
      }

      .map-controls {
        position: absolute;
        z-index: 9;
        top: 88px;
        left: 24px;
        display: grid;
        gap: 10px;
      }

      .control-group {
        display: grid;
        overflow: hidden;
        border: 1px solid rgba(200, 179, 160, 0.3);
        border-radius: 14px;
        background: rgba(3, 13, 13, 0.82);
        backdrop-filter: blur(12px);
      }

      .map-control {
        display: grid;
        width: 44px;
        height: 44px;
        place-items: center;
        border: 0;
        color: var(--paper);
        background: transparent;
        font-size: 1.35rem;
        cursor: pointer;
      }

      .map-control + .map-control { border-top: 1px solid rgba(200, 179, 160, 0.2); }
      .map-control:hover { background: rgba(111, 167, 168, 0.18); }
      .map-control svg { width: 19px; height: 19px; fill: none; stroke: currentColor; stroke-width: 1.8; }

      .map-heading {
        position: absolute;
        z-index: 7;
        top: 50%;
        left: 7vw;
        width: min(350px, 34vw);
        transform: translateY(-50%);
        pointer-events: none;
      }

      .map-heading p {
        margin: 0 0 14px;
        color: var(--aqua);
        font-size: 0.68rem;
        font-weight: 800;
        letter-spacing: 0.24em;
      }

      .map-heading h1 {
        margin: 0;
        font-family: Georgia, "Noto Serif SC", "Songti SC", serif;
        font-size: clamp(2.35rem, 5vw, 5.4rem);
        font-weight: 500;
        line-height: 0.98;
        letter-spacing: -0.045em;
      }

      .map-heading span {
        display: block;
        max-width: 270px;
        margin-top: 20px;
        color: rgba(244, 234, 223, 0.58);
        font-family: Georgia, "Noto Serif SC", serif;
        font-size: 0.88rem;
        line-height: 1.75;
      }

      .map-page[data-view-mode="flat"] .map-heading {
        opacity: 0;
        visibility: hidden;
      }

      .map-stats {
        position: absolute;
        z-index: 8;
        bottom: 25px;
        left: 30px;
        display: flex;
        gap: 34px;
        pointer-events: none;
      }

      .stat strong {
        display: block;
        font-family: Georgia, "Times New Roman", serif;
        font-size: 1.5rem;
        font-weight: 500;
      }

      .stat span {
        display: block;
        margin-top: 3px;
        color: rgba(244, 234, 223, 0.5);
        font-size: 0.58rem;
        font-weight: 800;
        letter-spacing: 0.17em;
      }

      .map-status {
        position: absolute;
        z-index: 8;
        right: 30px;
        bottom: 28px;
        color: rgba(244, 234, 223, 0.5);
        font-size: 0.58rem;
        font-weight: 700;
        letter-spacing: 0.15em;
        pointer-events: none;
      }

      .corner {
        position: absolute;
        z-index: 7;
        width: 44px;
        height: 44px;
        border-color: rgba(200, 179, 160, 0.38);
        pointer-events: none;
      }

      .corner--tl { top: 14px; left: 14px; border-top: 1px solid; border-left: 1px solid; }
      .corner--tr { top: 14px; right: 14px; border-top: 1px solid; border-right: 1px solid; }
      .corner--bl { bottom: 14px; left: 14px; border-bottom: 1px solid; border-left: 1px solid; }
      .corner--br { right: 14px; bottom: 14px; border-right: 1px solid; border-bottom: 1px solid; }

      .loading-note {
        position: absolute;
        z-index: 10;
        right: 50%;
        bottom: 50%;
        color: rgba(244, 234, 223, 0.64);
        font-size: 0.66rem;
        letter-spacing: 0.16em;
        transform: translate(50%, 50%);
        transition: opacity 220ms ease;
        pointer-events: none;
      }

      .loading-note.is-hidden { opacity: 0; }

      @media (max-width: 820px) {
        .topbar { padding: 18px 20px; }
        .brand { font-size: 0.61rem; }
        .back-link { font-size: 0.59rem; }

        .mode-switch {
          top: auto;
          bottom: 22px;
        }

        .mode-button {
          min-width: 88px;
          padding: 9px 12px;
          font-size: 0.66rem;
        }

        .map-controls {
          top: 78px;
          left: 14px;
        }

        .map-control { width: 40px; height: 40px; }

        .map-heading {
          top: 95px;
          left: 70px;
          width: calc(100% - 92px);
          transform: none;
        }

        .map-heading p { margin-bottom: 7px; font-size: 0.54rem; }
        .map-heading h1 { font-size: clamp(2rem, 10vw, 3rem); }
        .map-heading span { display: none; }
        .map-stats { bottom: 78px; left: 20px; gap: 24px; }
        .stat strong { font-size: 1.18rem; }
        .map-status { right: 20px; bottom: 82px; }

        .map-marker {
          width: 50px;
          height: 50px;
        }

        .marker-count { font-size: 0.82rem; }
        .marker-card { width: 190px; grid-template-columns: 54px 1fr; }
        .marker-card img { width: 54px; height: 54px; }
      }

      @media (prefers-reduced-motion: reduce) {
        *, *::before, *::after {
          scroll-behavior: auto !important;
          transition-duration: 0.01ms !important;
        }
      }
    </style>
  </head>
  <body>
    <main class="map-page" data-map-page>
      <canvas class="map-canvas" data-map-canvas aria-label="可拖动和缩放的旅行地图"></canvas>
      <div class="marker-layer" data-marker-layer>
        {locations.map((location) => (
          <a
            class="map-marker"
            data-marker={location.id}
            href={location.href}
            aria-label={`${location.name}，${location.count}张照片，打开相册`}
          >
            <span class="marker-count">{location.count.toLocaleString('en-US')}</span>
            <span class="marker-card" aria-hidden="true">
              <img src={sitePath(location.cover)} alt="" loading="lazy" />
              <span class="marker-card-copy">
                <strong>{location.name}</strong>
                <span>{location.region} · {location.count} PHOTOS</span>
              </span>
            </span>
          </a>
        ))}
      </div>

      <header class="topbar">
        <div class="brand"><span class="brand-dot"></span><span>J先生 · 影像地图</span></div>
        <a class="back-link" href={sitePath('/topics/space/travel/photo-wall/')}>返回相册墙</a>
      </header>

      <div class="mode-switch" role="tablist" aria-label="地图显示模式">
        <button class="mode-button" type="button" role="tab" data-mode="flat" aria-selected="false">平面地图</button>
        <button class="mode-button" type="button" role="tab" data-mode="globe" aria-selected="true">3D 地球</button>
      </div>

      <div class="map-controls" aria-label="地图控制">
        <div class="control-group">
          <button class="map-control" type="button" data-action="zoom-in" aria-label="放大">＋</button>
          <button class="map-control" type="button" data-action="zoom-out" aria-label="缩小">−</button>
        </div>
        <div class="control-group">
          <button class="map-control" type="button" data-action="home" aria-label="重置地图位置">
            <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="7"></circle><path d="M12 2v4M12 18v4M2 12h4M18 12h4"></path><circle cx="12" cy="12" r="2"></circle></svg>
          </button>
          <button class="map-control" type="button" data-action="toggle" aria-label="切换平面地图和3D地球">
            <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9"></circle><path d="M3 12h18M12 3a15 15 0 0 1 0 18M12 3a15 15 0 0 0 0 18"></path></svg>
          </button>
        </div>
      </div>

      <section class="map-heading" aria-labelledby="map-title">
        <p>TRAVEL COORDINATES · 04</p>
        <h1 id="map-title">把旅程<br />放在地图上</h1>
        <span>拖动地图或地球探索拍摄地点，点击坐标即可进入对应相册。</span>
      </section>

      <div class="map-stats" aria-label="影像地图统计">
        <div class="stat"><strong>{locations.length}</strong><span>LOCATIONS</span></div>
        <div class="stat"><strong>{photoTotal.toLocaleString('en-US')}</strong><span>PHOTOS</span></div>
      </div>
      <div class="map-status" data-map-status>3D GLOBE · DRAG TO ROTATE</div>
      <div class="loading-note" data-loading-note>正在装载世界边界…</div>
      <span class="corner corner--tl"></span><span class="corner corner--tr"></span>
      <span class="corner corner--bl"></span><span class="corner corner--br"></span>
    </main>

    <script id="travel-map-data" type="application/json" is:inline set:html={mapPayload}></script>
    <script>
      // @ts-nocheck
      const payloadElement = document.querySelector('#travel-map-data');
      const payload = JSON.parse(payloadElement?.textContent || '{}');
      const canvas = document.querySelector('[data-map-canvas]');
      const page = document.querySelector('[data-map-page]');
      const status = document.querySelector('[data-map-status]');
      const loadingNote = document.querySelector('[data-loading-note]');
      const modeButtons = [...document.querySelectorAll('[data-mode]')];
      const markerElements = new Map(
        [...document.querySelectorAll('[data-marker]')].map((element) => [element.dataset.marker, element]),
      );
      const context = canvas?.getContext('2d');

      const state = {
        mode: 'globe',
        geometry: [],
        width: 0,
        height: 0,
        pixelRatio: 1,
        dragging: false,
        pointerId: null,
        previousX: 0,
        previousY: 0,
        moved: false,
        flat: { zoom: 1.05, longitude: 0, latitude: 0 },
        globe: { zoom: 1, longitude: 77.09, latitude: 28 },
      };

      const clamp = (value, minimum, maximum) => Math.min(maximum, Math.max(minimum, value));
      const radians = (degrees) => degrees * Math.PI / 180;
      const formatNumber = new Intl.NumberFormat('en-US');

      const parseHash = () => {
        const parts = window.location.hash.replace(/^#/, '').split('/').filter(Boolean);
        if (!parts.length) return;
        const hasMode = parts[0] === 'flat' || parts[0] === 'globe';
        const mode = hasMode ? parts[0] : 'flat';
        const values = parts.slice(hasMode ? 1 : 0).map(Number);
        if (values.some((value) => !Number.isFinite(value))) return;
        state.mode = mode;
        if (mode === 'flat' && values.length >= 3) {
          state.flat.zoom = clamp(values[0], 0.8, 8);
          state.flat.latitude = clamp(values[1], -75, 75);
          state.flat.longitude = values[2];
        }
        if (mode === 'globe' && values.length >= 3) {
          state.globe.zoom = clamp(values[0] / 2.7, 0.72, 1.8);
          state.globe.latitude = clamp(values[1], -75, 75);
          state.globe.longitude = values[2];
        }
      };

      const writeHash = () => {
        const current = state.mode === 'flat' ? state.flat : state.globe;
        const zoom = state.mode === 'flat' ? current.zoom : current.zoom * 2.7;
        const nextHash = `#${state.mode}/${zoom.toFixed(2)}/${current.latitude.toFixed(2)}/${current.longitude.toFixed(2)}`;
        window.history.replaceState(null, '', nextHash);
      };

      const resizeCanvas = () => {
        if (!canvas || !context || !page) return;
        const bounds = page.getBoundingClientRect();
        state.pixelRatio = Math.min(2, window.devicePixelRatio || 1);
        state.width = Math.round(bounds.width);
        state.height = Math.round(bounds.height);
        canvas.width = Math.round(state.width * state.pixelRatio);
        canvas.height = Math.round(state.height * state.pixelRatio);
        canvas.style.width = `${state.width}px`;
        canvas.style.height = `${state.height}px`;
        context.setTransform(state.pixelRatio, 0, 0, state.pixelRatio, 0, 0);
        render();
      };

      const traceGeometry = (project, fill, stroke, lineWidth) => {
        if (!context) return;
        context.beginPath();
        for (const polygon of state.geometry) {
          for (const ring of polygon) {
            let drawing = false;
            let previous = null;
            for (const coordinate of ring) {
              const point = project(coordinate[0], coordinate[1]);
              if (!point?.visible) {
                drawing = false;
                previous = null;
                continue;
              }
              if (!drawing || (previous && Math.abs(point.x - previous.x) > state.width * 0.58)) {
                context.moveTo(point.x, point.y);
                drawing = true;
              } else {
                context.lineTo(point.x, point.y);
              }
              previous = point;
            }
            if (drawing) context.closePath();
          }
        }
        if (fill) {
          context.fillStyle = fill;
          context.fill('evenodd');
        }
        if (stroke) {
          context.strokeStyle = stroke;
          context.lineWidth = lineWidth;
          context.stroke();
        }
      };

      const mercatorY = (latitude) => {
        const safeLatitude = clamp(latitude, -85, 85);
        const value = Math.log(Math.tan(Math.PI / 4 + radians(safeLatitude) / 2));
        return 0.5 - value / (2 * Math.PI);
      };

      const projectFlat = (longitude, latitude) => {
        const size = state.width * state.flat.zoom;
        let deltaLongitude = (longitude - state.flat.longitude) / 360;
        if (deltaLongitude > 0.5) deltaLongitude -= 1;
        if (deltaLongitude < -0.5) deltaLongitude += 1;
        return {
          x: state.width / 2 + deltaLongitude * size,
          y: state.height / 2 + (mercatorY(latitude) - mercatorY(state.flat.latitude)) * size,
          visible: true,
          depth: 1,
        };
      };

      const globeFrame = () => {
        const mobile = state.width <= 820;
        const baseRadius = mobile
          ? Math.min(state.width * 0.49, state.height * 0.36)
          : Math.min(state.width * 0.34, state.height * 0.44);
        return {
          radius: baseRadius * state.globe.zoom,
          x: mobile ? state.width * 0.55 : state.width * 0.66,
          y: mobile ? state.height * 0.53 : state.height * 0.53,
        };
      };

      const projectGlobe = (longitude, latitude) => {
        const frame = globeFrame();
        const longitudeDelta = radians(longitude - state.globe.longitude);
        const latitudeValue = radians(latitude);
        const centerLatitude = radians(state.globe.latitude);
        const cosLatitude = Math.cos(latitudeValue);
        const depth = Math.sin(centerLatitude) * Math.sin(latitudeValue)
          + Math.cos(centerLatitude) * cosLatitude * Math.cos(longitudeDelta);
        return {
          x: frame.x + frame.radius * cosLatitude * Math.sin(longitudeDelta),
          y: frame.y - frame.radius * (
            Math.cos(centerLatitude) * Math.sin(latitudeValue)
            - Math.sin(centerLatitude) * cosLatitude * Math.cos(longitudeDelta)
          ),
          visible: depth > 0.015,
          depth,
        };
      };

      const drawFlat = () => {
        if (!context) return;
        const ocean = context.createLinearGradient(0, 0, state.width, state.height);
        ocean.addColorStop(0, '#030807');
        ocean.addColorStop(0.52, '#071212');
        ocean.addColorStop(1, '#020707');
        context.fillStyle = ocean;
        context.fillRect(0, 0, state.width, state.height);

        context.save();
        context.strokeStyle = 'rgba(111, 167, 168, 0.09)';
        context.lineWidth = 1;
        for (let longitude = -180; longitude <= 180; longitude += 30) {
          context.beginPath();
          for (let latitude = -80; latitude <= 80; latitude += 4) {
            const point = projectFlat(longitude, latitude);
            if (latitude === -80) context.moveTo(point.x, point.y);
            else context.lineTo(point.x, point.y);
          }
          context.stroke();
        }
        for (let latitude = -60; latitude <= 60; latitude += 30) {
          context.beginPath();
          for (let longitude = -180; longitude <= 180; longitude += 4) {
            const point = projectFlat(longitude, latitude);
            if (longitude === -180) context.moveTo(point.x, point.y);
            else context.lineTo(point.x, point.y);
          }
          context.stroke();
        }
        context.restore();

        traceGeometry(projectFlat, '#17201c', 'rgba(111, 167, 168, 0.42)', 0.75);
      };

      const drawGlobeGrid = (frame) => {
        if (!context) return;
        context.save();
        context.beginPath();
        context.arc(frame.x, frame.y, frame.radius, 0, Math.PI * 2);
        context.clip();
        context.strokeStyle = 'rgba(111, 167, 168, 0.11)';
        context.lineWidth = 1;
        for (let longitude = -180; longitude < 180; longitude += 30) {
          context.beginPath();
          let started = false;
          for (let latitude = -88; latitude <= 88; latitude += 2) {
            const point = projectGlobe(longitude, latitude);
            if (!point.visible) { started = false; continue; }
            if (!started) { context.moveTo(point.x, point.y); started = true; }
            else context.lineTo(point.x, point.y);
          }
          context.stroke();
        }
        for (let latitude = -60; latitude <= 60; latitude += 30) {
          context.beginPath();
          let started = false;
          for (let longitude = -180; longitude <= 180; longitude += 2) {
            const point = projectGlobe(longitude, latitude);
            if (!point.visible) { started = false; continue; }
            if (!started) { context.moveTo(point.x, point.y); started = true; }
            else context.lineTo(point.x, point.y);
          }
          context.stroke();
        }
        context.restore();
      };

      const drawGlobe = () => {
        if (!context) return;
        context.fillStyle = '#010404';
        context.fillRect(0, 0, state.width, state.height);
        const frame = globeFrame();
        const glow = context.createRadialGradient(
          frame.x - frame.radius * 0.28,
          frame.y - frame.radius * 0.34,
          frame.radius * 0.08,
          frame.x,
          frame.y,
          frame.radius * 1.2,
        );
        glow.addColorStop(0, '#102928');
        glow.addColorStop(0.62, '#071313');
        glow.addColorStop(1, '#010607');
        context.beginPath();
        context.arc(frame.x, frame.y, frame.radius, 0, Math.PI * 2);
        context.fillStyle = glow;
        context.fill();
        context.strokeStyle = 'rgba(111, 167, 168, 0.24)';
        context.lineWidth = 1;
        context.stroke();

        context.save();
        context.beginPath();
        context.arc(frame.x, frame.y, frame.radius - 0.5, 0, Math.PI * 2);
        context.clip();
        traceGeometry(projectGlobe, '#1a211d', 'rgba(111, 167, 168, 0.44)', 0.7);
        context.restore();
        drawGlobeGrid(frame);

        const shade = context.createRadialGradient(
          frame.x - frame.radius * 0.42,
          frame.y - frame.radius * 0.38,
          frame.radius * 0.08,
          frame.x + frame.radius * 0.15,
          frame.y + frame.radius * 0.15,
          frame.radius * 1.18,
        );
        shade.addColorStop(0, 'rgba(111, 167, 168, 0.08)');
        shade.addColorStop(0.58, 'rgba(0, 0, 0, 0.06)');
        shade.addColorStop(1, 'rgba(0, 0, 0, 0.72)');
        context.beginPath();
        context.arc(frame.x, frame.y, frame.radius, 0, Math.PI * 2);
        context.fillStyle = shade;
        context.fill();
      };

      const updateMarkers = () => {
        const project = state.mode === 'flat' ? projectFlat : projectGlobe;
        const mobileOffsets = state.mode === 'flat' && state.width <= 820
          ? {
              'japan-kanto': { x: 8, y: -47 },
              shanghai: { x: 28, y: 0 },
              sanya: { x: -4, y: 47 },
            }
          : {};
        for (const location of payload.locations || []) {
          const element = markerElements.get(location.id);
          if (!element) continue;
          const point = project(location.longitude, location.latitude);
          const offset = mobileOffsets[location.id] || { x: 0, y: 0 };
          point.x += offset.x;
          point.y += offset.y;
          const onscreen = point.visible
            && point.x > -80 && point.x < state.width + 80
            && point.y > -80 && point.y < state.height + 80;
          element.style.left = `${point.x}px`;
          element.style.top = `${point.y}px`;
          element.style.opacity = onscreen ? '1' : '0';
          element.style.visibility = onscreen ? 'visible' : 'hidden';
          element.style.pointerEvents = onscreen ? 'auto' : 'none';
          element.style.setProperty('--marker-depth', String(point.depth || 1));
          element.querySelector('.marker-count').textContent = formatNumber.format(location.count);
        }
      };

      const updateInterface = () => {
        if (page) page.dataset.viewMode = state.mode;
        for (const button of modeButtons) {
          button.setAttribute('aria-selected', String(button.dataset.mode === state.mode));
        }
        if (status) {
          status.textContent = state.mode === 'flat'
            ? 'FLAT MAP · DRAG TO PAN'
            : '3D GLOBE · DRAG TO ROTATE';
        }
      };

      const render = () => {
        if (!context || !state.width || !state.height) return;
        context.setTransform(state.pixelRatio, 0, 0, state.pixelRatio, 0, 0);
        context.clearRect(0, 0, state.width, state.height);
        if (state.mode === 'flat') drawFlat();
        else drawGlobe();
        updateMarkers();
        updateInterface();
      };

      const setMode = (mode) => {
        state.mode = mode === 'flat' ? 'flat' : 'globe';
        render();
        writeHash();
      };

      const zoomBy = (factor) => {
        if (state.mode === 'flat') state.flat.zoom = clamp(state.flat.zoom * factor, 0.8, 8);
        else state.globe.zoom = clamp(state.globe.zoom * factor, 0.72, 1.8);
        render();
        writeHash();
      };

      const resetView = () => {
        if (state.mode === 'flat') state.flat = { zoom: 1.05, longitude: 0, latitude: 0 };
        else state.globe = { zoom: 1, longitude: 77.09, latitude: 28 };
        render();
        writeHash();
      };

      modeButtons.forEach((button) => {
        button.addEventListener('click', () => setMode(button.dataset.mode));
      });

      document.querySelector('[data-action="zoom-in"]')?.addEventListener('click', () => zoomBy(1.22));
      document.querySelector('[data-action="zoom-out"]')?.addEventListener('click', () => zoomBy(1 / 1.22));
      document.querySelector('[data-action="home"]')?.addEventListener('click', resetView);
      document.querySelector('[data-action="toggle"]')?.addEventListener('click', () => {
        setMode(state.mode === 'flat' ? 'globe' : 'flat');
      });

      canvas?.addEventListener('pointerdown', (event) => {
        state.dragging = true;
        state.moved = false;
        state.pointerId = event.pointerId;
        state.previousX = event.clientX;
        state.previousY = event.clientY;
        canvas.setPointerCapture(event.pointerId);
        canvas.classList.add('is-dragging');
      });

      canvas?.addEventListener('pointermove', (event) => {
        if (!state.dragging || state.pointerId !== event.pointerId) return;
        const deltaX = event.clientX - state.previousX;
        const deltaY = event.clientY - state.previousY;
        if (Math.abs(deltaX) + Math.abs(deltaY) > 1) state.moved = true;
        state.previousX = event.clientX;
        state.previousY = event.clientY;
        if (state.mode === 'flat') {
          const scale = state.width * state.flat.zoom;
          state.flat.longitude -= deltaX / scale * 360;
          state.flat.latitude = clamp(state.flat.latitude + deltaY / scale * 360, -75, 75);
        } else {
          state.globe.longitude -= deltaX * 0.32 / state.globe.zoom;
          state.globe.latitude = clamp(state.globe.latitude + deltaY * 0.28 / state.globe.zoom, -75, 75);
        }
        render();
      });

      const finishDrag = (event) => {
        if (!state.dragging || state.pointerId !== event.pointerId) return;
        state.dragging = false;
        state.pointerId = null;
        canvas?.classList.remove('is-dragging');
        writeHash();
      };

      canvas?.addEventListener('pointerup', finishDrag);
      canvas?.addEventListener('pointercancel', finishDrag);
      canvas?.addEventListener('wheel', (event) => {
        event.preventDefault();
        zoomBy(event.deltaY < 0 ? 1.12 : 1 / 1.12);
      }, { passive: false });

      window.addEventListener('resize', resizeCanvas);
      window.addEventListener('hashchange', () => { parseHash(); render(); });

      parseHash();
      resizeCanvas();
      fetch(payload.worldUrl)
        .then((response) => {
          if (!response.ok) throw new Error(`Map data returned ${response.status}`);
          return response.json();
        })
        .then((collection) => {
          state.geometry = collection.features.flatMap((feature) => {
            const geometry = feature.geometry;
            if (!geometry) return [];
            if (geometry.type === 'Polygon') return [geometry.coordinates];
            if (geometry.type === 'MultiPolygon') return geometry.coordinates;
            return [];
          });
          loadingNote?.classList.add('is-hidden');
          render();
        })
        .catch(() => {
          if (loadingNote) loadingNote.textContent = '世界边界暂时无法载入';
        });
    </script>
  </body>
</html>
