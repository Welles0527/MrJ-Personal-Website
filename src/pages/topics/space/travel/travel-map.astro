---
import coffeeAlbumData from '../../../../data/coffee-latte-art-album.json';
import jamaicaAlbumData from '../../../../data/jamaica-photo-album.json';
import japanAlbumData from '../../../../data/japan-kanto-2015-album.json';
import sanyaAlbumData from '../../../../data/sanya-2016-album.json';
import travelAlbums from '../../../../data/travel-2018-albums.json';
import { sitePath } from '../../../../data/site';

const travelCoordinates = {
  'london-2018': { country: '英国', region: '英国 · 伦敦', latitude: 51.497799, longitude: -0.112702 },
  'naked-valley-2018': { country: '中国', region: '中国 · 浙江 · 裸心谷', latitude: 30.562559, longitude: 119.86982 },
  'huzhou-2018': { country: '中国', region: '中国 · 浙江 · 湖州', latitude: 30.959429, longitude: 120.102669 },
};
const locations = [
  ...travelAlbums.map((data) => ({
    id: data.album.slug,
    name: data.album.name,
    markerName: data.title,
    ...travelCoordinates[data.album.slug as keyof typeof travelCoordinates],
    count: data.album.count,
    href: sitePath(`/topics/space/travel/photo-wall/${data.album.slug}/`),
    cover: data.album.cover,
  })),
  {
    id: 'shanghai',
    name: '上海',
    markerName: '上海',
    country: '中国',
    region: '中国 · 上海',
    count: coffeeAlbumData.album.count,
    latitude: 31.2304,
    longitude: 121.4737,
    href: sitePath('/topics/space/travel/photo-wall/coffee-latte-art'),
    cover: coffeeAlbumData.album.cover,
  },
  {
    id: 'sanya',
    name: '2016 海南三亚',
    markerName: '三亚',
    country: '中国',
    region: '中国 · 海南',
    count: sanyaAlbumData.album.count,
    latitude: 18.2528,
    longitude: 109.5119,
    href: sitePath('/topics/space/travel/photo-wall/sanya-2016'),
    cover: sanyaAlbumData.album.cover,
  },
  {
    id: 'jamaica',
    name: '(2004-2005)牙买加',
    markerName: '牙买加',
    country: '牙买加',
    region: '加勒比海 · 牙买加',
    count: jamaicaAlbumData.album.count,
    latitude: 18.1096,
    longitude: -77.2975,
    href: sitePath('/topics/space/travel/photo-wall/jamaica'),
    cover: jamaicaAlbumData.album.cover,
  },
  {
    id: 'japan-kanto',
    name: '2015年日本（关东）',
    markerName: '东京',
    country: '日本',
    region: '日本 · 关东',
    count: japanAlbumData.album.count,
    latitude: 35.6762,
    longitude: 139.6503,
    href: sitePath('/topics/space/travel/photo-wall/japan-kanto-2015'),
    cover: japanAlbumData.album.cover,
  },
];

const photoTotal = locations.reduce((sum, location) => sum + location.count, 0);
const countrySummary: Array<{ name: string; cityCount: number; photoCount: number }> = [];
for (const location of locations) {
  const summary = countrySummary;
  const item = summary.find((entry) => entry.name === location.country);
  if (item) {
    item.cityCount += 1;
    item.photoCount += location.count;
  } else {
    summary.push({ name: location.country, cityCount: 1, photoCount: location.count });
  }
}
const mapLabels = [
  { name: '亚洲', type: 'continent', latitude: 48, longitude: 87 },
  { name: '欧洲', type: 'continent', latitude: 55, longitude: 16 },
  { name: '非洲', type: 'continent', latitude: 7, longitude: 20 },
  { name: '北美洲', type: 'continent', latitude: 50, longitude: -108 },
  { name: '南美洲', type: 'continent', latitude: -20, longitude: -62 },
  { name: '大洋洲', type: 'continent', latitude: -38, longitude: 151 },
  { name: '中国', type: 'country', latitude: 35, longitude: 103 },
  { name: '日本', type: 'country', latitude: 38, longitude: 138 },
  { name: '牙买加', type: 'country', latitude: 18.2, longitude: -77.3 },
  { name: '美国', type: 'country', latitude: 39, longitude: -99 },
  { name: '加拿大', type: 'country', latitude: 58, longitude: -108 },
  { name: '巴西', type: 'country', latitude: -11, longitude: -52 },
  { name: '英国', type: 'country', latitude: 55, longitude: -3 },
  { name: '法国', type: 'country', latitude: 46, longitude: 2 },
  { name: '德国', type: 'country', latitude: 51, longitude: 10 },
  { name: '印度', type: 'country', latitude: 22, longitude: 78 },
  { name: '澳大利亚', type: 'country', latitude: -25, longitude: 134 },
  { name: '俄罗斯', type: 'country', latitude: 62, longitude: 78 },
];
const mapPayload = JSON.stringify({
  locations,
  labels: mapLabels,
  worldUrl: sitePath('/data/maps/ne-110m-countries.geojson'),
});
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#020808" />
    <meta name="description" content="J先生的旅行影像地图，以平面世界地图与3D地球浏览相册。" />
    <link rel="icon" href={sitePath('/favicon.png')} />
    <title>旅行影像地图 · J先生的个人空间</title>
    <style>
      :root {
        color-scheme: dark;
        font-family: "Noto Sans SC", "Microsoft YaHei", system-ui, sans-serif;
        color: #f4eadf;
        background: #020808;
        --ink: #020808;
        --panel: rgba(5, 18, 18, 0.82);
        --line: rgba(200, 179, 160, 0.28);
        --paper: #f4eadf;
        --sand: #c8b3a0;
        --teal: #2a6e6f;
        --aqua: #6fa7a8;
        --clay: #8b5f43;
      }

      * { box-sizing: border-box; }

      html,
      body {
        width: 100%;
        min-width: 320px;
        height: 100%;
        margin: 0;
        overflow: hidden;
        background: var(--ink);
      }

      button,
      a {
        font: inherit;
        touch-action: manipulation;
        -webkit-tap-highlight-color: rgba(111, 167, 168, 0.22);
      }

      button { color: inherit; }

      .map-page {
        --map-ui-scale: 1;
        position: relative;
        isolation: isolate;
        width: 100%;
        height: 100dvh;
        min-height: 100svh;
        overflow: hidden;
        background: #010204;
      }

      .map-canvas,
      .marker-layer {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
      }

      .map-canvas {
        z-index: 1;
        display: block;
        cursor: grab;
        touch-action: none;
      }

      .map-canvas.is-dragging { cursor: grabbing; }

      .map-canvas:focus-visible {
        outline: 2px solid rgba(130, 202, 205, 0.92);
        outline-offset: -4px;
      }

      .map-page.is-interacting { user-select: none; }

      .marker-layer {
        z-index: 3;
        overflow: hidden;
        pointer-events: none;
      }

      .marker-leaders { position: absolute; inset: 0; width: 100%; height: 100%; pointer-events: none; }
      .marker-leaders line { stroke: #8d9dd7; stroke-width: 1; stroke-dasharray: 3 3; }

      .map-marker {
        position: absolute;
        display: grid;
        width: 58px;
        height: 58px;
        place-items: center;
        border: 1px solid rgba(99, 116, 206, 0.92);
        border-radius: 50%;
        color: #fff;
        background: rgba(58, 72, 158, 0.96);
        box-shadow: 0 8px 22px rgba(0, 0, 0, 0.46);
        text-decoration: none;
        transform: translate(-50%, -50%) scale(var(--map-ui-scale));
        transition: opacity 180ms ease, transform 180ms ease, background 180ms ease;
        pointer-events: auto;
      }

      .map-marker:hover,
      .map-marker:focus-visible {
        z-index: 5;
        outline: none;
        background: rgba(70, 88, 184, 0.99);
        box-shadow: 0 0 0 4px rgba(74, 91, 181, 0.18), 0 10px 28px rgba(0, 0, 0, 0.5);
        transform: translate(-50%, -50%) scale(var(--map-ui-scale)) scale(1.08);
      }

      .marker-count {
        font-family: Georgia, "Times New Roman", serif;
        font-size: 0.94rem;
        font-weight: 700;
        font-variant-numeric: tabular-nums;
        letter-spacing: -0.03em;
      }

      .marker-name {
        position: absolute;
        bottom: calc(100% + 7px);
        left: 50%;
        color: #fff;
        font-size: 0.7rem;
        font-family: "Noto Sans SC", "Microsoft YaHei UI", "Microsoft YaHei", sans-serif;
        font-weight: 500;
        letter-spacing: 0.04em;
        line-height: 1;
        white-space: nowrap;
        transform: translateX(-50%);
        pointer-events: none;
      }

      .marker-card {
        position: absolute;
        left: 50%;
        bottom: calc(100% + 31px);
        display: grid;
        width: 216px;
        grid-template-columns: 64px 1fr;
        gap: 12px;
        padding: 9px;
        border: 1px solid rgba(200, 179, 160, 0.4);
        border-radius: 16px;
        opacity: 0;
        background: rgba(4, 14, 14, 0.94);
        box-shadow: 0 18px 44px rgba(0, 0, 0, 0.48);
        transform: translate(-50%, 8px);
        transition: opacity 160ms ease, transform 160ms ease;
        pointer-events: none;
      }

      .map-marker:hover .marker-card,
      .map-marker:focus-visible .marker-card {
        opacity: 1;
        transform: translate(-50%, 0);
      }

      .marker-card img {
        width: 64px;
        height: 64px;
        border-radius: 11px;
        object-fit: cover;
      }

      .marker-card-copy {
        display: flex;
        min-width: 0;
        flex-direction: column;
        justify-content: center;
      }

      .marker-card strong {
        overflow: hidden;
        font-family: Georgia, "Noto Serif SC", serif;
        font-size: 0.92rem;
        text-overflow: ellipsis;
        white-space: nowrap;
      }

      .marker-card span {
        margin-top: 4px;
        color: var(--sand);
        font-size: 0.66rem;
        font-variant-numeric: tabular-nums;
        letter-spacing: 0.08em;
      }

      .topbar {
        position: absolute;
        z-index: 8;
        top: 0;
        left: 0;
        display: flex;
        width: 100%;
        align-items: center;
        justify-content: space-between;
        padding:
          calc(24px + env(safe-area-inset-top))
          calc(30px + env(safe-area-inset-right))
          24px
          calc(30px + env(safe-area-inset-left));
        pointer-events: none;
      }

      .brand,
      .back-link {
        pointer-events: auto;
      }

      .brand {
        display: flex;
        align-items: center;
        gap: 11px;
        color: var(--paper);
        font-size: 0.72rem;
        font-weight: 800;
        letter-spacing: 0.13em;
        transform: scale(var(--map-ui-scale));
        transform-origin: left center;
      }

      .brand-dot {
        width: 10px;
        height: 10px;
        border: 1px solid var(--sand);
        border-radius: 50%;
      }

      .back-link {
        display: inline-flex;
        min-height: 44px;
        align-items: center;
        color: rgba(244, 234, 223, 0.72);
        font-size: 0.7rem;
        font-weight: 700;
        letter-spacing: 0.12em;
        text-decoration: none;
        transition: color 160ms ease;
        transform: scale(var(--map-ui-scale));
        transform-origin: right center;
      }

      .back-link:hover { color: var(--paper); }

      .mode-switch {
        position: absolute;
        z-index: 9;
        top: calc(21px + env(safe-area-inset-top));
        left: 50%;
        display: flex;
        gap: 4px;
        padding: 4px;
        border: 1px solid rgba(200, 179, 160, 0.24);
        border-radius: 999px;
        background: rgba(3, 13, 13, 0.76);
        backdrop-filter: blur(14px);
        transform: translateX(-50%) scale(var(--map-ui-scale));
        transform-origin: top center;
      }

      .mode-button {
        min-width: 96px;
        min-height: 44px;
        padding: 9px 15px;
        border: 0;
        border-radius: 999px;
        color: rgba(244, 234, 223, 0.52);
        background: transparent;
        font-size: 0.72rem;
        font-weight: 800;
        letter-spacing: 0.08em;
        cursor: pointer;
      }

      .mode-button[aria-selected="true"] {
        color: #081212;
        background: var(--paper);
      }

      .theme-switch {
        position: absolute;
        z-index: 9;
        top: calc(76px + env(safe-area-inset-top));
        right: calc(20px + env(safe-area-inset-right));
        display: flex;
        gap: 3px;
        padding: 3px;
        border: 1px solid rgba(200, 179, 160, 0.24);
        border-radius: 999px;
        background: rgba(3, 13, 13, 0.76);
        box-shadow: 0 8px 24px rgba(0, 0, 0, 0.24);
        backdrop-filter: blur(14px);
        transform: scale(var(--map-ui-scale));
        transform-origin: top right;
      }

      .theme-button {
        min-width: 62px;
        min-height: 44px;
        padding: 7px 11px;
        border: 0;
        border-radius: 999px;
        color: rgba(244, 234, 223, 0.55);
        background: transparent;
        font-size: 0.62rem;
        font-weight: 800;
        letter-spacing: 0.08em;
        cursor: pointer;
      }

      .theme-button[aria-pressed="true"] {
        color: #081212;
        background: #f5f7f8;
      }

      .map-page[data-view-mode="globe"][data-globe-theme="glacier"] .map-marker {
        border-color: rgba(255, 205, 116, 0.98);
        background: rgba(207, 102, 7, 0.98);
        box-shadow: inset 0 1px 0 rgba(255, 238, 196, 0.48), 0 0 0 5px rgba(245, 155, 35, 0.14), 0 0 26px rgba(255, 143, 18, 0.68), 0 12px 28px rgba(0, 5, 12, 0.58);
      }

      .map-page[data-view-mode="globe"][data-globe-theme="glacier"] .map-marker:hover,
      .map-page[data-view-mode="globe"][data-globe-theme="glacier"] .map-marker:focus-visible {
        background: rgba(226, 119, 9, 1);
        box-shadow: inset 0 1px 0 rgba(255, 240, 203, 0.56), 0 0 0 6px rgba(255, 185, 75, 0.18), 0 0 34px rgba(255, 151, 28, 0.8), 0 14px 32px rgba(0, 5, 12, 0.62);
      }

      .map-page[data-view-mode="globe"][data-globe-theme="glacier"] .marker-name {
        color: #061525;
        text-shadow: 0 1px 2px rgba(226, 238, 244, 0.72);
      }

      .map-page[data-view-mode="globe"] .map-marker[data-marker="shanghai"] .marker-name,
      .map-page[data-view-mode="globe"] .map-marker[data-marker="sanya"] .marker-name {
        right: calc(100% + 9px);
        bottom: 50%;
        left: auto;
        transform: translateY(50%);
      }

      .map-controls {
        position: absolute;
        z-index: 9;
        top: calc(88px + env(safe-area-inset-top));
        left: calc(24px + env(safe-area-inset-left));
        display: grid;
        gap: 10px;
        transform: scale(var(--map-ui-scale));
        transform-origin: top left;
      }

      .control-group {
        display: grid;
        overflow: hidden;
        border: 1px solid rgba(200, 179, 160, 0.3);
        border-radius: 14px;
        background: rgba(3, 13, 13, 0.82);
        backdrop-filter: blur(12px);
      }

      .map-control {
        display: grid;
        width: 44px;
        height: 44px;
        place-items: center;
        border: 0;
        color: var(--paper);
        background: transparent;
        font-size: 1.35rem;
        cursor: pointer;
      }

      .map-control + .map-control { border-top: 1px solid rgba(200, 179, 160, 0.2); }
      .map-control:hover { background: rgba(111, 167, 168, 0.18); }
      .map-control svg { width: 19px; height: 19px; fill: none; stroke: currentColor; stroke-width: 1.8; }

      .back-link:focus-visible,
      .mode-button:focus-visible,
      .theme-button:focus-visible,
      .map-control:focus-visible {
        outline: 2px solid rgba(130, 202, 205, 0.96);
        outline-offset: 3px;
      }

      .map-control:focus-visible { outline-offset: -4px; }

      .mode-button:not([aria-selected="true"]):hover,
      .theme-button:not([aria-pressed="true"]):hover {
        color: rgba(244, 234, 223, 0.82);
        background: rgba(111, 167, 168, 0.12);
      }

      .map-heading {
        position: absolute;
        z-index: 7;
        top: 50%;
        left: 6vw;
        width: min(410px, 38vw);
        transform: translateY(-50%) scale(var(--map-ui-scale));
        transform-origin: left center;
        pointer-events: none;
      }

      .map-eyebrow {
        margin: 0 0 14px;
        color: var(--aqua);
        font-size: 0.68rem;
        font-weight: 800;
        letter-spacing: 0.24em;
      }

      .map-heading h1 {
        margin: 0;
        font-family: Georgia, "Noto Serif SC", "Songti SC", serif;
        font-size: clamp(3rem, 4.25vw, 4.3rem);
        font-weight: 500;
        line-height: 1.02;
        letter-spacing: -0.045em;
      }

      .map-title-line {
        display: block;
        white-space: nowrap;
      }

      .map-lede {
        display: block;
        max-width: 330px;
        margin: 18px 0 0;
        color: rgba(244, 234, 223, 0.58);
        font-family: Georgia, "Noto Serif SC", serif;
        font-size: 0.82rem;
        line-height: 1.7;
      }

      .country-summary {
        width: min(340px, 100%);
        margin-top: 25px;
        border-top: 1px solid rgba(200, 179, 160, 0.28);
      }

      .country-summary__heading {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 11px 0 8px;
        color: rgba(244, 234, 223, 0.48);
        font-size: 0.56rem;
        font-weight: 800;
        letter-spacing: 0.18em;
      }

      .country-summary__heading span:last-child {
        color: var(--aqua);
      }

      .country-summary ul {
        padding: 0;
        margin: 0;
        list-style: none;
      }

      .country-summary li {
        display: grid;
        grid-template-columns: minmax(72px, 1fr) auto auto;
        gap: 12px;
        align-items: baseline;
        padding: 9px 0;
        border-bottom: 1px solid rgba(200, 179, 160, 0.14);
      }

      .country-summary strong {
        font-family: Georgia, "Noto Serif SC", serif;
        font-size: 0.87rem;
        font-weight: 600;
      }

      .country-summary small {
        color: rgba(244, 234, 223, 0.5);
        font-size: 0.61rem;
        font-variant-numeric: tabular-nums;
        letter-spacing: 0.06em;
        white-space: nowrap;
      }

      .country-summary b {
        color: var(--paper);
        font-family: Georgia, "Times New Roman", serif;
        font-size: 0.78rem;
        font-weight: 500;
        font-variant-numeric: tabular-nums;
        white-space: nowrap;
      }

      .map-stats {
        position: absolute;
        z-index: 8;
        bottom: calc(25px + env(safe-area-inset-bottom));
        left: calc(30px + env(safe-area-inset-left));
        display: flex;
        gap: 34px;
        pointer-events: none;
        transform: scale(var(--map-ui-scale));
        transform-origin: bottom left;
      }

      .stat strong {
        display: block;
        font-family: Georgia, "Times New Roman", serif;
        font-size: 1.5rem;
        font-weight: 500;
        font-variant-numeric: tabular-nums;
      }

      .stat span {
        display: block;
        margin-top: 3px;
        color: rgba(244, 234, 223, 0.5);
        font-size: 0.58rem;
        font-weight: 800;
        letter-spacing: 0.17em;
      }

      .map-status {
        position: absolute;
        z-index: 8;
        right: calc(30px + env(safe-area-inset-right));
        bottom: calc(28px + env(safe-area-inset-bottom));
        color: rgba(244, 234, 223, 0.5);
        font-size: 0.58rem;
        font-weight: 700;
        letter-spacing: 0.15em;
        pointer-events: none;
        transform: scale(var(--map-ui-scale));
        transform-origin: bottom right;
      }

      .corner {
        position: absolute;
        z-index: 7;
        width: 44px;
        height: 44px;
        border-color: rgba(200, 179, 160, 0.38);
        pointer-events: none;
        transform: scale(var(--map-ui-scale));
      }

      .corner--tl { top: 14px; left: 14px; border-top: 1px solid; border-left: 1px solid; }
      .corner--tr { top: 14px; right: 14px; border-top: 1px solid; border-right: 1px solid; }
      .corner--bl { bottom: 14px; left: 14px; border-bottom: 1px solid; border-left: 1px solid; }
      .corner--br { right: 14px; bottom: 14px; border-right: 1px solid; border-bottom: 1px solid; }

      .corner--tl { transform-origin: top left; }
      .corner--tr { transform-origin: top right; }
      .corner--bl { transform-origin: bottom left; }
      .corner--br { transform-origin: bottom right; }

      .loading-note {
        position: absolute;
        z-index: 10;
        right: 50%;
        bottom: 50%;
        color: rgba(244, 234, 223, 0.64);
        font-size: 0.66rem;
        letter-spacing: 0.16em;
        transform: translate(50%, 50%);
        transition: opacity 220ms ease;
        pointer-events: none;
      }

      .loading-note.is-hidden { opacity: 0; }

      .map-page[data-view-mode="flat"] {
        color: #4b2a18;
        background: #d6bd91;
      }

      .map-page[data-view-mode="flat"] .brand,
      .map-page[data-view-mode="flat"] .back-link,
      .map-page[data-view-mode="flat"] .map-heading h1,
      .map-page[data-view-mode="flat"] .country-summary strong,
      .map-page[data-view-mode="flat"] .country-summary b,
      .map-page[data-view-mode="flat"] .stat strong {
        color: #4b2a18;
        text-shadow: 0 1px rgba(255, 244, 217, 0.36);
      }

      .map-page[data-view-mode="flat"] .brand-dot { border-color: #714226; }
      .map-page[data-view-mode="flat"] .map-eyebrow,
      .map-page[data-view-mode="flat"] .country-summary__heading span:last-child { color: #7a3f21; }

      .map-page[data-view-mode="flat"] .map-lede,
      .map-page[data-view-mode="flat"] .country-summary__heading,
      .map-page[data-view-mode="flat"] .country-summary small,
      .map-page[data-view-mode="flat"] .stat span,
      .map-page[data-view-mode="flat"] .map-status { color: rgba(75, 42, 24, 0.7); }

      .map-page[data-view-mode="flat"] .country-summary { border-color: rgba(91, 52, 29, 0.42); }
      .map-page[data-view-mode="flat"] .country-summary li { border-color: rgba(91, 52, 29, 0.24); }

      .map-page[data-view-mode="flat"] .map-heading {
        z-index: 20;
        padding: 20px 22px 18px;
        border: 1px solid rgba(255, 244, 217, 0.62);
        border-radius: 22px;
