  <body>
    <main class="map-page" data-map-page>
      <canvas
        class="map-canvas"
        data-map-canvas
        role="application"
        tabindex="0"
        aria-label="交互式旅行地图。拖动或使用方向键移动视角，使用加号和减号缩放，按 Home 键重置。"
      ></canvas>
      <div class="marker-layer" data-marker-layer>
        <svg class="marker-leaders" aria-hidden="true">
          {locations.map((location) => <line data-marker-leader={location.id} />)}
        </svg>
        {locations.map((location) => (
          <a
            class="map-marker"
            data-marker={location.id}
            href={location.href}
            aria-label={`${location.name}，${location.count}张照片，打开相册`}
          >
            <span class="marker-name">{location.markerName}</span>
            <span class="marker-count">{location.count.toLocaleString('en-US')}</span>
            <span class="marker-card" aria-hidden="true">
              <img src={sitePath(location.cover)} alt="" width="64" height="64" loading="lazy" />
              <span class="marker-card-copy">
                <strong>{location.name}</strong>
                <span>{location.region} · {location.count} PHOTOS</span>
              </span>
            </span>
          </a>
        ))}
      </div>

      <header class="topbar">
        <div class="brand"><span class="brand-dot"></span><span>J先生 · 影像地图</span></div>
        <a class="back-link" href={sitePath('/topics/space/travel/photo-wall/')}>返回相册墙</a>
      </header>

      <div class="mode-switch" role="tablist" aria-label="地图显示模式">
        <button class="mode-button" type="button" role="tab" data-mode="flat" aria-selected="false">平面地图</button>
        <button class="mode-button" type="button" role="tab" data-mode="globe" aria-selected="true">3D 地球</button>
      </div>

      <div class="theme-switch" role="group" aria-label="地球主题">
        <button class="theme-button" type="button" data-theme-option="dark" aria-pressed="true">暗夜</button>
        <button class="theme-button" type="button" data-theme-option="glacier" aria-pressed="false">冰川白</button>
      </div>

      <div class="map-controls" aria-label="地图控制">
        <div class="control-group">
          <button class="map-control" type="button" data-action="zoom-in" aria-label="放大">＋</button>
          <button class="map-control" type="button" data-action="zoom-out" aria-label="缩小">−</button>
        </div>
        <div class="control-group">
          <button class="map-control" type="button" data-action="home" aria-label="重置地图位置">
            <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="7"></circle><path d="M12 2v4M12 18v4M2 12h4M18 12h4"></path><circle cx="12" cy="12" r="2"></circle></svg>
          </button>
          <button class="map-control" type="button" data-action="toggle" aria-label="切换平面地图和3D地球">
            <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9"></circle><path d="M3 12h18M12 3a15 15 0 0 1 0 18M12 3a15 15 0 0 0 0 18"></path></svg>
          </button>
        </div>
      </div>

      <section class="map-heading" aria-labelledby="map-title">
        <p class="map-eyebrow">TRAVEL COORDINATES · {locations.length.toString().padStart(2, '0')}</p>
        <h1 id="map-title">
          <span class="map-title-line">把旅程</span>
          <span class="map-title-line">放在地图上</span>
        </h1>
        <p class="map-lede">拖动地图探索拍摄地点，点击坐标即可进入对应相册。</p>
        <div class="country-summary" aria-label="已标注国家影像统计">
          <div class="country-summary__heading"><span>COUNTRY ARCHIVE</span><span>{countrySummary.length.toString().padStart(2, '0')}</span></div>
          <ul>
            {countrySummary.map((country) => (
              <li>
                <strong>{country.name}</strong>
                <small>{country.cityCount} 城市</small>
                <b>{country.photoCount.toLocaleString('en-US')} 照片</b>
              </li>
            ))}
          </ul>
        </div>
      </section>

      <div class="map-stats" aria-label="影像地图统计">
        <div class="stat"><strong>{locations.length}</strong><span>LOCATIONS</span></div>
        <div class="stat"><strong>{photoTotal.toLocaleString('en-US')}</strong><span>PHOTOS</span></div>
      </div>
      <div class="map-status" data-map-status>3D GLOBE · DRAG TO ROTATE</div>
      <div class="loading-note" data-loading-note role="status" aria-live="polite" aria-atomic="true">正在装载世界边界…</div>
      <span class="corner corner--tl"></span><span class="corner corner--tr"></span>
      <span class="corner corner--bl"></span><span class="corner corner--br"></span>
    </main>

    <script id="travel-map-data" type="application/json" is:inline set:html={mapPayload}></script>
    <script>
      // @ts-nocheck
      const payloadElement = document.querySelector('#travel-map-data');
      const payload = JSON.parse(payloadElement?.textContent || '{}');
      const canvas = document.querySelector('[data-map-canvas]');
      const page = document.querySelector('[data-map-page]');
      const status = document.querySelector('[data-map-status]');
      const loadingNote = document.querySelector('[data-loading-note]');
      const modeButtons = [...document.querySelectorAll('[data-mode]')];
      const themeButtons = [...document.querySelectorAll('[data-theme-option]')];
      const markerElements = new Map(
        [...document.querySelectorAll('[data-marker]')].map((element) => [element.dataset.marker, element]),
      );
      const context = canvas?.getContext('2d');
      const parchmentImage = new Image();
      parchmentImage.decoding = 'async';
      parchmentImage.src = '/officialwebsite/images/travel/travel-map-parchment.webp';
      const spaceImage = new Image();
      spaceImage.decoding = 'async';
      spaceImage.src = '/officialwebsite/images/travel/travel-map-space-v2.png';
      const glacierTextureImage = new Image();
      glacierTextureImage.decoding = 'async';
      glacierTextureImage.src = '/officialwebsite/images/travel/travel-map-glacier-texture-v1.png';
      const glacierOceanImage = new Image();
      glacierOceanImage.decoding = 'async';
      glacierOceanImage.src = '/officialwebsite/images/travel/travel-map-glacier-ocean-v1.png';
      const starFieldCanvas = document.createElement('canvas');
      const starFieldContext = starFieldCanvas.getContext('2d');
      let glacierLandPattern = null;
      let glacierOceanPattern = null;

      const state = {
        mode: 'globe',
        theme: 'dark',
        geometry: [],
        flatGeometry: [],
        width: 0,
        height: 0,
        pixelRatio: 1,
        dragging: false,
        interacting: false,
        pointerId: null,
        pinchDistance: null,
        previousX: 0,
        previousY: 0,
        moved: false,
        flat: { zoom: 1.05, longitude: 0, latitude: 0 },
        globe: { zoom: 1, longitude: 77.09, latitude: 28 },
      };

      const clamp = (value, minimum, maximum) => Math.min(maximum, Math.max(minimum, value));
      const radians = (degrees) => degrees * Math.PI / 180;
      const wrapLongitude = (longitude) => ((longitude + 180) % 360 + 360) % 360 - 180;
      const formatNumber = new Intl.NumberFormat('en-US');
      const globeThemes = {
        dark: {
          background: '#000000',
          ocean: '#020610',
          oceanSecondary: '#080d15',
          landDark: '#111713',
          landMid: '#19211c',
          landBright: '#29312a',
          border: '#46515c',
          grid: '#27313c',
          rim: '#273342',
          gridOpacity: 0,
        },
        glacier: {
          background: '#020914',
          ocean: '#061525',
          oceanSecondary: '#3e5b70',
          landDark: '#748794',
          landMid: '#aebcc6',
          landBright: '#e4eaee',
          border: '#cbdde7',
          grid: '#c8e2ef',
          rim: '#edfaff',
          gridOpacity: 0.105,
        },
      };

      const glacierLabelNames = new Set(['亚洲', '欧洲', '俄罗斯', '中国', '日本', '印度', '澳大利亚', '大洋洲']);

      const getGlobeTheme = () => globeThemes[state.theme] || globeThemes.dark;

      try {
        const savedTheme = window.localStorage.getItem('travel-map-globe-theme');
        if (savedTheme === 'dark' || savedTheme === 'glacier') state.theme = savedTheme;
      } catch { /* Theme persistence is optional. */ }

      const rgba = (hex, opacity) => {
        const value = Number.parseInt(hex.replace('#', ''), 16);
        return `rgba(${value >> 16}, ${(value >> 8) & 255}, ${value & 255}, ${opacity})`;
      };

      const seededValue = (seed) => {
        const value = Math.sin(seed * 12.9898 + 78.233) * 43758.5453;
        return value - Math.floor(value);
      };

      const rebuildStarField = () => {
        if (!starFieldContext || !state.width || !state.height) return;
        starFieldCanvas.width = state.width;
        starFieldCanvas.height = state.height;
        const theme = getGlobeTheme();
        starFieldContext.fillStyle = theme.background;
        starFieldContext.fillRect(0, 0, state.width, state.height);
        if (state.theme !== 'glacier') return;
        if (spaceImage.complete && spaceImage.naturalWidth > 0) {
          const scale = Math.max(state.width / spaceImage.naturalWidth, state.height / spaceImage.naturalHeight);
          const width = spaceImage.naturalWidth * scale;
          const height = spaceImage.naturalHeight * scale;
          starFieldContext.drawImage(spaceImage, (state.width - width) / 2, (state.height - height) / 2, width, height);
          starFieldContext.fillStyle = 'rgba(1, 8, 15, 0.36)';
          starFieldContext.fillRect(0, 0, state.width, state.height);
          return;
        }
        const starCount = Math.round(clamp((state.width * state.height) / 8400, 56, 150));
        starFieldContext.save();
        for (let index = 0; index < starCount; index += 1) {
          const x = seededValue(index + 1) * state.width;
          const y = seededValue(index + 701) * state.height;
          const strength = seededValue(index + 1401);
          starFieldContext.beginPath();
          starFieldContext.arc(x, y, strength > 0.92 ? 1.1 : 0.48, 0, Math.PI * 2);
          starFieldContext.fillStyle = `rgba(226, 244, 255, ${0.18 + strength * 0.62})`;
          starFieldContext.shadowColor = 'rgba(198, 231, 255, 0.52)';
          starFieldContext.shadowBlur = strength > 0.9 ? 5 : 0;
          starFieldContext.fill();
        }
        starFieldContext.restore();
      };

      const drawStarField = () => {
        if (!context) return;
        if (starFieldCanvas.width !== state.width || starFieldCanvas.height !== state.height) rebuildStarField();
        context.drawImage(starFieldCanvas, 0, 0, state.width, state.height);
      };

      const drawMapLabels = (project, clipFrame = null) => {
        if (!context) return;
        context.save();
        if (clipFrame) {
          context.beginPath();
          context.arc(clipFrame.x, clipFrame.y, clipFrame.radius - 1, 0, Math.PI * 2);
          context.clip();
        }
        context.textBaseline = 'middle';
        const isFlat = state.mode === 'flat';
        const isGlacierGlobe = !isFlat && state.theme === 'glacier';
        context.lineJoin = 'round';
        context.shadowColor = isFlat
          ? 'rgba(255, 236, 194, 0.3)'
          : isGlacierGlobe
            ? 'rgba(226, 238, 244, 0.72)'
            : 'transparent';
        context.shadowBlur = isFlat ? 1 : isGlacierGlobe ? 1.2 : 0;
        context.shadowOffsetY = isGlacierGlobe ? 1 : 0;
        for (const label of payload.labels || []) {
          if (isGlacierGlobe && !glacierLabelNames.has(label.name)) continue;
          const point = project(label.longitude, label.latitude);
          if (!point.visible || (clipFrame && point.depth < 0.16)) continue;
          const isContinent = label.type === 'continent';
          const isCity = label.type === 'city';
          const depthOpacity = clipFrame ? clamp((point.depth - 0.08) / 0.72, 0.85, 1) : 1;
          context.font = isCity && !isFlat
            ? `400 ${state.width <= 820 ? 8 : 9}px "Noto Sans SC", "Microsoft YaHei UI", "Microsoft YaHei", sans-serif`
            : isContinent
              ? `${isFlat ? 600 : 400} ${isFlat ? (state.width <= 820 ? 9 : 12) : (state.width <= 820 ? 10 : 12)}px "Noto Sans SC", "Microsoft YaHei UI", "Microsoft YaHei", sans-serif`
              : `${isFlat ? 600 : 400} ${isFlat ? (state.width <= 820 ? 7 : 9) : (state.width <= 820 ? 8 : 9)}px "Noto Sans SC", "Microsoft YaHei UI", "Microsoft YaHei", sans-serif`;
          context.lineWidth = isFlat ? (isContinent ? 3.6 : 3) : (isContinent ? 4.5 : 3.5);
          context.strokeStyle = isFlat
            ? `rgba(225, 199, 151, ${0.72 * depthOpacity})`
            : `rgba(0, 0, 0, ${0.9 * depthOpacity})`;
          context.fillStyle = isFlat
            ? isContinent
              ? `rgba(68, 35, 19, ${0.92 * depthOpacity})`
              : `rgba(83, 45, 25, ${0.84 * depthOpacity})`
            : isGlacierGlobe
              ? rgba(globeThemes.glacier.ocean, 0.94 * depthOpacity)
              : `rgba(255, 255, 255, ${0.98 * depthOpacity})`;
          if (isCity && !isFlat) {
            context.beginPath();
            context.arc(point.x, point.y, state.width <= 820 ? 2 : 2.5, 0, Math.PI * 2);
            context.strokeStyle = `rgba(255, 255, 255, ${0.86 * depthOpacity})`;
            context.lineWidth = 1.25;
            context.stroke();
            context.textAlign = 'left';
            if (isFlat) context.strokeText(label.name, point.x + 7, point.y + 1);
            context.fillText(label.name, point.x + 7, point.y + 1);
          } else {
            context.textAlign = 'center';
            if (isFlat) context.strokeText(label.name, point.x, point.y);
            context.fillText(label.name, point.x, point.y);
          }
        }
        context.restore();
      };

      const parseHash = () => {
        const parts = window.location.hash.replace(/^#/, '').split('/').filter(Boolean);
        if (!parts.length) return;
        const hasMode = parts[0] === 'flat' || parts[0] === 'globe';
        const mode = hasMode ? parts[0] : 'flat';
        const valueStart = hasMode ? 1 : 0;
        const values = parts.slice(valueStart, valueStart + 3).map(Number);
        if (values.some((value) => !Number.isFinite(value))) return;
        const hashTheme = parts[valueStart + 3];
        state.mode = mode;
        if (hashTheme === 'dark' || hashTheme === 'glacier') state.theme = hashTheme;
        if (mode === 'flat' && values.length >= 3) {
          state.flat.zoom = clamp(values[0], 0.8, 8);
          state.flat.latitude = clamp(values[1], -75, 75);
          state.flat.longitude = wrapLongitude(values[2]);
        }
        if (mode === 'globe' && values.length >= 3) {
          state.globe.zoom = clamp(values[0] / 2.7, 0.72, 1.8);
          state.globe.latitude = clamp(values[1], -75, 75);
          state.globe.longitude = values[2];
        }
      };

      const writeHash = () => {
        const current = state.mode === 'flat' ? state.flat : state.globe;
        const zoom = state.mode === 'flat' ? current.zoom : current.zoom * 2.7;
        const nextHash = `#${state.mode}/${zoom.toFixed(2)}/${current.latitude.toFixed(2)}/${current.longitude.toFixed(2)}/${state.theme}`;
        window.history.replaceState(null, '', nextHash);
      };

      const resizeCanvas = () => {
        if (!canvas || !context || !page) return;
        const bounds = page.getBoundingClientRect();
        const displayPixelRatio = window.devicePixelRatio || 1;
        page.style.setProperty('--map-ui-scale', '1');
        state.pixelRatio = Math.min(1.5, window.devicePixelRatio || 1);
        state.width = Math.round(bounds.width);
        state.height = Math.round(bounds.height);
        canvas.width = Math.round(state.width * state.pixelRatio);
        canvas.height = Math.round(state.height * state.pixelRatio);
        canvas.style.width = `${state.width}px`;
        canvas.style.height = `${state.height}px`;
        context.setTransform(state.pixelRatio, 0, 0, state.pixelRatio, 0, 0);
        rebuildStarField();
        render();
      };

      const traceGeometry = (project, fill, stroke, lineWidth) => {
        if (!context) return;
        const coordinateStep = state.mode === 'globe' && state.interacting && state.theme !== 'glacier' ? 3 : 1;
        context.beginPath();
        for (const polygon of state.geometry) {
          for (const ring of polygon) {
            if (state.mode === 'globe') {
              const coordinates = ring.filter((_, index) => index % coordinateStep === 0);
              const points = coordinates.map((coordinate) => project(coordinate[0], coordinate[1]));
              const outsideIndex = points.findIndex((point) => !point?.visible);
              if (outsideIndex === -1) {
                points.forEach((point, index) => {
                  if (index === 0) context.moveTo(point.x, point.y);
                  else context.lineTo(point.x, point.y);
                });
                context.closePath();
                continue;
              }
              if (points.every((point) => !point?.visible)) continue;

              const frame = globeFrame();
              const horizonRadius = frame.radius * Math.sqrt(1 - 0.015 ** 2);
              const horizonIntersection = (from, to, fromVisible) => {
                let longitudeDelta = to[0] - from[0];
                while (longitudeDelta > 180) longitudeDelta -= 360;
                while (longitudeDelta < -180) longitudeDelta += 360;
                let lower = 0;
                let upper = 1;
                for (let iteration = 0; iteration < 18; iteration += 1) {
                  const progress = (lower + upper) / 2;
                  const point = project(
                    from[0] + longitudeDelta * progress,
                    from[1] + (to[1] - from[1]) * progress,
                  );
                  if (Boolean(point?.visible) === fromVisible) lower = progress;
                  else upper = progress;
                }
                const progress = (lower + upper) / 2;
                return project(
                  from[0] + longitudeDelta * progress,
                  from[1] + (to[1] - from[1]) * progress,
                );
              };
              let entryPoint = null;
              for (let offset = 1; offset <= coordinates.length; offset += 1) {
                const previousIndex = (outsideIndex + offset - 1) % coordinates.length;
                const currentIndex = (outsideIndex + offset) % coordinates.length;
                const previousPoint = points[previousIndex];
                const currentPoint = points[currentIndex];
                const previousVisible = Boolean(previousPoint?.visible);
                const currentVisible = Boolean(currentPoint?.visible);
                if (!previousVisible && currentVisible) {
                  entryPoint = horizonIntersection(
                    coordinates[previousIndex],
                    coordinates[currentIndex],
                    false,
                  );
                  context.moveTo(entryPoint.x, entryPoint.y);
                  context.lineTo(currentPoint.x, currentPoint.y);
                } else if (previousVisible && currentVisible) {
                  context.lineTo(currentPoint.x, currentPoint.y);
                } else if (previousVisible && !currentVisible && entryPoint) {
                  const exitPoint = horizonIntersection(
                    coordinates[previousIndex],
                    coordinates[currentIndex],
                    true,
                  );
                  context.lineTo(exitPoint.x, exitPoint.y);
                  const exitAngle = Math.atan2(exitPoint.y - frame.y, exitPoint.x - frame.x);
                  const entryAngle = Math.atan2(entryPoint.y - frame.y, entryPoint.x - frame.x);
                  let angleDelta = entryAngle - exitAngle;
                  while (angleDelta > Math.PI) angleDelta -= Math.PI * 2;
                  while (angleDelta < -Math.PI) angleDelta += Math.PI * 2;
                  context.arc(
                    frame.x,
                    frame.y,
                    horizonRadius,
                    exitAngle,
                    entryAngle,
                    angleDelta < 0,
                  );
                  context.closePath();
                  entryPoint = null;
                }
              }
              continue;
            }
            let drawing = false;
            let previous = null;
            for (let coordinateIndex = 0; coordinateIndex < ring.length; coordinateIndex += coordinateStep) {
              const coordinate = ring[coordinateIndex];
              const point = project(coordinate[0], coordinate[1]);
              if (!point?.visible) {
                drawing = false;
                previous = null;
                continue;
              }
              if (!drawing || (previous && Math.abs(point.x - previous.x) > state.width * 0.58)) {
                context.moveTo(point.x, point.y);
                drawing = true;
              } else {
                context.lineTo(point.x, point.y);
              }
              previous = point;
            }
            if (drawing) context.closePath();
          }
        }
        if (fill) {
          context.fillStyle = fill;
          context.fill('evenodd');
        }
        if (stroke) {
          context.strokeStyle = stroke;
          context.lineWidth = lineWidth;
          context.stroke();
        }
      };

      const buildFlatGeometry = (geometry) => geometry.map((polygon) => polygon.map((ring) => {
        let previousLongitude = ring[0]?.[0] ?? 0;
        let minimumLongitude = previousLongitude;
        let maximumLongitude = previousLongitude;
        const coordinates = ring.map(([sourceLongitude, latitude], index) => {
          let longitude = sourceLongitude;
          if (index > 0) {
            while (longitude - previousLongitude > 180) longitude -= 360;
            while (longitude - previousLongitude < -180) longitude += 360;
          }
          previousLongitude = longitude;
          minimumLongitude = Math.min(minimumLongitude, longitude);
          maximumLongitude = Math.max(maximumLongitude, longitude);
          return [longitude, latitude];
        });
        return { coordinates, minimumLongitude, maximumLongitude };
      }));

      const mercatorY = (latitude) => {
        const safeLatitude = clamp(latitude, -85, 85);
        const value = Math.log(Math.tan(Math.PI / 4 + radians(safeLatitude) / 2));
        return 0.5 - value / (2 * Math.PI);
      };

      const projectFlat = (longitude, latitude) => {
        const size = state.width * state.flat.zoom;
        let deltaLongitude = (longitude - state.flat.longitude) / 360;
        if (deltaLongitude > 0.5) deltaLongitude -= 1;
        if (deltaLongitude < -0.5) deltaLongitude += 1;
        return {
          x: state.width / 2 + deltaLongitude * size,
          y: state.height / 2 + (mercatorY(latitude) - mercatorY(state.flat.latitude)) * size,
          visible: true,
          depth: 1,
        };
      };

      const projectFlatContinuous = (longitude, latitude) => {
        const size = state.width * state.flat.zoom;
        return {
          x: state.width / 2 + ((longitude - state.flat.longitude) / 360) * size,
          y: state.height / 2 + (mercatorY(latitude) - mercatorY(state.flat.latitude)) * size,
          visible: true,
          depth: 1,
        };
      };

      const traceFlatGeometry = (fill, stroke, lineWidth) => {
        if (!context) return;
        const halfVisibleLongitude = 180 / state.flat.zoom;
        const visibleMinimum = state.flat.longitude - halfVisibleLongitude - 4;
        const visibleMaximum = state.flat.longitude + halfVisibleLongitude + 4;
        const worldOffsets = [-720, -360, 0, 360, 720];
        context.beginPath();
        for (const polygon of state.flatGeometry) {
          for (const ring of polygon) {
            for (const offset of worldOffsets) {
              if (ring.maximumLongitude + offset < visibleMinimum
                || ring.minimumLongitude + offset > visibleMaximum) continue;
              let drawing = false;
              for (const [longitude, latitude] of ring.coordinates) {
                const point = projectFlatContinuous(longitude + offset, latitude);
                if (!drawing) {
                  context.moveTo(point.x, point.y);
                  drawing = true;
                } else {
                  context.lineTo(point.x, point.y);
                }
              }
              if (drawing) context.closePath();
            }
          }
        }
        if (fill) {
          context.fillStyle = fill;
          context.fill('evenodd');
        }
        if (stroke) {
          context.strokeStyle = stroke;
          context.lineWidth = lineWidth;
          context.stroke();
        }
      };

      const globeFrame = () => {
        const mobile = state.width <= 820;
        const baseRadius = mobile
          ? Math.min(state.width * 0.34, state.height * 0.25)
          : Math.min(state.width * 0.21, state.height * 0.4);
        return {
          radius: baseRadius * state.globe.zoom,
          x: state.width * (mobile ? 0.54 : 0.62),
          y: state.height * (mobile ? 0.665 : 0.53),
        };
      };

      const projectGlobe = (longitude, latitude) => {
        const frame = globeFrame();
        const longitudeDelta = radians(longitude - state.globe.longitude);
        const latitudeValue = radians(latitude);
        const centerLatitude = radians(state.globe.latitude);
        const cosLatitude = Math.cos(latitudeValue);
        const depth = Math.sin(centerLatitude) * Math.sin(latitudeValue)
          + Math.cos(centerLatitude) * cosLatitude * Math.cos(longitudeDelta);
        return {
          x: frame.x + frame.radius * cosLatitude * Math.sin(longitudeDelta),
          y: frame.y - frame.radius * (
            Math.cos(centerLatitude) * Math.sin(latitudeValue)
            - Math.sin(centerLatitude) * cosLatitude * Math.cos(longitudeDelta)
          ),
          visible: depth > 0.015,
          depth,
        };
      };

      const drawFlatGrid = () => {
        if (!context) return;
        context.save();
        context.strokeStyle = 'rgba(83, 47, 27, 0.2)';
        context.lineWidth = 0.62;
        for (let longitude = -180; longitude < 180; longitude += 30) {
          context.beginPath();
          let drawing = false;
          for (let latitude = -82; latitude <= 82; latitude += 2) {
            const point = projectFlat(longitude, latitude);
            if (!drawing) { context.moveTo(point.x, point.y); drawing = true; }
            else context.lineTo(point.x, point.y);
          }
          context.stroke();
        }
        for (let latitude = -60; latitude <= 60; latitude += 30) {
          context.beginPath();
          let previous = null;
          for (let longitude = -180; longitude <= 180; longitude += 2) {
            const point = projectFlat(longitude, latitude);
            if (!previous || Math.abs(point.x - previous.x) > state.width * 0.58) context.moveTo(point.x, point.y);
            else context.lineTo(point.x, point.y);
            previous = point;
          }
          context.stroke();
        }
        context.strokeStyle = 'rgba(83, 47, 27, 0.34)';
        context.lineWidth = 1;
        context.strokeRect(18.5, 18.5, state.width - 37, state.height - 37);
        context.restore();
      };

      const drawFlat = () => {
        if (!context) return;
        context.fillStyle = '#d8bf91';
        context.fillRect(0, 0, state.width, state.height);
        if (parchmentImage.complete && parchmentImage.naturalWidth) {
          const imageRatio = parchmentImage.naturalWidth / parchmentImage.naturalHeight;
          const canvasRatio = state.width / state.height;
          const sourceWidth = canvasRatio > imageRatio
            ? parchmentImage.naturalWidth
            : parchmentImage.naturalHeight * canvasRatio;
          const sourceHeight = canvasRatio > imageRatio
            ? parchmentImage.naturalWidth / canvasRatio
            : parchmentImage.naturalHeight;
          const sourceX = (parchmentImage.naturalWidth - sourceWidth) / 2;
          const sourceY = (parchmentImage.naturalHeight - sourceHeight) / 2;
          context.drawImage(
            parchmentImage,
            sourceX,
            sourceY,
            sourceWidth,
            sourceHeight,
            0,
            0,
            state.width,
            state.height,
          );
        }
        const paperShade = context.createRadialGradient(
          state.width * 0.52,
          state.height * 0.44,
          0,
          state.width * 0.5,
          state.height * 0.5,
          Math.max(state.width, state.height) * 0.72,
        );
        paperShade.addColorStop(0, 'rgba(255, 246, 218, 0.05)');
        paperShade.addColorStop(0.72, 'rgba(102, 57, 29, 0.04)');
        paperShade.addColorStop(1, 'rgba(75, 38, 18, 0.16)');
        context.fillStyle = paperShade;
        context.fillRect(0, 0, state.width, state.height);
        drawFlatGrid();

        const land = context.createLinearGradient(0, 0, state.width, state.height);
        land.addColorStop(0, 'rgba(149, 105, 68, 0.82)');
        land.addColorStop(0.46, 'rgba(126, 83, 51, 0.76)');
        land.addColorStop(1, 'rgba(101, 61, 36, 0.82)');
        context.save();
        context.globalCompositeOperation = 'multiply';
        context.shadowColor = 'rgba(74, 39, 20, 0.24)';
        context.shadowBlur = 5;
        traceFlatGeometry(land, 'rgba(75, 39, 20, 0.82)', 0.95);
        context.shadowBlur = 0;
        traceFlatGeometry(null, 'rgba(99, 55, 29, 0.54)', 0.48);
        context.restore();
        drawMapLabels(projectFlat);
      };

      const drawGlobeGrid = (frame, theme) => {
        if (!context || !theme.gridOpacity) return;
        const sampleStep = state.interacting ? 12 : 4;
        context.save();
        context.beginPath();
        context.arc(frame.x, frame.y, frame.radius - 1, 0, Math.PI * 2);
        context.clip();
        context.strokeStyle = rgba(theme.grid, theme.gridOpacity);
        context.lineWidth = state.theme === 'glacier' ? 0.55 : 0.7;
        for (let longitude = -180; longitude < 180; longitude += 30) {
          context.beginPath();
          let drawing = false;
          for (let latitude = -88; latitude <= 88; latitude += sampleStep) {
            const point = projectGlobe(longitude, latitude);
            if (!point.visible) { drawing = false; continue; }
            if (!drawing) { context.moveTo(point.x, point.y); drawing = true; }
            else context.lineTo(point.x, point.y);
          }
          context.stroke();
        }
        for (let latitude = -60; latitude <= 60; latitude += 30) {
          context.beginPath();
          let drawing = false;
          for (let longitude = -180; longitude <= 180; longitude += sampleStep) {
            const point = projectGlobe(longitude, latitude);
            if (!point.visible) { drawing = false; continue; }
            if (!drawing) { context.moveTo(point.x, point.y); drawing = true; }
            else context.lineTo(point.x, point.y);
          }
          context.stroke();
        }
        context.restore();
      };

      const drawCrystalShell = (frame, theme) => {
        if (!context) return;
        context.save();
        if (state.theme === 'glacier') {
          context.beginPath();
          context.arc(frame.x, frame.y, frame.radius + 0.5, 0, Math.PI * 2);
          context.strokeStyle = 'rgba(170, 216, 242, 0.03)';
          context.lineWidth = 1.5;
          context.shadowColor = 'rgba(166, 216, 246, 0.42)';
          context.shadowBlur = 34;
          context.stroke();
          context.restore();
          return;
        }
        context.beginPath();
        context.arc(frame.x, frame.y, frame.radius - 0.5, 0, Math.PI * 2);
        context.strokeStyle = rgba(theme.rim, 0.32);
        context.lineWidth = 0.8;
        context.stroke();
        context.restore();
      };

      const drawGlacierRoutes = (frame) => {
        if (!context || state.theme !== 'glacier') return;
        const routeIds = ['sanya', 'shanghai', 'japan-kanto'];
        const routePoints = routeIds
          .map((id) => payload.locations?.find((location) => location.id === id))
          .filter(Boolean)
          .map((location) => projectGlobe(location.longitude, location.latitude));
        if (routePoints.length !== routeIds.length || routePoints.some((point) => !point.visible || point.depth < 0.08)) return;

        const traceRoute = () => {
          context.beginPath();
          context.moveTo(routePoints[0].x, routePoints[0].y);
          for (let index = 1; index < routePoints.length; index += 1) {
            const start = routePoints[index - 1];
            const end = routePoints[index];
            const controlX = (start.x + end.x) / 2 - frame.radius * (index === 1 ? 0.12 : 0.06);
            const controlY = Math.min(start.y, end.y) - frame.radius * (index === 1 ? 0.085 : 0.055);
            context.quadraticCurveTo(controlX, controlY, end.x, end.y);
          }
        };

        context.save();
        context.lineCap = 'round';
        context.lineJoin = 'round';
        traceRoute();
        context.strokeStyle = 'rgba(255, 157, 42, 0.16)';
        context.lineWidth = 10;
        context.shadowColor = 'rgba(255, 141, 24, 0.72)';
        context.shadowBlur = 18;
        context.stroke();
        traceRoute();
        context.strokeStyle = 'rgba(255, 197, 116, 0.52)';
        context.lineWidth = 3.2;
        context.shadowBlur = 8;
        context.stroke();
        traceRoute();
        context.strokeStyle = 'rgba(255, 241, 218, 0.92)';
        context.lineWidth = 1.15;
        context.shadowBlur = 0;
        context.stroke();
        context.restore();
      };

      const drawGlobe = () => {
        if (!context) return;
        const frame = globeFrame();
        const theme = getGlobeTheme();
        if (state.theme === 'glacier') {
          const atmosphere = context.createRadialGradient(
            frame.x,
            frame.y,
            frame.radius * 0.88,
            frame.x,
            frame.y,
            frame.radius * 1.14,
          );
          atmosphere.addColorStop(0, 'rgba(181, 220, 243, 0)');
          atmosphere.addColorStop(0.42, 'rgba(208, 237, 253, 0.16)');
          atmosphere.addColorStop(0.62, 'rgba(172, 216, 242, 0.09)');
          atmosphere.addColorStop(1, 'rgba(112, 176, 218, 0)');
          context.beginPath();
          context.arc(frame.x, frame.y, frame.radius * 1.14, 0, Math.PI * 2);
          context.fillStyle = atmosphere;
          context.fill();
        }
        const glow = context.createRadialGradient(
          frame.x - frame.radius * 0.42,
          frame.y - frame.radius * 0.46,
          frame.radius * 0.02,
          frame.x + frame.radius * 0.08,
          frame.y + frame.radius * 0.1,
          frame.radius * 1.08,
        );
        if (state.theme === 'glacier') {
          glow.addColorStop(0, '#678399');
          glow.addColorStop(0.22, theme.oceanSecondary);
          glow.addColorStop(0.58, theme.ocean);
          glow.addColorStop(0.84, '#03101d');
          glow.addColorStop(1, '#010710');
        } else {
          glow.addColorStop(0, theme.oceanSecondary);
          glow.addColorStop(0.35, '#050a12');
          glow.addColorStop(0.7, theme.ocean);
          glow.addColorStop(1, '#00030a');
        }
        context.beginPath();
        context.arc(frame.x, frame.y, frame.radius, 0, Math.PI * 2);
        context.fillStyle = glow;
        context.fill();
        if (state.theme !== 'glacier') {
          context.strokeStyle = rgba(theme.rim, 0.28);
          context.lineWidth = 0.8;
          context.stroke();
        }

        if (state.theme === 'glacier' && glacierOceanPattern) {
          context.save();
          context.beginPath();
          context.arc(frame.x, frame.y, frame.radius - 1, 0, Math.PI * 2);
          context.clip();
          context.globalCompositeOperation = 'screen';
          context.globalAlpha = 0.18;
          context.fillStyle = glacierOceanPattern;
          context.fillRect(frame.x - frame.radius, frame.y - frame.radius, frame.radius * 2, frame.radius * 2);
          context.restore();
        }

        context.save();
        context.beginPath();
        context.arc(frame.x, frame.y, frame.radius - 0.5, 0, Math.PI * 2);
        context.clip();
        const land = context.createLinearGradient(
          frame.x - frame.radius,
          frame.y - frame.radius,
          frame.x + frame.radius,
          frame.y + frame.radius,
        );
        if (state.theme === 'glacier') {
          land.addColorStop(0, '#eef2f4');
          land.addColorStop(0.24, theme.landBright);
          land.addColorStop(0.54, theme.landMid);
          land.addColorStop(0.8, theme.landDark);
          land.addColorStop(1, '#4d606f');
        } else {
          land.addColorStop(0, '#293129');
          land.addColorStop(0.28, theme.landBright);
          land.addColorStop(0.56, theme.landMid);
          land.addColorStop(0.82, theme.landDark);
          land.addColorStop(1, '#0d120f');
        }
        if (state.theme === 'glacier' && !state.interacting) {
          context.shadowColor = 'rgba(0, 20, 36, 0.48)';
          context.shadowBlur = 7;
          context.shadowOffsetY = 2.4;
        }
        traceGeometry(
          projectGlobe,
          land,
          rgba(theme.border, state.theme === 'glacier' ? 0.84 : 0.74),
          state.theme === 'glacier' ? 1.05 : 0.72,
        );
        context.shadowColor = 'transparent';
        context.shadowBlur = 0;
        context.shadowOffsetY = 0;
        if (state.theme === 'glacier' && glacierLandPattern) {
          context.save();
          context.globalCompositeOperation = 'multiply';
          context.globalAlpha = 0.24;
          context.fillStyle = glacierLandPattern;
          context.fill('evenodd');
          context.restore();
          context.save();
          context.globalCompositeOperation = 'screen';
          context.globalAlpha = 0.08;
          context.fillStyle = glacierLandPattern;
          context.fill('evenodd');
          context.restore();
          context.strokeStyle = 'rgba(230, 239, 244, 0.38)';
          context.lineWidth = 0.46;
          context.stroke();
        }
        context.restore();
        drawGlobeGrid(frame, theme);
        const shade = context.createRadialGradient(
          frame.x - frame.radius * 0.42,
          frame.y - frame.radius * 0.38,
          frame.radius * 0.08,
          frame.x + frame.radius * 0.15,
          frame.y + frame.radius * 0.15,
          frame.radius * 1.18,
        );
        if (state.theme === 'glacier') {
          shade.addColorStop(0, 'rgba(255, 255, 255, 0.22)');
          shade.addColorStop(0.36, 'rgba(218, 238, 249, 0.08)');
          shade.addColorStop(0.72, 'rgba(0, 8, 16, 0.04)');
          shade.addColorStop(1, 'rgba(0, 4, 10, 0.38)');
        } else {
          shade.addColorStop(0, 'rgba(198, 205, 204, 0.035)');
          shade.addColorStop(0.48, 'rgba(0, 0, 0, 0.03)');
          shade.addColorStop(0.82, 'rgba(0, 0, 0, 0.18)');
          shade.addColorStop(1, 'rgba(0, 0, 0, 0.62)');
        }
        context.beginPath();
        context.arc(frame.x, frame.y, frame.radius, 0, Math.PI * 2);
        context.fillStyle = shade;
        context.fill();
        drawGlacierRoutes(frame);
        drawCrystalShell(frame, theme);
        drawMapLabels(projectGlobe, frame);
      };

      const updateMarkers = () => {
        const project = state.mode === 'flat' ? projectFlat : projectGlobe;
        const markerOffsets = state.width <= 820
          ? {
              'japan-kanto': { x: 18, y: -47 },
              shanghai: { x: 28, y: 0 },
              sanya: { x: 8, y: 47 },
              'huzhou-2018': { x: -48, y: -27 },
              'naked-valley-2018': { x: -70, y: 38 },
            }
          : {
              'huzhou-2018': { x: -60, y: -30 },
              'naked-valley-2018': { x: state.mode === 'flat' ? -100 : -70, y: 38 },
            };
        for (const location of payload.locations || []) {
          const element = markerElements.get(location.id);
          if (!element) continue;
          const point = project(location.longitude, location.latitude);
          const offset = markerOffsets[location.id] || { x: 0, y: 0 };
          const anchor = { x: point.x, y: point.y };
          point.x += offset.x;
          point.y += offset.y;
          const onscreen = point.visible
            && point.x > -80 && point.x < state.width + 80
            && point.y > -80 && point.y < state.height + 80;
          element.style.left = `${point.x}px`;
          element.style.top = `${point.y}px`;
          const edgeOpacity = state.mode === 'globe'
            ? clamp((point.depth - 0.015) / 0.28, 0, 1)
            : 1;
          element.style.opacity = onscreen ? String(edgeOpacity) : '0';
          element.style.visibility = onscreen ? 'visible' : 'hidden';
          element.style.pointerEvents = onscreen && edgeOpacity > 0.28 ? 'auto' : 'none';
          const leader = document.querySelector(`[data-marker-leader="${location.id}"]`);
          if (leader) {
            leader.setAttribute('x1', String(anchor.x));
            leader.setAttribute('y1', String(anchor.y));
            leader.setAttribute('x2', String(point.x));
            leader.setAttribute('y2', String(point.y));
            leader.style.opacity = onscreen && (offset.x || offset.y) ? String(edgeOpacity * 0.7) : '0';
          }
          element.style.setProperty('--marker-depth', String(point.depth || 1));
          element.querySelector('.marker-count').textContent = formatNumber.format(location.count);
        }
      };

      const updateInterface = () => {
        if (page) {
          page.dataset.viewMode = state.mode;
          page.dataset.globeTheme = state.theme;
        }
        for (const button of modeButtons) {
          button.setAttribute('aria-selected', String(button.dataset.mode === state.mode));
        }
        for (const button of themeButtons) {
          button.setAttribute('aria-pressed', String(button.dataset.themeOption === state.theme));
        }
        if (status) {
          status.textContent = state.mode === 'flat'
            ? 'FLAT MAP · DRAG TO PAN'
            : '3D GLOBE · DRAG TO ROTATE';
        }
      };

      const render = () => {
        if (!context || !state.width || !state.height) return;
        context.setTransform(state.pixelRatio, 0, 0, state.pixelRatio, 0, 0);
        context.clearRect(0, 0, state.width, state.height);
        drawStarField();
        if (state.mode === 'flat') drawFlat();
        else drawGlobe();
        updateMarkers();
        updateInterface();
      };

      let queuedRenderFrame = 0;
      const scheduleRender = () => {
        if (queuedRenderFrame) return;
        queuedRenderFrame = window.requestAnimationFrame(() => {
          queuedRenderFrame = 0;
          render();
        });
      };

      const setMode = (mode) => {
        state.mode = mode === 'flat' ? 'flat' : 'globe';
        render();
        writeHash();
      };

      const setTheme = (theme) => {
        state.theme = theme === 'glacier' ? 'glacier' : 'dark';
        try { window.localStorage.setItem('travel-map-globe-theme', state.theme); } catch { /* Optional. */ }
        rebuildStarField();
        render();
        writeHash();
      };

      const zoomBy = (factor) => {
        if (state.mode === 'flat') state.flat.zoom = clamp(state.flat.zoom * factor, 0.8, 8);
        else state.globe.zoom = clamp(state.globe.zoom * factor, 0.72, 1.8);
        render();
        writeHash();
      };

      const resetView = () => {
        if (state.mode === 'flat') state.flat = { zoom: 1.05, longitude: 0, latitude: 0 };
        else state.globe = { zoom: 1, longitude: 77.09, latitude: 28 };
        render();
        writeHash();
      };

      const nudgeView = (longitudeDelta, latitudeDelta) => {
        const view = state.mode === 'flat' ? state.flat : state.globe;
        view.longitude = wrapLongitude(view.longitude + longitudeDelta);
        view.latitude = clamp(view.latitude + latitudeDelta, -75, 75);
        render();
        writeHash();
      };

      modeButtons.forEach((button) => {
        button.addEventListener('click', () => setMode(button.dataset.mode));
      });

      themeButtons.forEach((button) => {
        button.addEventListener('click', () => setTheme(button.dataset.themeOption));
      });

      document.querySelector('[data-action="zoom-in"]')?.addEventListener('click', () => zoomBy(1.22));
      document.querySelector('[data-action="zoom-out"]')?.addEventListener('click', () => zoomBy(1 / 1.22));
      document.querySelector('[data-action="home"]')?.addEventListener('click', resetView);
      document.querySelector('[data-action="toggle"]')?.addEventListener('click', () => {
        setMode(state.mode === 'flat' ? 'globe' : 'flat');
      });

      canvas?.addEventListener('keydown', (event) => {
        const step = event.shiftKey ? 10 : 4;
        let handled = true;
        if (event.key === 'ArrowLeft') nudgeView(-step, 0);
        else if (event.key === 'ArrowRight') nudgeView(step, 0);
        else if (event.key === 'ArrowUp') nudgeView(0, -step);
        else if (event.key === 'ArrowDown') nudgeView(0, step);
        else if (event.key === '+' || event.key === '=') zoomBy(1.22);
        else if (event.key === '-' || event.key === '_') zoomBy(1 / 1.22);
        else if (event.key === 'Home') resetView();
        else handled = false;
        if (handled) event.preventDefault();
      });

      const activePointers = new Map();
      const pointerDistance = () => {
        const [first, second] = [...activePointers.values()];
        return first && second ? Math.hypot(second.x - first.x, second.y - first.y) : null;
      };

      canvas?.addEventListener('pointerdown', (event) => {
        canvas.focus({ preventScroll: true });
        activePointers.set(event.pointerId, { x: event.clientX, y: event.clientY });
        state.interacting = true;
        page?.classList.add('is-interacting');
        if (canvas.hasPointerCapture?.(event.pointerId) === false) {
          try { canvas.setPointerCapture(event.pointerId); } catch { /* Synthetic QA events have no native pointer capture. */ }
        }
        if (activePointers.size === 2) {
          state.pinchDistance = pointerDistance();
          state.dragging = false;
          state.pointerId = null;
          canvas.classList.remove('is-dragging');
          return;
        }
        state.dragging = true;
        state.moved = false;
        state.pointerId = event.pointerId;
        state.previousX = event.clientX;
        state.previousY = event.clientY;
        canvas.classList.add('is-dragging');
      });

      canvas?.addEventListener('pointermove', (event) => {
        if (activePointers.has(event.pointerId)) {
          activePointers.set(event.pointerId, { x: event.clientX, y: event.clientY });
        }
        if (activePointers.size >= 2) {
          const distance = pointerDistance();
          if (distance && state.pinchDistance) {
            const factor = distance / state.pinchDistance;
            if (state.mode === 'flat') state.flat.zoom = clamp(state.flat.zoom * factor, 0.8, 3.6);
            else state.globe.zoom = clamp(state.globe.zoom * factor, 0.72, 1.8);
            state.moved = true;
            scheduleRender();
          }
          state.pinchDistance = distance;
          return;
        }
        if (!state.dragging || state.pointerId !== event.pointerId) return;
        const deltaX = event.clientX - state.previousX;
        const deltaY = event.clientY - state.previousY;
        if (Math.abs(deltaX) + Math.abs(deltaY) > 1) state.moved = true;
        state.previousX = event.clientX;
        state.previousY = event.clientY;
        if (state.mode === 'flat') {
          const scale = state.width * state.flat.zoom;
          state.flat.longitude = wrapLongitude(state.flat.longitude - deltaX / scale * 360);
          state.flat.latitude = clamp(state.flat.latitude + deltaY / scale * 360, -75, 75);
        } else {
          state.globe.longitude -= deltaX * 0.32 / state.globe.zoom;
          state.globe.latitude = clamp(state.globe.latitude + deltaY * 0.28 / state.globe.zoom, -75, 75);
        }
        scheduleRender();
      });

      const finishDrag = (event) => {
        activePointers.delete(event.pointerId);
        if (activePointers.size < 2) state.pinchDistance = null;
        if (state.dragging && state.pointerId === event.pointerId) {
          state.dragging = false;
          state.pointerId = null;
          canvas?.classList.remove('is-dragging');
        }
        if (activePointers.size === 0) {
          state.interacting = false;
          page?.classList.remove('is-interacting');
          if (queuedRenderFrame) {
            window.cancelAnimationFrame(queuedRenderFrame);
            queuedRenderFrame = 0;
          }
          render();
          writeHash();
        }
      };

      canvas?.addEventListener('pointerup', finishDrag);
      canvas?.addEventListener('pointercancel', finishDrag);
      canvas?.addEventListener('wheel', (event) => {
        event.preventDefault();
        zoomBy(event.deltaY < 0 ? 1.12 : 1 / 1.12);
      }, { passive: false });

      window.addEventListener('resize', resizeCanvas);
      window.addEventListener('hashchange', () => { parseHash(); render(); });
      parchmentImage.addEventListener('load', render, { once: true });
      spaceImage.addEventListener('load', () => { rebuildStarField(); render(); }, { once: true });
      glacierTextureImage.addEventListener('load', () => {
        glacierLandPattern = context?.createPattern(glacierTextureImage, 'repeat') || null;
        render();
      }, { once: true });
      glacierOceanImage.addEventListener('load', () => {
        glacierOceanPattern = context?.createPattern(glacierOceanImage, 'repeat') || null;
        render();
      }, { once: true });

      parseHash();
      resizeCanvas();
      fetch(payload.worldUrl)
        .then((response) => {
          if (!response.ok) throw new Error(`Map data returned ${response.status}`);
          return response.json();
        })
        .then((collection) => {
          state.geometry = collection.features.flatMap((feature) => {
            const geometry = feature.geometry;
            if (!geometry) return [];
            if (geometry.type === 'Polygon') return [geometry.coordinates];
            if (geometry.type === 'MultiPolygon') return geometry.coordinates;
            return [];
          });
          state.flatGeometry = buildFlatGeometry(state.geometry);
          loadingNote?.classList.add('is-hidden');
          render();
        })
        .catch(() => {
          if (loadingNote) loadingNote.textContent = '世界边界暂时无法载入';
        });
    </script>
  </body>
</html>
