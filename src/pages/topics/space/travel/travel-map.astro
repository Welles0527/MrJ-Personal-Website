---
import TravelGlobe from '../../../../components/TravelGlobe.astro';
import cityMap from '../../../../data/travel-city-map.json';
import { sitePath } from '../../../../data/site';

const locations = cityMap.cities.map(city => ({ ...city, photosPath: sitePath(city.photosPath) }));
const albums = cityMap.albums.map(album => ({ ...album, href: sitePath(`/topics/space/travel/photo-wall/${album.slug}/`) }));
---
<TravelGlobe locations={locations} albums={albums} totalPhotos={cityMap.totalPhotos} locatedPhotos={cityMap.locatedPhotos} unlocatedPhotos={cityMap.unlocatedPhotos} />
