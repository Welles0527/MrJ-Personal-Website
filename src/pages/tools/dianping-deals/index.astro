---
const favoritesUrl = '/officialwebsite/tools/dianping-favorites/';
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>收藏商家团购 · 沪上收藏</title>
    <style is:global>
      :root{font-family:-apple-system,BlinkMacSystemFont,"Segoe UI","PingFang SC","Microsoft YaHei",sans-serif;color:#f3f0ec;background:#242629}
      *{box-sizing:border-box}body{margin:0;min-height:100dvh}a{color:inherit}button,a{touch-action:manipulation}a:focus-visible{outline:3px solid #eebc7c;outline-offset:3px}
      .shell{max-width:1100px;margin:auto;padding:32px 30px 70px}.back{display:inline-block;color:#d7b783;text-decoration:none;font-size:14px;margin-bottom:26px}.back:hover{text-decoration:underline}
      .heading{display:flex;align-items:flex-end;justify-content:space-between;gap:20px;border-bottom:1px solid #48494b;padding-bottom:22px;margin-bottom:24px}.eyebrow{margin:0 0 8px;color:#d8ad70;font-size:12px;letter-spacing:2px}.heading h1{font-size:32px;line-height:1.2;margin:0}.intro{color:#bcb9b6;font-size:14px;line-height:1.7;margin:10px 0 0}.heading-actions{display:flex;align-items:center;gap:14px}.sync{display:inline-flex;align-items:center;justify-content:center;min-height:40px;padding:0 15px;border:1px solid #c1dfce;border-radius:9px;background:#c1dfce;color:#22372c;font-size:14px;font-weight:700;text-decoration:none;white-space:nowrap}.sync:hover{background:#d3ebdc}.count{color:#d1c9c0;font-size:14px;white-space:nowrap}
      .shops{display:grid;gap:18px}.shop{background:#323437;border:1px solid #4b4c4e;border-radius:16px;padding:22px 24px;box-shadow:5px 6px 14px #16171950}.shop-head{display:flex;justify-content:space-between;gap:18px;align-items:start}.shop h2{font-size:21px;line-height:1.4;margin:0}.address,.checked{color:#aaa8a5;font-size:13px;line-height:1.6;margin:5px 0 0}.checked{white-space:nowrap}.offers{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px;margin-top:20px}.offer{min-width:0;display:flex;align-items:center;justify-content:space-between;gap:15px;padding:15px 17px;border-radius:11px;background:#292b2e;border:1px solid #454648}.offer h3{font-size:15px;font-weight:600;line-height:1.55;margin:0;overflow-wrap:anywhere}.price{color:#ffd094;font-size:18px;font-weight:700;white-space:nowrap}.offer a{display:inline-block;margin-top:9px;color:#d7b783;font-size:13px;text-decoration:none}.offer a:hover{text-decoration:underline}
      .empty{padding:48px 24px;border:1px dashed #5b5650;border-radius:15px;text-align:center;color:#c9c4bd;line-height:1.8}.empty a{color:#e4b77c}.state{color:#c9c4bd;line-height:1.7}.note{color:#a9a5a0;font-size:12px;line-height:1.7;margin:24px 0 0}
      @media(max-width:700px){.shell{padding:20px 16px 50px}.heading{align-items:start;flex-direction:column;gap:8px}.heading h1{font-size:27px}.heading-actions{width:100%;justify-content:space-between}.shop{padding:18px 16px}.shop-head{flex-direction:column;gap:3px}.offers{grid-template-columns:1fr}.offer{align-items:flex-start}.price{font-size:17px}}
    </style>
  <script is:inline src="/officialwebsite/account-entry.js" defer></script>
</head>
  <body>
    <main class="shell">
      <a class="back" href={favoritesUrl}>← 返回我的收藏</a>
      <header class="heading"><div><p class="eyebrow">SHANGHAI COLLECTION</p><h1>收藏商家团购</h1><p class="intro">仅显示已从大众点评页面核实到团购套餐的收藏商家。同步将在收藏页运行。</p></div><div class="heading-actions"><span class="count" id="count"></span><a class="sync" href={`${favoritesUrl}?syncDeals=1`}>同步团购</a></div></header>
      <p class="state" id="state" role="status">正在读取账号收藏…</p>
      <div class="shops" id="shops"></div>
      <p class="note">团购信息为上次抓取时页面可见的内容。购买前请在大众点评核对当前价格与可用性。</p>
    </main>
    <script>
      import { getCloudDb, getCloudSession } from '../../../scripts/site-auth';

      const list = document.getElementById('shops')!;
      const state = document.getElementById('state')!;
      const count = document.getElementById('count')!;
      const shopId = new URLSearchParams(location.search).get('shop');
      const favoritesUrl = '/officialwebsite/tools/dianping-favorites/';
      const safeUrl = (value: unknown) => {
        try { const url = new URL(String(value)); return url.protocol === 'https:' && /(^|\.)(dianping\.com|meituan\.com)$/.test(url.hostname) ? url.href : ''; }
        catch { return ''; }
      };
      const text = (tag: string, className: string, value: unknown) => {
        const node = document.createElement(tag);
        node.className = className;
        node.textContent = String(value ?? '');
        return node;
      };
      const link = (label: string, href: string) => {
        const node = document.createElement('a');
        node.textContent = label;
        node.href = href;
        node.target = '_blank';
        node.rel = 'noopener noreferrer';
        return node;
      };
      function empty(message: string) {
        state.hidden = true;
        const panel = text('div', 'empty', message);
        panel.append(document.createElement('br'));
        const back = document.createElement('a');
        back.href = favoritesUrl;
        back.textContent = '返回收藏页同步团购';
        panel.append(back);
        list.replaceChildren(panel);
      }
      async function load() {
        list.replaceChildren();
        state.hidden = false;
        state.textContent = '正在读取账号收藏…';
        try {
          const session = await getCloudSession();
          if (!session) { empty('请先登录网站账号，查看个人收藏的团购。'); return; }
          const result: any = await getCloudDb().collection('officialWebsiteDianpingFavorites').doc(session.uid).get();
          if (result?.error) throw new Error(result.error.message || '读取失败');
          const record = Array.isArray(result?.data) ? result.data[0] : result?.data;
          if (record && record.ownerId !== session.uid) throw new Error('收藏记录与当前账号不匹配');
          const payload = record?.payload || {};
          const favorites = Array.isArray(payload.favorites) ? payload.favorites : [];
          const deals = payload.dealsByShop || {};
          const shops = favorites.filter((shop: any) => shop?.id && !payload.trash?.[shop.id] && !payload.deleted?.[shop.id] && (!shopId || shop.id === shopId) && deals[shop.id]?.status === 'found' && Array.isArray(deals[shop.id].offers) && deals[shop.id].offers.length);
          count.textContent = `${shops.length} 家商家`;
          if (!shops.length) { empty(shopId ? '这家商家暂无已核实的团购信息。' : '收藏中暂无已核实的团购信息。'); return; }
          for (const shop of shops) {
            const entry = deals[shop.id];
            const card = text('article', 'shop', '');
            const head = text('div', 'shop-head', '');
            const title = text('div', '', '');
            title.append(text('h2', '', shop.name), text('p', 'address', [shop.city, shop.address].filter(Boolean).join(' · ')));
            const checked = Number.isFinite(Date.parse(entry.checkedAt)) ? new Date(entry.checkedAt).toLocaleString('zh-CN') : '时间待核实';
            head.append(title, text('p', 'checked', `上次抓取：${checked}`));
            const offers = text('div', 'offers', '');
            for (const offer of entry.offers) {
              if (!offer?.title || !Number.isFinite(Number(offer.price)) || Number(offer.price) <= 0) continue;
              const item = text('div', 'offer', '');
              const detail = text('div', '', '');
              detail.append(text('h3', '', offer.title));
              const url = safeUrl(offer.url) || safeUrl(shop.url);
              if (url) detail.append(link('在大众点评查看 ↗', url));
              item.append(detail, text('span', 'price', `¥${Number(offer.price).toLocaleString('zh-CN')}`));
              offers.append(item);
            }
            if (!offers.childElementCount) continue;
            card.append(head, offers);
            list.append(card);
          }
          state.hidden = true;
        } catch (error) {
          state.textContent = error instanceof Error ? `团购信息读取失败：${error.message}` : '团购信息读取失败，请稍后重试。';
        }
      }
      void load();
      window.addEventListener('site-auth-change', () => { void load(); });
    </script>
  </body>
</html>
