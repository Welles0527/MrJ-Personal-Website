      /* Shared light/dark composition: themes change color only, never geometry. */
      :root {
        --page-surface: #fafafa;
        --card: rgba(252, 252, 252, 0.96);
        --card-border: rgba(14, 15, 17, 0.1);
        --card-hover-border: #0b0c0e;
        --control-surface: rgba(250, 250, 250, 0.78);
        --control-border: rgba(14, 15, 17, 0.14);
      }

      html[data-theme="dark"] {
        --ink: #f5f5f6;
        --muted: #b2b4ba;
        --page-surface: #1d1d1c;
        --card: rgba(29, 29, 28, 0.97);
        --card-border: rgba(255, 255, 255, 0.15);
        --card-hover-border: #ffffff;
        --control-surface: rgba(29, 29, 28, 0.8);
        --control-border: rgba(255, 255, 255, 0.18);
        background: var(--page-surface);
      }

      html[data-theme="black-gold"] {
        --ink: #f4f0e8;
        --muted: #b7ad9e;
        --page-surface: #090909;
        --card: linear-gradient(145deg, rgba(37, 34, 29, 0.9), rgba(12, 12, 11, 0.92));
        --card-border: rgba(218, 172, 94, 0.46);
        --card-hover-border: #f3c979;
        --control-surface: rgba(14, 14, 13, 0.8);
        --control-border: rgba(218, 172, 94, 0.42);
        --focus: #e0b66d;
        background: var(--page-surface);
        color-scheme: dark;
      }

      html,
      body,
      html[data-theme="dark"] body {
        background: var(--page-surface);
      }

      body::before,
      html[data-theme="dark"] body::before {
        inset: 0;
        width: auto;
        height: auto;
        background:
          radial-gradient(ellipse 54% 54% at 5% 104%, rgba(255, 101, 203, 0.84) 0%, rgba(207, 128, 244, 0.54) 42%, transparent 73%),
          radial-gradient(ellipse 54% 54% at 95% 104%, rgba(255, 101, 203, 0.84) 0%, rgba(207, 128, 244, 0.54) 42%, transparent 73%),
          radial-gradient(ellipse 70% 58% at 50% 104%, rgba(77, 124, 247, 0.94) 0%, rgba(111, 153, 252, 0.72) 44%, transparent 76%),
          linear-gradient(180deg, #fafafa 0%, #fafafa 26%, #f7faff 39%, #d9e7ff 57%, #89a9f9 77%, #ef8dd3 108%);
        filter: none;
        transform: none;
      }

      html[data-theme="dark"] body::before {
        background:
          radial-gradient(ellipse 55% 52% at 4% 105%, rgba(218, 66, 150, 0.96) 0%, rgba(174, 84, 183, 0.66) 44%, transparent 74%),
          radial-gradient(ellipse 55% 52% at 96% 105%, rgba(218, 66, 150, 0.96) 0%, rgba(174, 84, 183, 0.66) 44%, transparent 74%),
          radial-gradient(ellipse 76% 60% at 50% 104%, rgba(44, 79, 184, 0.98) 0%, rgba(57, 88, 180, 0.82) 48%, transparent 78%),
          linear-gradient(180deg, #1d1d1c 0%, #1d1d1c 27%, #222730 43%, #31559f 66%, #cb4c99 108%);
      }

      html[data-theme="black-gold"] body::before {
        background-image:
          linear-gradient(180deg, rgba(3, 3, 3, 0.04), rgba(3, 3, 3, 0.12)),
          url("/officialwebsite/images/home-theme-black-gold-bg.webp?v=20260814-depth");
        background-position: center, center bottom;
        background-repeat: no-repeat;
        background-size: cover;
      }

      body::after,
      html[data-theme="dark"] body::after {
        opacity: 0;
      }

      html[data-theme="black-gold"] body::after {
        opacity: 0.032;
        mix-blend-mode: soft-light;
      }

      .space-brand,
      html[data-theme="dark"] .space-brand {
        position: fixed;
        z-index: 4;
        top: 20px;
        left: 24px;
        display: flex;
        align-items: center;
        gap: 12px;
        border-radius: 12px;
        color: var(--ink);
        outline: none;
        animation: enter-mark 0.65s cubic-bezier(0.22, 1, 0.36, 1) both;
      }

      .space-brand:focus-visible {
        outline: 2px solid var(--focus);
        outline-offset: 5px;
      }

      .space-brand__mark {
        position: relative;
        display: block;
        width: 38px;
        height: 38px;
        flex: 0 0 auto;
        transition: transform 0.25s ease;
      }

      .space-brand__text {
        font-size: 18px;
        font-weight: 700;
        letter-spacing: -0.01em;
        line-height: 1;
        white-space: nowrap;
      }

      .theme-toggle {
        position: fixed;
        z-index: 5;
        top: 18px;
        right: 24px;
        display: inline-flex;
        height: 42px;
        align-items: center;
        gap: 8px;
        border: 1px solid var(--control-border);
        border-radius: 999px;
        padding: 0 14px;
        background: var(--control-surface);
        color: var(--ink);
        font: 700 14px/1 var(--font);
        cursor: pointer;
        outline: none;
        backdrop-filter: blur(12px);
        transition: border-color 0.2s ease, background 0.2s ease;
      }

      .theme-toggle:hover {
        border-color: var(--card-hover-border);
      }

      .theme-toggle:focus-visible {
        outline: 2px solid var(--focus);
        outline-offset: 3px;
      }

      .theme-toggle svg {
        width: 17px;
        height: 17px;
        fill: none;
        stroke: currentColor;
        stroke-width: 1.9;
        stroke-linecap: round;
        stroke-linejoin: round;
      }

      .theme-toggle__sun {
        display: none;
      }

      html[data-theme="dark"] .theme-toggle__moon,
      html[data-theme="black-gold"] .theme-toggle__moon {
        display: none;
      }

      html[data-theme="dark"] .theme-toggle__sun,
      html[data-theme="black-gold"] .theme-toggle__sun {
        display: block;
      }

      .brand-mark,
      html[data-theme="dark"] .brand-mark {
        filter: none;
      }

      .choices,
      html[data-theme="dark"] .choices {
        width: min(800px, calc(100vw - 48px));
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 16px;
      }

      .choice,
      html[data-theme="dark"] .choice {
        display: grid;
        min-height: clamp(116px, 13.1vh, 130px);
        grid-template-rows: auto auto;
        place-content: center;
        justify-items: center;
        gap: 20px;
        border: 1px solid var(--card-border);
        border-radius: 19px;
        padding: 20px 12px;
        background: var(--card);
        box-shadow: none;
        backdrop-filter: none;
        transition: border-color 0.18s ease, background 0.18s ease;
      }

      .choice::before,
      .choice::after,
      html[data-theme="dark"] .choice::before,
      html[data-theme="dark"] .choice::after {
        display: none;
      }

      .choice:hover,
      .choice:focus-visible,
      html[data-theme="dark"] .choice:hover,
      html[data-theme="dark"] .choice:focus-visible {
        border-color: var(--card-hover-border);
        background: var(--card);
        box-shadow: none;
        transform: none;
      }

      .choice:focus-visible,
      html[data-theme="dark"] .choice:focus-visible {
        outline: 2px solid var(--focus);
        outline-offset: 3px;
      }

      .choice:active,
      html[data-theme="dark"] .choice:active {
        transform: none;
      }

      .choice svg,
      .choice:hover svg,
      .choice:focus-visible svg,
      html[data-theme="dark"] .choice svg,
      html[data-theme="dark"] .choice:hover svg,
      html[data-theme="dark"] .choice:focus-visible svg {
        width: 29px;
        height: 29px;
        stroke: var(--ink);
        transform: none;
      }

      .choice__label,
      html[data-theme="dark"] .choice__label {
        width: 100%;
        font-size: clamp(15px, 1.32vw, 18px);
        line-height: 1.15;
        white-space: nowrap;
      }

      .choice__badge {
        position: absolute;
        top: 12px;
        right: 12px;
        display: grid;
        width: 28px;
        height: 28px;
        place-items: center;
        border: 1px solid currentColor;
        border-radius: 50%;
        color: var(--muted);
        font-size: 9px;
        font-weight: 800;
        letter-spacing: -0.03em;
        line-height: 1;
        pointer-events: none;
      }

