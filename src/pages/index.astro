      }

      html[data-theme="dark"] .choice::before {
        background:
          radial-gradient(circle at 30% 0%, rgba(255, 66, 115, 0.16), transparent 40%),
          radial-gradient(circle at 70% 100%, rgba(100, 124, 255, 0.24), transparent 46%);
      }

      html[data-theme="dark"] .choice:hover,
      html[data-theme="dark"] .choice:focus-visible {
        border-color: rgba(144, 162, 255, 0.42);
        background: rgba(22, 26, 43, 0.94);
        box-shadow:
          0 1px 0 rgba(255, 255, 255, 0.08) inset,
          0 22px 46px rgba(0, 0, 0, 0.3),
          0 0 0 1px rgba(112, 135, 255, 0.05);
      }

      html[data-theme="dark"] .choice:hover svg,
      html[data-theme="dark"] .choice:focus-visible svg {
        stroke: #9baaff;
      }

      html[data-theme="dark"] .choice:hover::after,
      html[data-theme="dark"] .choice:focus-visible::after {
        color: rgba(220, 225, 255, 0.72);
      }

      html[data-theme="dark-black"] {
        --ink: #f3f3f5;
        --muted: #9698a1;
        --card: rgba(13, 14, 17, 0.9);
        --card-border: rgba(255, 255, 255, 0.11);
        --focus: #b1b3bd;
        background: #050506;
        color-scheme: dark;
      }

      html[data-theme="dark-black"] body {
        background:
          radial-gradient(circle at 50% 17%, rgba(34, 34, 39, 0.25), transparent 30%),
          #050506;
      }

      html[data-theme="dark-black"] body::before {
        background:
          radial-gradient(
            ellipse 32% 58% at 50% 34%,
