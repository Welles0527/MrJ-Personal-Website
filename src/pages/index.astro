      .investment-overlay {
        position: fixed;
        z-index: 8;
        inset: 0;
        display: grid;
        place-items: center;
        padding: 24px;
        opacity: 0;
        background: rgba(4, 6, 12, 0.64);
        backdrop-filter: blur(16px);
        transition: opacity 0.24s ease;
      }

      .investment-overlay[hidden] {
        display: none;
      }

      .investment-overlay.is-open {
        opacity: 1;
      }

      .investment-menu {
        position: relative;
        width: min(500px, 100%);
        overflow: hidden;
        border: 1px solid rgba(255, 255, 255, 0.15);
        border-radius: 25px;
        background:
          radial-gradient(circle at 12% 0%, rgba(102, 124, 255, 0.13), transparent 40%),
          radial-gradient(circle at 90% 100%, rgba(255, 74, 151, 0.1), transparent 40%),
          rgba(22, 23, 27, 0.98);
        box-shadow:
          0 34px 90px rgba(0, 0, 0, 0.48),
          0 1px 0 rgba(255, 255, 255, 0.06) inset;
        padding: 30px;
        color: #f6f6f7;
        transform: translateY(16px) scale(0.975);
        transition: transform 0.28s cubic-bezier(0.22, 1, 0.36, 1);
      }

      .investment-overlay.is-open .investment-menu {
        transform: translateY(0) scale(1);
      }

      .investment-menu__eyebrow {
        margin: 0 0 7px;
        color: #9da8ff;
        font-size: 12px;
        font-weight: 800;
        letter-spacing: 0.16em;
        text-transform: uppercase;
      }

      .investment-menu h2 {
        margin: 0;
        font-size: 28px;
        font-weight: 800;
        letter-spacing: -0.035em;
        line-height: 1.12;
      }

      .investment-menu__hint {
        margin: 9px 0 22px;
        color: #aeb1ba;
        font-size: 14px;
        line-height: 1.55;
      }

      .investment-menu__close {
        position: absolute;
        top: 20px;
        right: 20px;
        display: grid;
        width: 36px;
        height: 36px;
        place-items: center;
        border: 1px solid rgba(255, 255, 255, 0.12);
        border-radius: 50%;
        background: rgba(255, 255, 255, 0.055);
        color: #e8e9ed;
        font: inherit;
        cursor: pointer;
        transition:
          border-color 0.22s ease,
          background 0.22s ease,
          transform 0.22s ease;
      }

      .investment-menu__close:hover,
      .investment-menu__close:focus-visible {
        border-color: rgba(164, 177, 255, 0.4);
        background: rgba(255, 255, 255, 0.1);
        outline: none;
        transform: rotate(4deg);
      }

      .investment-options {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 12px;
      }

      .investment-option {
        position: relative;
        display: grid;
        min-height: 152px;
        align-content: space-between;
        gap: 22px;
        overflow: hidden;
        border: 1px solid rgba(255, 255, 255, 0.12);
        border-radius: 18px;
        padding: 20px;
        background: rgba(255, 255, 255, 0.045);
        outline: none;
        transition:
          border-color 0.24s ease,
          background 0.24s ease,
          transform 0.24s cubic-bezier(0.22, 1, 0.36, 1);
      }

      .investment-option:hover,
      .investment-option:focus-visible {
        border-color: rgba(156, 171, 255, 0.4);
        background: rgba(255, 255, 255, 0.085);
        transform: translateY(-3px);
      }

      .investment-option svg {
        width: 32px;
        height: 32px;
        fill: none;
        stroke: #f0f1f5;
        stroke-width: 2;
        stroke-linecap: round;
        stroke-linejoin: round;
      }

      .investment-option strong {
        display: block;
        margin-bottom: 5px;
        font-size: 18px;
        font-weight: 800;
      }

      .investment-option small {
        display: block;
        color: #a8abb5;
        font-size: 12px;
        line-height: 1.45;
      }

      .investment-option__arrow {
        position: absolute;
        top: 20px;
        right: 20px;
        color: rgba(233, 235, 241, 0.68);
        font-size: 16px;
        transition: transform 0.22s ease;
      }

      .investment-option:hover .investment-option__arrow,
      .investment-option:focus-visible .investment-option__arrow {
        transform: translate(2px, -2px);
      }

      body.investment-menu-open {
        overflow: hidden;
      }

      @keyframes enter-mark {
        from {
          opacity: 0;
          transform: translateY(-10px) scale(0.9);
        }
        to {
          opacity: 1;
          transform: translateY(0) scale(1);
        }
      }

      @keyframes enter-title {
        from {
          opacity: 0;
