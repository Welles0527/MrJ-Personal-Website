<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#fafafa" />
    <link rel="icon" type="image/png" href="/officialwebsite/favicon.png?v=20260813-circle" />
    <link rel="shortcut icon" type="image/png" href="/officialwebsite/favicon.png?v=20260813-circle" />
    <meta
      name="description"
      content="J先生 AI 学习网站浅色入口选择器首页 Demo。"
    />
    <title>J先生的个人空间</title>
    <script is:inline>
      (() => {
        const storageKey = "magicj-home-theme";
        const themes = ["light", "dark", "black-gold"];
        const requestedTheme = new URLSearchParams(window.location.search).get("theme");
        const normalizedRequest = themes.includes(requestedTheme) ? requestedTheme : null;
        let storedTheme = null;
        try {
          storedTheme = window.localStorage.getItem(storageKey);
        } catch {}
        const activeTheme = normalizedRequest || (themes.includes(storedTheme) ? storedTheme : "light");
        const isDarkTheme = ["dark", "black-gold"].includes(activeTheme);
        document.documentElement.dataset.theme = activeTheme;
        document.documentElement.style.colorScheme = isDarkTheme ? "dark" : "light";
        document.querySelector('meta[name="theme-color"]').content = {
          light: "#fafafa",
          dark: "#1d1d1c",
          "black-gold": "#090909",
        }[activeTheme];
      })();
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Manrope:wght@500;600;700;800&family=Meie+Script&family=Noto+Sans+SC:wght@500;600;700;800&family=Poppins:wght@500;600;700&display=swap"
      rel="stylesheet"
    />
    <style is:inline>
      :root {
        --ink: #08090b;
        --muted: #555963;
        --card: rgba(252, 252, 252, 0.9);
        --card-border: rgba(20, 22, 27, 0.1);
        --focus: #6e87ff;
        --font: "Manrope", "Noto Sans SC", "Microsoft YaHei", sans-serif;
        --display-font: "Meie Script", cursive;
      }

      * {
        box-sizing: border-box;
      }

      html {
        min-width: 320px;
        min-height: 100%;
        background: #fafafa;
      }

      body {
        min-width: 320px;
        min-height: 100svh;
        margin: 0;
        overflow-x: hidden;
        background: #fafafa;
        color: var(--ink);
        font-family: var(--font);
        text-rendering: optimizeLegibility;
      }

      body::before {
        position: fixed;
        z-index: 0;
        right: -10vw;
        bottom: -18vh;
        left: -10vw;
        height: 104vh;
        background:
          radial-gradient(
            ellipse 30% 60% at 50% 36%,
            rgba(251, 253, 255, 0.98) 0%,
            rgba(246, 250, 255, 0.92) 42%,
            rgba(232, 241, 255, 0.5) 65%,
            transparent 78%
          ),
          radial-gradient(
            ellipse 42% 48% at 2% 100%,
            rgba(255, 123, 226, 1) 0%,
            rgba(224, 138, 247, 0.86) 43%,
            transparent 76%
          ),
          radial-gradient(
            ellipse 42% 48% at 98% 100%,
            rgba(255, 124, 220, 1) 0%,
            rgba(219, 137, 246, 0.86) 43%,
            transparent 76%
          ),
          radial-gradient(
            ellipse 52% 75% at 50% 91%,
            rgba(91, 142, 255, 0.92) 0%,
            rgba(113, 151, 255, 0.68) 42%,
            transparent 74%
          ),
          radial-gradient(
            ellipse 52% 78% at -2% 66%,
            rgba(120, 170, 255, 0.76) 0%,
            rgba(146, 181, 255, 0.44) 43%,
            transparent 72%
          ),
          radial-gradient(
            ellipse 52% 78% at 102% 66%,
            rgba(120, 170, 255, 0.76) 0%,
            rgba(146, 181, 255, 0.44) 43%,
            transparent 72%
          ),
          radial-gradient(
            ellipse 43% 58% at 2% 94%,
            rgba(236, 142, 244, 0.95) 0%,
            rgba(173, 148, 255, 0.76) 39%,
            transparent 71%
          ),
          radial-gradient(
            ellipse 43% 58% at 98% 94%,
            rgba(242, 148, 235, 0.96) 0%,
            rgba(166, 143, 255, 0.75) 39%,
            transparent 71%
          );
        filter: blur(42px) saturate(108%);
        content: "";
        pointer-events: none;
        transform: translateZ(0);
      }

      body::after {
        position: fixed;
        z-index: 0;
        inset: 0;
        opacity: 0.018;
        background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 160 160' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.86' numOctaves='2' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E");
        content: "";
        pointer-events: none;
      }

      a {
        color: inherit;
        text-decoration: none;
      }

      .space-brand {
        display: none;
      }

      .page {
        position: relative;
        z-index: 1;
        display: flex;
        min-height: 100svh;
        flex-direction: column;
        align-items: center;
        padding: clamp(190px, 24vh, 250px) 24px 70px;
      }

      .mark-link {
        display: block;
        border-radius: 22px;
        outline: none;
        animation: enter-mark 0.65s cubic-bezier(0.22, 1, 0.36, 1) both;
      }

      .mark-link:focus-visible {
        box-shadow: 0 0 0 4px rgba(110, 135, 255, 0.22);
      }

      .brand-mark {
        position: relative;
        display: block;
        aspect-ratio: 1;
        width: clamp(72px, 5.7vw, 86px);
        height: auto;
        filter: drop-shadow(0 12px 21px rgba(125, 113, 255, 0.15));
        transition: transform 0.3s cubic-bezier(0.22, 1, 0.36, 1);
      }

      .logo-theme-art {
        position: absolute;
        inset: 0;
        display: block;
        width: 100%;
        height: 100%;
        object-fit: contain;
      }

      .logo-theme-art--dark,
      .logo-theme-art--gold,
      html[data-theme="dark"] .logo-theme-art--light,
      html[data-theme="black-gold"] .logo-theme-art--light,
      html[data-theme="dark-black"] .logo-theme-art--light,
      html[data-theme="dark-reference"] .logo-theme-art--light {
        display: none;
      }

      html[data-theme="dark"] .logo-theme-art--dark,
      html[data-theme="dark-black"] .logo-theme-art--dark,
      html[data-theme="dark-reference"] .logo-theme-art--dark {
        display: block;
      }

      html[data-theme="black-gold"] .logo-theme-art--dark {
        display: none;
      }

      html[data-theme="black-gold"] .logo-theme-art--gold {
        display: block;
      }

      .mark-link:hover .brand-mark {
        transform: rotate(-4deg) scale(1.055);
      }

      h1 {
        margin: clamp(28px, 3.8vh, 37px) 0 0;
        font-family: var(--display-font);
        font-size: clamp(34px, 3.15vw, 46px);
        font-style: normal;
        font-weight: 400;
        letter-spacing: 0.025em;
        line-height: 1.02;
        text-align: center;
        animation: enter-title 0.7s 0.08s cubic-bezier(0.22, 1, 0.36, 1) both;
      }

      .choices {
        display: grid;
        width: min(800px, calc(100vw - 48px));
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 16px;
        margin-top: clamp(34px, 4.2vh, 42px);
      }

      .choice {
        position: relative;
        display: flex;
        min-height: clamp(116px, 13.1vh, 130px);
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 20px;
        overflow: hidden;
        border: 1px solid var(--card-border);
        border-radius: 19px;
        background: var(--card);
        box-shadow:
          0 1px 0 rgba(255, 255, 255, 0.95) inset,
          0 9px 24px rgba(35, 48, 78, 0.025);
        outline: none;
        backdrop-filter: blur(14px);
        animation: enter-card 0.62s cubic-bezier(0.22, 1, 0.36, 1) both;
        transition:
          border-color 0.28s ease,
          box-shadow 0.28s ease,
          transform 0.28s cubic-bezier(0.22, 1, 0.36, 1),
          background 0.28s ease;
      }

      .choice--button {
        width: 100%;
        padding: 0;
        color: inherit;
        font: inherit;
        cursor: pointer;
      }

      .choice:nth-child(1) {
        animation-delay: 0.14s;
      }

      .choice:nth-child(2) {
        animation-delay: 0.18s;
      }

      .choice:nth-child(3) {
        animation-delay: 0.22s;
      }

      .choice:nth-child(4) {
        animation-delay: 0.26s;
      }

      .choice:nth-child(5) {
        animation-delay: 0.3s;
      }

      .choice:nth-child(6) {
        animation-delay: 0.34s;
      }

      .choice:nth-child(7) {
        animation-delay: 0.38s;
      }

      .choice:nth-child(8) {
        animation-delay: 0.42s;
      }

      .choice::before {
        position: absolute;
        inset: 0;
        opacity: 0;
        background:
          radial-gradient(circle at 30% 0%, rgba(255, 99, 63, 0.09), transparent 38%),
          radial-gradient(circle at 70% 100%, rgba(109, 127, 255, 0.13), transparent 44%);
        content: "";
        transition: opacity 0.28s ease;
      }

      .choice::after {
        position: absolute;
        right: 14px;
        bottom: 12px;
        color: rgba(58, 66, 91, 0);
        content: "↗";
        font-size: 13px;
        font-weight: 700;
        transform: translate(-4px, 4px);
        transition: color 0.28s ease, transform 0.28s ease;
      }

      .choice:hover,
      .choice:focus-visible {
        border-color: rgba(102, 123, 220, 0.25);
        background: rgba(255, 255, 255, 0.94);
        box-shadow:
          0 1px 0 rgba(255, 255, 255, 0.95) inset,
          0 18px 40px rgba(91, 108, 176, 0.13);
        transform: translateY(-5px);
      }

      .choice:hover::before,
      .choice:focus-visible::before {
        opacity: 1;
      }

      .choice:hover::after,
      .choice:focus-visible::after {
        color: rgba(58, 66, 91, 0.65);
        transform: translate(0, 0);
      }

      .choice:active {
        transform: translateY(-1px) scale(0.985);
      }

      .choice svg {
        position: relative;
        z-index: 1;
        width: 29px;
        height: 29px;
        overflow: visible;
        stroke: var(--ink);
        stroke-width: 2.15;
        stroke-linecap: round;
        stroke-linejoin: round;
        fill: none;
        transition: stroke 0.28s ease, transform 0.28s ease;
      }

      .choice__icon {
        position: relative;
        z-index: 1;
        width: 29px;
        height: 29px;
      }

      html[data-theme="dark"] .choice__icon,
      html[data-theme="black-gold"] .choice__icon,
      html[data-theme="dark-black"] .choice__icon,
      html[data-theme="dark-reference"] .choice__icon {
        filter: invert(1);
      }

      .choice:hover svg,
      .choice:focus-visible svg {
        stroke: #536edf;
        transform: translateY(-1px) scale(1.05);
      }

      .choice__label {
        position: relative;
        z-index: 1;
        font-size: clamp(15px, 1.32vw, 18px);
        font-weight: 700;
        letter-spacing: -0.025em;
        line-height: 1.15;
        text-align: center;
      }

      html[data-theme="dark"] {
        --ink: #f7f8fc;
        --muted: #a6acbd;
        --card: rgba(15, 18, 29, 0.84);
        --card-border: rgba(255, 255, 255, 0.13);
        --focus: #91a4ff;
        background: #070912;
        color-scheme: dark;
      }

      html[data-theme="dark"] body {
        background:
          radial-gradient(circle at 50% 18%, rgba(28, 34, 56, 0.28), transparent 31%),
          #070912;
      }

      html[data-theme="dark"] body::before {
        background:
          radial-gradient(
            ellipse 31% 58% at 50% 34%,
            rgba(8, 11, 20, 0.97) 0%,
            rgba(11, 16, 30, 0.9) 43%,
            rgba(16, 28, 56, 0.45) 67%,
            transparent 79%
          ),
          radial-gradient(
            ellipse 42% 48% at 2% 100%,
            rgba(228, 53, 207, 0.92) 0%,
            rgba(142, 66, 235, 0.72) 43%,
            transparent 76%
          ),
          radial-gradient(
            ellipse 42% 48% at 98% 100%,
            rgba(238, 55, 196, 0.92) 0%,
            rgba(132, 60, 229, 0.72) 43%,
            transparent 76%
          ),
          radial-gradient(
            ellipse 52% 75% at 50% 91%,
            rgba(42, 91, 232, 0.94) 0%,
            rgba(62, 88, 201, 0.73) 42%,
            transparent 74%
          ),
          radial-gradient(
            ellipse 52% 78% at -2% 66%,
            rgba(35, 81, 190, 0.74) 0%,
            rgba(48, 70, 156, 0.4) 43%,
            transparent 72%
          ),
          radial-gradient(
            ellipse 52% 78% at 102% 66%,
            rgba(35, 81, 190, 0.74) 0%,
            rgba(48, 70, 156, 0.4) 43%,
            transparent 72%
          );
        filter: blur(46px) saturate(122%);
      }

      html[data-theme="dark"] body::after {
        opacity: 0.035;
        mix-blend-mode: soft-light;
      }

      html[data-theme="dark"] .brand-mark {
        filter:
