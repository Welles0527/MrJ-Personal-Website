        to {
          opacity: 1;
          transform: translateY(0);
        }
      }

      @keyframes enter-card {
        from {
          opacity: 0;
          transform: translateY(18px);
        }
        to {
          opacity: 1;
          transform: translateY(0);
        }
      }

