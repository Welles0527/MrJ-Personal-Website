    <script is:inline>
      const themeStorageKey = "magicj-home-theme";
      const themeToggle = document.querySelector("[data-theme-toggle]");
      const themeToggleLabel = document.querySelector("[data-theme-toggle-label]");
      const themeColor = document.querySelector('meta[name="theme-color"]');
      const themes = ["light", "dark", "black-gold"];
      const themeNames = {
        light: "浅色",
        dark: "深色",
        "black-gold": "黑金",
      };
      const themeColors = {
        light: "#fafafa",
        dark: "#1d1d1c",
        "black-gold": "#090909",
      };

      const updateThemeControl = () => {
        const activeTheme = document.documentElement.dataset.theme;
        const activeIndex = Math.max(0, themes.indexOf(activeTheme));
        const nextTheme = themes[(activeIndex + 1) % themes.length];
        themeToggle.setAttribute("aria-pressed", String(activeTheme !== "light"));
        themeToggle.setAttribute("aria-label", `切换到${themeNames[nextTheme]}主题`);
        themeToggleLabel.textContent = themeNames[nextTheme];
      };

      themeToggle.addEventListener("click", () => {
        const activeTheme = document.documentElement.dataset.theme;
        const activeIndex = Math.max(0, themes.indexOf(activeTheme));
        const nextTheme = themes[(activeIndex + 1) % themes.length];
        const isDarkTheme = ["dark", "black-gold"].includes(nextTheme);
        document.documentElement.dataset.theme = nextTheme;
        document.documentElement.style.colorScheme = isDarkTheme ? "dark" : "light";
        themeColor.content = themeColors[nextTheme];
        try {
          window.localStorage.setItem(themeStorageKey, nextTheme);
        } catch {}
        updateThemeControl();
      });

      updateThemeControl();

      const investmentTrigger = document.querySelector("[data-investment-trigger]");
      const investmentOverlay = document.querySelector("[data-investment-menu]");
      const investmentClose = document.querySelector("[data-investment-close]");
      let investmentCloseTimer;

      const investmentFocusable = () =>
        [...investmentOverlay.querySelectorAll('a[href], button:not([disabled]), [tabindex]:not([tabindex="-1"])')];

      const openInvestmentMenu = () => {
        window.clearTimeout(investmentCloseTimer);
        investmentOverlay.hidden = false;
        investmentTrigger.setAttribute("aria-expanded", "true");
        document.body.classList.add("investment-menu-open");
        window.requestAnimationFrame(() => {
          investmentOverlay.classList.add("is-open");
          investmentFocusable()[0]?.focus();
        });
      };

      const closeInvestmentMenu = () => {
        investmentOverlay.classList.remove("is-open");
        investmentTrigger.setAttribute("aria-expanded", "false");
        document.body.classList.remove("investment-menu-open");
        investmentCloseTimer = window.setTimeout(() => {
          investmentOverlay.hidden = true;
          investmentTrigger.focus();
        }, 240);
      };

      investmentTrigger.addEventListener("click", openInvestmentMenu);
      investmentClose.addEventListener("click", closeInvestmentMenu);
      investmentOverlay.addEventListener("click", (event) => {
        if (event.target === investmentOverlay) closeInvestmentMenu();
      });
      document.addEventListener("keydown", (event) => {
        if (investmentOverlay.hidden) return;
        if (event.key === "Escape") {
          event.preventDefault();
          closeInvestmentMenu();
          return;
        }
        if (event.key !== "Tab") return;
        const focusable = investmentFocusable();
        const first = focusable[0];
        const last = focusable[focusable.length - 1];
        if (event.shiftKey && document.activeElement === first) {
          event.preventDefault();
          last.focus();
        } else if (!event.shiftKey && document.activeElement === last) {
          event.preventDefault();
          first.focus();
        }
      });
    </script>
