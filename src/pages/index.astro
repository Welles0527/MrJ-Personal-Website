          ),
          radial-gradient(
            ellipse 54% 76% at 50% 91%,
            rgba(30, 31, 37, 0.96) 0%,
            rgba(24, 26, 32, 0.82) 43%,
            transparent 75%
          ),
          radial-gradient(
            ellipse 54% 79% at -2% 66%,
            rgba(25, 27, 33, 0.8) 0%,
            rgba(18, 20, 25, 0.52) 44%,
            transparent 73%
          ),
          radial-gradient(
            ellipse 54% 79% at 102% 66%,
            rgba(25, 27, 33, 0.8) 0%,
            rgba(18, 20, 25, 0.52) 44%,
            transparent 73%
          );
        filter: blur(46px) saturate(104%);
      }

      html[data-theme="dark-black"] body::after {
        opacity: 0.04;
        mix-blend-mode: soft-light;
      }

      html[data-theme="dark-black"] .brand-mark {
        filter:
          drop-shadow(0 13px 26px rgba(118, 79, 171, 0.22))
          drop-shadow(0 0 28px rgba(235, 62, 137, 0.1));
      }

      html[data-theme="dark-black"] .choice {
        box-shadow:
          0 1px 0 rgba(255, 255, 255, 0.045) inset,
          0 22px 60px rgba(0, 0, 0, 0.2);
      }

      html[data-theme="dark-black"] .choice::before {
        background:
          radial-gradient(circle at 30% 0%, rgba(120, 86, 112, 0.13), transparent 40%),
          radial-gradient(circle at 70% 100%, rgba(96, 99, 115, 0.16), transparent 46%);
      }

      html[data-theme="dark-black"] .choice:hover,
      html[data-theme="dark-black"] .choice:focus-visible {
        border-color: rgba(183, 185, 197, 0.28);
        background: rgba(22, 23, 27, 0.96);
        box-shadow:
          0 1px 0 rgba(255, 255, 255, 0.06) inset,
          0 24px 48px rgba(0, 0, 0, 0.36),
          0 0 0 1px rgba(190, 192, 202, 0.025);
      }

      html[data-theme="dark-black"] .choice:hover svg,
      html[data-theme="dark-black"] .choice:focus-visible svg {
        stroke: #c4c5cc;
      }

      html[data-theme="dark-black"] .choice:hover::after,
      html[data-theme="dark-black"] .choice:focus-visible::after {
        color: rgba(226, 226, 231, 0.68);
      }

      html[data-theme="dark-reference"] {
        --ink: #f4f4f5;
        --muted: #a9abb2;
        --card: rgba(31, 31, 30, 0.98);
        --card-border: rgba(255, 255, 255, 0.13);
        --focus: #aab6ff;
        background: #1f1f1e;
        color-scheme: dark;
      }

      html[data-theme="dark-reference"] body {
        background: #1f1f1e;
      }

      html[data-theme="dark-reference"] body::before {
        right: -8vw;
        bottom: -10vh;
        left: -8vw;
        height: 121vh;
        background:
          radial-gradient(
            ellipse 38% 64% at 50% 28%,
            rgba(31, 31, 30, 1) 0%,
            rgba(31, 31, 30, 0.96) 45%,
            rgba(30, 36, 43, 0.56) 67%,
            transparent 81%
          ),
          radial-gradient(
            ellipse 36% 52% at 10% 100%,
            rgba(209, 46, 117, 1) 0%,
            rgba(202, 120, 189, 0.96) 42%,
            transparent 75%
          ),
          radial-gradient(
            ellipse 36% 52% at 90% 100%,
            rgba(210, 48, 119, 1) 0%,
            rgba(200, 122, 193, 0.96) 42%,
            transparent 75%
          ),
          radial-gradient(
            ellipse 75% 70% at 50% 100%,
            rgba(64, 84, 183, 1) 0%,
            rgba(55, 83, 165, 0.9) 55%,
            transparent 86%
          ),
          radial-gradient(
            ellipse 110% 55% at 0% 75%,
            rgba(72, 119, 224, 0.98) 0%,
            rgba(63, 100, 170, 0.86) 52%,
            transparent 86%
          ),
          radial-gradient(
            ellipse 110% 55% at 100% 75%,
            rgba(72, 119, 224, 0.98) 0%,
            rgba(63, 100, 170, 0.86) 52%,
            transparent 86%
          );
        filter: blur(48px) saturate(108%);
      }

      html[data-theme="dark-reference"] body::after {
        opacity: 0.025;
        mix-blend-mode: soft-light;
      }

      html[data-theme="dark-reference"] .brand-mark {
        filter: none;
      }

      html[data-theme="dark-reference"] .space-brand {
        position: fixed;
        z-index: 4;
        top: 18px;
        left: 24px;
        display: flex;
        align-items: center;
        gap: 17px;
        border-radius: 14px;
        color: #f2f2f3;
        outline: none;
        animation: enter-mark 0.65s cubic-bezier(0.22, 1, 0.36, 1) both;
      }

      html[data-theme="dark-reference"] .space-brand:focus-visible {
        box-shadow: 0 0 0 4px rgba(145, 164, 255, 0.24);
      }

      html[data-theme="dark-reference"] .space-brand__mark {
        display: block;
        width: 42px;
        height: 42px;
        transition: transform 0.3s cubic-bezier(0.22, 1, 0.36, 1);
      }

      html[data-theme="dark-reference"] .space-brand__text {
        font-size: 22px;
        font-weight: 700;
        letter-spacing: 0.015em;
        line-height: 1;
        white-space: nowrap;
      }

      html[data-theme="dark-reference"] h1 {
        font-size: 0;
        letter-spacing: -0.035em;
      }

      html[data-theme="dark-reference"] h1::after {
        content: attr(data-reference-label);
        font-size: 28px;
        font-weight: 600;
        line-height: 1.02;
      }

      html[data-theme="dark-reference"] .choice {
        box-shadow: none;
      }

      html[data-theme="dark-reference"] .choice__label {
        font-size: 0;
      }

      html[data-theme="dark-reference"] .choice__label::after {
        content: attr(data-reference-label);
        font-size: 20px;
        font-weight: 700;
        line-height: 1.15;
      }

      html[data-theme="dark-reference"] .choice::before {
        background:
          radial-gradient(circle at 30% 0%, rgba(255, 73, 128, 0.13), transparent 40%),
          radial-gradient(circle at 70% 100%, rgba(101, 126, 255, 0.2), transparent 46%);
      }

      html[data-theme="dark-reference"] .choice:hover,
      html[data-theme="dark-reference"] .choice:focus-visible {
        border-color: rgba(158, 171, 255, 0.34);
        background: rgba(32, 33, 36, 0.98);
        box-shadow: 0 20px 42px rgba(8, 12, 23, 0.28);
      }

      html[data-theme="dark-reference"] .choice:hover svg,
      html[data-theme="dark-reference"] .choice:focus-visible svg {
        stroke: #aeb8ff;
      }

      @media (min-width: 761px) {
        html[data-theme="dark-reference"] .page {
          padding-top: clamp(90px, 12.2vh, 106px);
          transform: translateX(-18px);
        }

        html[data-theme="dark-reference"] .brand-mark {
          width: 52px;
        }

        html[data-theme="dark-reference"] h1 {
