<!doctype html>
<html lang="zh-CN" data-theme="dark" data-language="zh">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#ef9b73" />
    <link rel="icon" type="image/png" href={`${basePath}/favicon.png?v=20260813-circle`} />
    <meta
      name="description"
      content="Welles Gu 的双语个人简历，聚焦投资分析、财务分析、理财规划与个人 AI 应用。"
      data-description
    />
    <title>Welles Gu｜投资分析师、财务分析师与 AI 应用导师</title>
    <script is:inline>
      (() => {
        let theme = "dark";
        let language = "zh";
        try {
          theme = window.localStorage.getItem("welles-resume-theme") === "light" ? "light" : "dark";
          language = window.localStorage.getItem("welles-resume-language") === "en" ? "en" : "zh";
        } catch {}
        document.documentElement.dataset.theme = theme;
        document.documentElement.dataset.language = language;
        document.documentElement.lang = language === "en" ? "en" : "zh-CN";
      })();
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&family=Noto+Sans+SC:wght@400;500;600;700;800&display=swap"
