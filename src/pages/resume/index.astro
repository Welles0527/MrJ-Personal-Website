const radarCenterX = 150;
const radarCenterY = 126;
const radarRadius = 68;
const radarPoint = (index: number, level: number, radius = radarRadius) => {
  const angle = -Math.PI / 2 + (index * Math.PI * 2) / workSkills.length;
  const scaledRadius = radius * (level / 100);
  return `${(radarCenterX + Math.cos(angle) * scaledRadius).toFixed(2)},${(radarCenterY + Math.sin(angle) * scaledRadius).toFixed(2)}`;
};
const radarGrid = Array.from({ length: 5 }, (_, index) =>
  workSkills.map((_, skillIndex) => radarPoint(skillIndex, (index + 1) * 20)).join(' ')
);
const radarAxes = workSkills.map((skill, index) => {
  const angle = -Math.PI / 2 + (index * Math.PI * 2) / workSkills.length;
  const labelRadius = radarRadius + 39;
  const horizontalDirection = Math.cos(angle);
  const labelX = horizontalDirection > 0.15 ? 292 : horizontalDirection < -0.15 ? 8 : radarCenterX;
  const labelY = radarCenterY + Math.sin(angle) * labelRadius;
  return {
    ...skill,
    point: radarPoint(index, 100),
    labelX: labelX.toFixed(2),
    labelY: labelY.toFixed(2),
    anchor: horizontalDirection > 0.15 ? 'end' : horizontalDirection < -0.15 ? 'start' : 'middle',
  };
});
const radarShape = workSkills.map((skill, index) => radarPoint(index, skill.level)).join(' ');

